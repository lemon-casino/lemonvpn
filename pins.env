# LemonVPN desktop pin file — single source of truth for upstream versions.
# Mechanism mirrors honk's .github/ci/pins.env; CI downloads release artifacts
# matching these pins. Local clones under doona/ and honk/ are dev working
# copies and may be newer; releases always build from these pins.

# Historical honk reference checkout; current desktop builds compile sidecar-stub.
HONK_REVISION=54b2e1cfbe1e7f8a93dba3a0f64fabf2a9f88e38

# doona UI embedded by honk native-ui (values from honk pins.env at HONK_REVISION)
DOONA_VERSION=0.1.0-rc.4
DOONA_REVISION=58dfe2e2d1bccb1c0363895adb27eb4bfa1e932d
DOONA_SHA256=2f32fbf4feb649a3918f46af2781837201347445ea4e2ff802c721b8c5177342
DOONA_LITE_SHA256=924f02d9503343308094331b67afc061d808a0ce533eb90b40e2875f3f8fdf37

# Desktop source checkout patched by patches/doona-lemonvpn-desktop.patch.
# Independent of honk's prebuilt native-ui release pins above.
DOONA_DESKTOP_REVISION=a75c97788fc178333fe5782a30969ce07902e290

# Protocol/TUN compatibility core: Windows x64 and macOS (amd64/arm64).
# amd64 uses the broadest-compatibility build; arm64 has a single standard build.
MIHOMO_VERSION=v1.19.33
MIHOMO_WINDOWS_AMD64_ASSET_SHA256=7aaf636a4f2172dcd8ec34ac4f52797b059195e5afd6409508c963e545f8864d
