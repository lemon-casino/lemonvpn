+import {useState} from 'react';
+import type {ProxyChain} from '../../api/model';
+import {useT} from '../../i18n';
+import {Button, ModalDialog} from '../../ui/ui';
+import {ChainFlowPanel} from '../shared/ChainFlowPanel';
+
+export function ChainInspector({groupId, name, chain, refresh}: {groupId: string; name: string; chain: ProxyChain; refresh: () => void}) {
+  const t = useT();
+  const [open, setOpen] = useState(false);
+  const [network, setNetwork] = useState<'tcp' | 'udp'>('tcp');
+  return (
+    <>
+      <Button
+        quiet
+        small
+        onPress={() => {
+          refresh();
+          setOpen(true);
+        }}
+      >
+        {t('chain.inspect')}
+      </Button>
+      <ModalDialog
+        isOpen={open}
+        onOpenChange={setOpen}
+        title={t('chain.inspectorTitle', {name})}
+        description={t('chain.livePreviewHelp')}
+        size="wide"
+        scrollBody
+        footer={close => <Button onPress={close}>{t('ui.close')}</Button>}
+      >
+        <ChainFlowPanel id={groupId} initial={chain} network={network} changeNetwork={setNetwork} enabled={open} />
+      </ModalDialog>
+    </>
+  );
+}
