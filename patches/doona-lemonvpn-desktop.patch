@@ -0,0 +1,95 @@
+import {useEffect, useState} from 'react';
+import {useT} from '../i18n';
+import {Button, Link} from '../ui/ui';
+import {useCapabilities, useTun} from '../store';
+import {tunAvailable, useDesktopStatus} from '../store/desktop';
+import {desktop, invokeDesktop} from '../desktop';
+import {href} from './route';
+
+export function DesktopControls() {
+  const t = useT();
+  const caps = useCapabilities();
+  const {proxy, enabled} = useDesktopStatus(caps.data?.resources);
+  const tunUsable = tunAvailable(caps.data?.resources);
+  const proxyUsable = desktop?.platform === 'windows' || desktop?.platform === 'macos' || (desktop?.platform === 'linux' && proxy.data?.supported === true);
+  const tun = useTun(enabled && tunUsable);
+  const [proxyBusy, setProxyBusy] = useState(false);
+  const [error, setError] = useState<Error | null>(null);
+  useEffect(() => {
+    const receive = (event: Event) => {
+      if (event instanceof CustomEvent && typeof event.detail?.message === 'string') setError(new Error(event.detail.message));
+    };
+    window.addEventListener('lemonvpn:desktop-error', receive);
+    return () => window.removeEventListener('lemonvpn:desktop-error', receive);
+  }, []);
+  const changeProxy = async () => {
+    setProxyBusy(true);
+    setError(null);
+    try {
+      await invokeDesktop('proxy_set', {enabled: !proxy.data?.enabled});
+      proxy.refetch();
+    } catch (error) {
+      setError(error instanceof Error ? error : new Error(String(error)));
+    } finally {
+      setProxyBusy(false);
+    }
+  };
+  const changeTun = async () => {
+    setError(null);
+    try {
+      await tun.set(!tun.data?.enabled);
+    } catch (error) {
+      setError(error instanceof Error ? error : new Error(String(error)));
+    }
+  };
+  if (!proxyUsable && !tunUsable) return null;
+  return (
+    <div className="rp-desktop-controls">
+      <div className="rp-desktop-control-grid">
+        {proxyUsable && (
+          <Button
+            appearance="plain"
+            className="rp-desktop-toggle"
+            isSelected={proxy.data?.enabled === true}
+            isDisabled={!proxy.data || proxyBusy}
+            onPress={() => void changeProxy()}
+          >
+            <span className="rp-desktop-toggle-top">
+              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.7" aria-hidden="true">
+                <circle cx="12" cy="12" r="9" />
+                <path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z" />
+              </svg>
+              <span className="rp-desktop-toggle-track" aria-hidden="true" />
+            </span>
+            <span>{t('desktop.systemProxy')}</span>
+          </Button>
+        )}
+        {tunUsable && (
+          <Button
+            appearance="plain"
+            className="rp-desktop-toggle"
+            isSelected={tun.data?.enabled === true}
+            isDisabled={!tun.data || tun.busy}
+            onPress={() => void changeTun()}
+          >
+            <span className="rp-desktop-toggle-top">
+              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.7" aria-hidden="true">
+                <rect x="3" y="4" width="18" height="12" rx="2" />
+                <path d="M8 21h8m-4-5v5m-5-9h4m3 0h3" />
+              </svg>
+              <span className="rp-desktop-toggle-track" aria-hidden="true" />
+            </span>
+            <span>{t('desktop.tun')}</span>
+          </Button>
+        )}
+      </div>
+      {proxy.data?.scope === 'session' && <p className="rp-note">{t('desktop.proxySessionHelp')}</p>}
+      {error && (
+        <div className="rp-desktop-control-error" role="alert">
+          <span>{error.message}</span>
+          <Link href={href('settings', {card: 'tun'})}>{t('settings.tun')}</Link>
+        </div>
+      )}
+    </div>
+  );
+}
