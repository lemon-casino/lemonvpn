+  kind: 'routing' | 'global' | 'group-filter' | 'chain' | 'group-final';
+  owner?: string;
+  value: string;
+};
+
+// Positions come from tokens, never a whole-text replace: domains, comments,
+// subscription URLs, node names and similarly named groups remain unchanged.
+export function groupReferenceDetails(sources: ConfigSource[], name: string): GroupReference[] {
+  const found: GroupReference[] = [];
+  for (const source of sources) {
+    const text = source.content;
+    const {blocks, tokens: all} = scanConfig(text);
+    const tokens = all.filter(token => token.kind !== 'comment');
+    const add = (from: number, to: number, line: number, kind: GroupReference['kind'], owner?: string) => {
+      found.push({source: source.id, path: source.path || source.id, line: line + 1, from, to, kind, owner, value: unquote(text.slice(from, to))});
+    };
+    for (const group of blocks.filter(block => block.name === 'group').flatMap(block => block.children)) {
+      if (group.name === name) continue;
+      for (const field of blockFields(text, group, all)) {
+        const values = tokens.filter(token => token.from >= field.valueFrom && token.to <= field.valueTo);
+        if (['final', 'dialer', 'landing'].includes(field.name) && unquote(field.value) === name && values.length === 1) {
+          add(values[0].from, values[0].to, values[0].line, field.name === 'final' ? 'group-final' : 'chain', group.name);
+        }
+        if (field.name !== 'filter') continue;
+        for (let index = 0; index < values.length - 1; index++) {
+          const token = values[index];
+          const call = text.slice(token.from, token.to);
+          const open = values[index + 1];
+          if (!['group', '!group'].includes(call) || text.slice(open.from, open.to) !== '(') continue;
+          for (let at = index + 2; at < values.length; at++) {
+            const argument = values[at];
+            if (argument.parens <= open.parens) break;
+            if (text.slice(argument.from, argument.to) === ')' && argument.parens === open.parens + 1) break;
+            if (argument.parens !== open.parens + 1 || !['text', 'quoted'].includes(argument.kind)) continue;
+            if (
+              unquote(text.slice(argument.from, argument.to))
+                .split(/[|,]/)
+                .some(part => part.trim() === name)
+            )
+              add(argument.from, argument.to, argument.line, 'group-filter', group.name);
+          }
+        }
+      }
+    }
+    for (let index = 0; index < tokens.length - 1; index++) {
+      const token = tokens[index];
+      const raw = text.slice(token.from, token.to);
+      const fallback = raw === ':' && index > 0 && text.slice(tokens[index - 1].from, tokens[index - 1].to) === 'fallback';
+      if (raw !== '->' && !fallback) continue;
+      const within = blocks.some(block => block.name === 'routing' && token.from > block.open && token.to < block.close && token.depth === block.depth + 1);
+      if (!within && !(source.kind === 'include' && !blocks.length && token.depth === 0)) continue;
+      const target = tokens[index + 1];
+      if (unquote(text.slice(target.from, target.to)) !== name) continue;
+      const global = all.some(
+        item => item.line === target.line && item.kind === 'comment' && text.slice(item.from, item.to).trim() === '# doona: outbound mode'
+      );
+      add(target.from, target.to, target.line, global ? 'global' : 'routing');
+    }
+  }
+  return found;
+}
+
+export function groupReferences(sources: ConfigSource[], name: string): string[] {
+  return [...new Set(groupReferenceDetails(sources, name).map(ref => `${ref.path}:${ref.line}${ref.owner ? ' · ' + ref.owner : ''}`))];
+}
+
+function removalRange(text: string, entry: TextBlock) {
+  const start = text.lastIndexOf('\n', entry.from - 1) + 1;
+  const nextLine = text.indexOf('\n', entry.to);
+  const end = nextLine === -1 ? text.length : nextLine + 1;
+  const whole = /^\s*$/.test(text.slice(start, entry.from)) && /^\s*$/.test(text.slice(entry.to, end));
+  return {from: whole ? start : entry.from, to: whole ? end : entry.to, text: ''};
+}
+
+export function planGroupRemoval(sources: ConfigSource[], name: string, replacement: string | null): ConfigSource[] {
+  const references = groupReferenceDetails(sources, name);
+  if (references.length && (!replacement || replacement === name)) throw new LocalError('group.replacementRequired');
+  let declarations = 0;
+  const planned = sources.map(source => {
+    const entries = scanConfig(source.content)
+      .blocks.filter(block => block.name === 'group')
+      .flatMap(block => block.children)
+      .filter(block => block.name === name);
+    declarations += entries.length;
+    const edits = entries.map(entry => removalRange(source.content, entry));
+    for (const ref of references.filter(ref => ref.source === source.id)) {
+      const value =
+        ref.kind === 'group-filter'
+          ? ref.value
+              .split(/([|,])/)
+              .map(part => (part.trim() === name ? part.replace(name, () => replacement!) : part))
+              .join('')
+          : replacement!;
+      const old = source.content.slice(ref.from, ref.to);
+      const delimiter = old[0];
+      const text =
+        (delimiter === "'" || delimiter === '"') && old.at(-1) === delimiter && !value.includes(delimiter) ? delimiter + value + delimiter : quoteName(value);
+      edits.push({from: ref.from, to: ref.to, text});
+    }
+    if (edits.length && !source.writable) throw new LocalError('group.replacementReadOnly');
+    let content = source.content;
+    for (const edit of edits.sort((a, b) => b.from - a.from)) content = content.slice(0, edit.from) + edit.text + content.slice(edit.to);
+    return {...source, content};
+  });
+  if (declarations !== 1 || groupReferenceDetails(planned, name).length) throw new LocalError('config.changedMeanwhile');
+  return planned;
+}
+
+export function removeGroupEntry(text: string, name: string): string {
+  const entries = scanConfig(text)
+    .blocks.filter(block => block.name === 'group')
+    .flatMap(block => block.children)
+    .filter(block => block.name === name);
+  if (entries.length !== 1) throw new LocalError('config.changedMeanwhile');
+  const edit = removalRange(text, entries[0]);
+  return text.slice(0, edit.from) + text.slice(edit.to);
+}
+
+export function excludedReplacements(sources: ConfigSource[], name: string): Set<string> {
+  const excluded = new Set([name]);
+  const pending = [name];
+  while (pending.length) {
+    for (const ref of groupReferenceDetails(sources, pending.pop()!)) {
+      if (ref.owner && !excluded.has(ref.owner)) {
+        excluded.add(ref.owner);
+        pending.push(ref.owner);
+      }
+    }
+  }
+  return excluded;
+}
