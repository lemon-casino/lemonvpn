+++ b/src/desktop.ts
@@ -0,0 +1,38 @@
+// The desktop host publishes this before the frontend starts. Browser builds
+// continue to use the upstream backend/profile controls.
+import './ui/styles/desktop-interactions.css';
+
+export type DesktopInfo = {name: string; version: string; platform: string; arch: string; engineUrl: string};
+type Invoke = (command: string, args?: Record<string, unknown>) => Promise<unknown>;
+const host = globalThis as {
+  __LEMONVPN_DESKTOP__?: DesktopInfo;
+  __TAURI__?: {core?: {invoke?: Invoke}};
+  __TAURI_INTERNALS__?: {invoke?: Invoke};
+};
+// The host marker is authoritative even when Tauri's optional global API is
+// absent. IPC remains available through the internal bridge in that case.
+export const desktop = host.__LEMONVPN_DESKTOP__;
+export const hasDesktop = !!desktop;
+export const framelessDesktop = desktop?.platform === 'windows';
+export const appName = hasDesktop ? 'LemonVPN' : 'doona';
+
+if (hasDesktop && typeof document !== 'undefined') {
+  document.documentElement.classList.add('lemonvpn-desktop');
+  if (framelessDesktop) document.documentElement.classList.add('lemonvpn-frameless');
+  document.addEventListener('contextmenu', event => event.preventDefault(), {capture: true});
+  document.addEventListener(
+    'selectstart',
+    event => {
+      const target = event.target instanceof Element ? event.target : event.target instanceof Node ? event.target.parentElement : null;
+      // Editing and copying configuration still work; page labels and charts do not acquire browser selections.
+      if (!target?.closest('input, textarea, [contenteditable]:not([contenteditable="false"]), .cm-editor')) event.preventDefault();
+    },
+    {capture: true}
+  );
+}
+
+export function invokeDesktop<T = unknown>(command: string, args?: Record<string, unknown>): Promise<T> {
+  const invoke = host.__TAURI__?.core?.invoke ?? host.__TAURI_INTERNALS__?.invoke;
+  if (!invoke) return Promise.reject(new Error('desktop_unavailable'));
+  return invoke(command, args) as Promise<T>;
+}
