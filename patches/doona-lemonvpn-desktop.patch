+
+type Box = {x: number; y: number; width: number; height: number};
+type Edge = {key: string; d: string; target?: string};
+const wireKey = (hops: ProxyChainHop[]) => JSON.stringify(hops.map(hop => [hop.id, hop.role]));
+const subscribeVisibility = (notify: () => void) => {
+  document.addEventListener('visibilitychange', notify);
+  return () => document.removeEventListener('visibilitychange', notify);
+};
+const documentVisible = () => !document.hidden;
+
+function edge(a: Box, b: Box): string {
+  const x = a.x + a.width;
+  const y = a.y + a.height / 2;
+  const endY = b.y + b.height / 2;
+  const mid = (x + b.x) / 2;
+  return `M${x} ${y} C${mid} ${y} ${mid} ${endY} ${b.x} ${endY}`;
+}
+
+function Topology({
+  hops,
+  rows,
+  via,
+  exit,
+  moving,
+  fresh,
+  compact,
+  frontControl,
+  exitControl
+}: {
+  hops: ProxyChainHop[];
+  rows: ChainTrafficTarget[];
+  via: string;
+  exit: string;
+  moving: boolean;
+  fresh: boolean;
+  compact: boolean;
+  frontControl?: ReactNode;
+  exitControl?: ReactNode;
+}) {
+  const t = useT();
+  const locale = LOCALE[useLang()];
+  const scene = useRef<HTMLDivElement>(null);
+  const [geometry, setGeometry] = useState<{key: string; edges: Edge[]; width: number; height: number} | null>(null);
+  const layoutKey = JSON.stringify([hops.map(hop => hop.id), rows.length ? rows.map(row => row.key) : ['empty']]);
+  const hopCount = hops.length;
+  useLayoutEffect(() => {
+    const element = scene.current;
+    if (!element || !hopCount) return;
+    const targetKeys: string[] = JSON.parse(layoutKey)[1];
+    const boxes = new Map(Array.from(element.querySelectorAll<HTMLDivElement>('[data-chain-node]'), node => [node.dataset.chainNode!, node]));
+    let pending = 0;
+    const update = () => {
+      const origin = element.getBoundingClientRect();
+      const read = (key: string): Box | null => {
+        const rect = boxes.get(key)?.getBoundingClientRect();
+        return rect ? {x: rect.x - origin.x, y: rect.y - origin.y, width: rect.width, height: rect.height} : null;
+      };
+      const source = read('source');
+      const stages = Array.from({length: hopCount}, (_, index) => read(`hop-${index}`));
+      if (!source || stages.some(stage => !stage)) return;
+      const nodes = [source, ...(stages as Box[])];
+      const edges: Edge[] = nodes.slice(1).map((node, index) => ({key: `hop-${index}`, d: edge(nodes[index], node)}));
+      for (const target of targetKeys) {
+        const box = read(target);
+        if (box) edges.push({key: target, target, d: edge(nodes.at(-1)!, box)});
+      }
+      const next = {key: layoutKey, edges, width: origin.width, height: origin.height};
+      setGeometry(previous => (JSON.stringify(previous) === JSON.stringify(next) ? previous : next));
+    };
+    const observer = new ResizeObserver(() => {
+      cancelAnimationFrame(pending);
+      pending = requestAnimationFrame(update);
+    });
+    observer.observe(element);
+    for (const node of boxes.values()) observer.observe(node);
+    update();
+    return () => {
+      observer.disconnect();
+      cancelAnimationFrame(pending);
+    };
+  }, [layoutKey, hopCount]);
+  const roles = hops.map(hop => hop.role);
+  const lastFront = roles.lastIndexOf('front');
+  const lastExit = roles.lastIndexOf('exit');
+  return (
+    <div className="rp-chain-topology-frame">
+      <div className="rp-chain-topology" ref={scene} style={{'--rp-chain-hop-count': hopCount} as CSSProperties}>
+        {geometry?.key === layoutKey && (
+          <svg className="rp-chain-wires" viewBox={`0 0 ${geometry.width} ${geometry.height}`} aria-hidden="true">
+            {geometry.edges.map(segment => {
+              const targets = segment.target ? rows.filter(row => row.key === segment.target) : rows;
+              const uploading = moving && targets.some(row => row.upload > 0n);
+              const downloading = moving && targets.some(row => row.download > 0n);
+              return (
+                <g key={segment.key}>
+                  <path d={segment.d} className="rp-chain-wire" />
+                  <path d={segment.d} className="rp-chain-stream upload" data-active={uploading ? '' : undefined} />
+                  <path d={segment.d} className="rp-chain-stream download" data-active={downloading ? '' : undefined} />
+                </g>
+              );
+            })}
+          </svg>
+        )}
+        <div data-chain-node="source" className="rp-chain-node rp-chain-source">
+          <span className="rp-chain-emblem" aria-hidden="true">
+            L
+          </span>
+          <strong>LemonVPN</strong>
+          {!compact && <span className="rp-note">{t('chain.local')}</span>}
+        </div>
+        {hops.map((hop, index) => {
+          const control = index === lastFront ? frontControl : index === lastExit ? exitControl : undefined;
+          const reference = hop.role === 'front' ? via : exit;
+          return (
+            <div data-chain-node={`hop-${index}`} key={`${index}:${hop.id}`} className="rp-chain-node rp-chain-stage">
+              <span className="rp-chain-node-caption">
+                <span className="rp-chain-node-dot" />
+                {t(hop.role === 'front' ? 'chain.front' : 'chain.exit')}
+              </span>
+              {reference !== hop.name && <TextTooltip className="rp-chain-reference">{reference}</TextTooltip>}
+              {control ?? (
+                <strong>
+                  <NodeName name={hop.name} />
+                </strong>
+              )}
+              {!compact && hop.protocol && <span className="rp-chain-node-protocol">{hop.protocol}</span>}
+            </div>
+          );
+        })}
+        <div className="rp-chain-targets">
+          {rows.length ? (
+            rows.map(row => (
+              <div
+                data-chain-node={row.key}
+                key={row.key}
+                className="rp-chain-node rp-chain-target"
+                data-traffic={moving && row.upload + row.download > 0n ? '' : undefined}
+              >
+                <TextTooltip>{row.target}</TextTooltip>
+                {!compact && (
+                  <span className="rp-chain-target-meta">
+                    <span>{t('chain.connectionCount', {n: row.connections})}</span>
+                    <span>↑ {formatRate(fresh ? row.uploadRate : null, locale)}</span>
+                    <span>↓ {formatRate(fresh ? row.downloadRate : null, locale)}</span>
+                  </span>
+                )}
+              </div>
+            ))
+          ) : (
+            <div data-chain-node="empty" className="rp-chain-node rp-chain-empty">
+              <strong>{t('chain.target')}</strong>
+              {!compact && <span className="rp-note">{t('chain.waitForTraffic')}</span>}
+            </div>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+export function ChainFlowPanel({
+  id,
+  initial,
+  network,
+  changeNetwork,
+  enabled = true,
+  compact = false,
+  picker
+}: {
+  id: string;
+  initial: ProxyChain;
+  network: 'tcp' | 'udp';
+  changeNetwork: (network: 'tcp' | 'udp') => void;
+  enabled?: boolean;
+  compact?: boolean;
+  picker?: ReactNode;
+}) {
+  const t = useT();
+  const locale = LOCALE[useLang()];
+  const preview = useContext(ResourcePreview);
+  const shown = useTabShown();
+  const pageVisible = useSyncExternalStore(subscribeVisibility, documentVisible);
+  const [near, visible] = useNearViewport(undefined, 0);
+  const active = enabled && !preview && shown && visible && pageVisible;
+  const live = useChainActivity(id, network, active);
+  const groups = useGroups(active);
+  const chain = live.data?.['x-lemonvpn-chain'] ?? initial;
+  const path = chain[network];
+  const front = path.front_hops ?? path.hops.filter(hop => hop.role === 'front');
+  const exit = path.exit_hops ?? path.hops.filter(hop => hop.role === 'exit');
+  const currentWire = wireKey(path.hops);
+  const view = useMemo(() => {
+    const grouped = new Map<string, {hops: ProxyChainHop[]; rows: ChainTrafficTarget[]; bytes: bigint}>();
+    for (const row of live.targets) {
+      const key = wireKey(row.hops);
+      if (compact && key !== currentWire) continue;
+      const item = grouped.get(key) ?? {hops: row.hops, rows: [], bytes: 0n};
+      item.rows.push(row);
+      item.bytes += row.upload + row.download;
+      grouped.set(key, item);
+    }
+    return [...grouped.entries()].sort((a, b) =>
+      a[1].bytes === b[1].bytes ? (a[0] === currentWire ? -1 : b[0] === currentWire ? 1 : a[0].localeCompare(b[0])) : a[1].bytes > b[1].bytes ? -1 : 1
+    )[0];
+  }, [live.targets, currentWire, compact]);
+  const hops = view?.[1].hops ?? path.hops;
+  const rows = useMemo(() => view?.[1].rows.slice(0, compact ? 1 : 3) ?? [], [view, compact]);
+  const ready = live.fresh && live.measured;
+  const moving = active && ready && path.ready && rows.some(row => row.upload + row.download > 0n);
+  const different = !!view && view[0] !== currentWire;
+  const endpoint = (reference: string | null | undefined, current: ProxyChainHop | undefined, label: string) => {
+    const group = groups.data?.find(group => group.name === reference);
+    return group ? (
+      <ChainEndpointControl key={group.id} id={group.id} chainId={id} current={current} network={network} enabled={active} label={label} />
+    ) : (
+      <strong>
+        <NodeName name={current?.name ?? reference ?? '—'} />
+      </strong>
+    );
+  };
+  const frontControl = endpoint(chain.via, front.at(-1), t('chain.switchFrontNode'));
+  const exitControl = endpoint(chain.exit, exit.at(-1), t('chain.switchExitNode'));
+  return (
+    <section className="rp-chain-flow-panel" ref={near} aria-label={t('chain.liveTopology')} data-compact={compact ? '' : undefined}>
+      <Toolbar>
+        {picker}
+        {!compact && (
+          <span className="rp-chain-flow-status" data-moving={moving ? '' : undefined} role="status">
+            {t(
+              live.error
+                ? 'chain.activityUnavailable'
+                : !live.data || !live.measured
+                  ? 'chain.collecting'
+                  : !live.fresh
+                    ? 'chain.stale'
+                    : moving
+                      ? 'chain.transferring'
+                      : 'chain.idle'
+            )}
+          </span>
+        )}
+        <Segmented
+          label={t('chain.network')}
+          value={network}
+          onChange={value => {
+            if (value === 'tcp' || value === 'udp') changeNetwork(value);
+          }}
+          items={[
+            ['tcp', 'TCP'],
+            ['udp', 'UDP']
+          ]}
+        />
+      </Toolbar>
+      {!compact && (
+        <div className="rp-chain-flow-stats">
+          <span className="upload">↑ {formatRate(ready ? String(live.targets.reduce((total, row) => total + BigInt(row.uploadRate), 0n)) : null, locale)}</span>
+          <span className="download">
+            ↓ {formatRate(ready ? String(live.targets.reduce((total, row) => total + BigInt(row.downloadRate), 0n)) : null, locale)}
+          </span>
+          <Badge>{t('chain.connectionCount', {n: (network === 'tcp' ? live.data?.total_tcp : live.data?.total_udp) ?? 0})}</Badge>
+        </div>
+      )}
+      {(different || !hops.length) && (
+        <div className="rp-chain-selection">
+          <span>
+            {t('chain.currentFront')}
+            {frontControl}
+          </span>
+          <span>
+            {t('chain.currentExit')}
+            {exitControl}
+          </span>
+        </div>
+      )}
+      {different && <p className="rp-note">{t('chain.connectionPathNote')}</p>}
+      {hops.length > 0 && (
+        <Topology
+          hops={hops}
+          rows={rows}
+          via={chain.via}
+          exit={chain.exit ?? path.hops.at(-1)?.name ?? '—'}
+          moving={moving}
+          fresh={!!ready}
+          compact={compact}
+          frontControl={different ? undefined : frontControl}
+          exitControl={different ? undefined : exitControl}
+        />
+      )}
+      {path.error && <InlineAlert tone="notice">{path.error}</InlineAlert>}
+      <ErrorMessage error={live.error} onRetry={live.refetch} />
+      <ErrorMessage error={groups.error} onRetry={groups.refetch} />
+      {!compact && (
+        <span className="rp-note">
+          {t('chain.trafficSampling')}
+          {live.data?.truncated ? ' · ' + t('chain.partialSample') : ''}
+        </span>
+      )}
+    </section>
+  );
+}
