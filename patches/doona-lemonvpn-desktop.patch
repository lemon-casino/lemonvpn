@@ -0,0 +1,47 @@
+import {useCallback} from 'react';
+import {getApi} from '../api';
+import {normalizeResourceKey, type ResourceKey} from '../api/inflight';
+import {LocalError} from '../api/error';
+import {useAction, readBackUnconfirmed} from './action';
+import {groupActions} from './groups';
+import {useCapabilities} from './runtime';
+import {useResource} from './resource';
+import {refetchResource} from './resourceCore';
+import {poll} from './cadence';
+
+// Use the chain's visible transport, without changing the strategy page's shared
+// TCP/UDP selector. The existing group endpoint hot-applies and retires only the
+// affected group's dependent connections.
+export function useChainEndpoint(id: string, chainId: string, network: 'tcp' | 'udp', enabled: boolean) {
+  const api = getApi();
+  const capabilities = useCapabilities().data;
+  const resource = useResource({key: ['group', {id}], every: poll.live, fetch: signal => api.group(id, signal)}, {enabled});
+  const group = resource.data && groupActions(resource.data, capabilities);
+  const action = useAction<'selection'>({shared: `group-action:${id}`});
+  const refresh = useCallback(() => {
+    const keys: ResourceKey[] = [
+      ['group', {id}],
+      ['group', {id: chainId}],
+      ['groups'],
+      ['chainActivity', {id: chainId, network: 'tcp'}],
+      ['chainActivity', {id: chainId, network: 'udp'}]
+    ];
+    return Promise.all(keys.map(key => refetchResource(api, normalizeResourceKey(key))));
+  }, [api, id, chainId]);
+  const pick = (member: string) =>
+    action.run('selection', async signal => {
+      if (!enabled || !group || !(group.capabilities.can_select || group.capabilities.can_override)) throw new LocalError('ui.groupNotLoaded');
+      if (!group.members.some(item => item.id === member)) throw new LocalError('ui.groupNotLoaded');
+      const current = group.runtime.selection[network];
+      const release = group.capabilities.can_override && current?.source === 'override' && current.member_id === member;
+      if (!release && !group.capabilities.can_override && current?.member_id === member) return;
+      const result = release
+        ? await api.clearGroupOverride(id, network, signal).catch(readBackUnconfirmed(refresh, signal))
+        : await api.selectGroup(id, {member_id: member, network}, signal).catch(readBackUnconfirmed(refresh, signal));
+      // Explicit reads bypass the event debounce, including an already-open
+      // preview using the other transport. In-flight old reads get a follow-up.
+      await refresh();
+      return result;
+    });
+  return {...resource, data: group, busy: action.busy, actionError: action.error, pick};
+}
