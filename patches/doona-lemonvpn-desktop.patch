@@ -0,0 +1,65 @@
+import {useEffect, useState} from 'react';
+import {useT} from '../../i18n';
+import {desktop, invokeDesktop} from '../../desktop';
+import {Button, Card, ErrorMessage, Switch} from '../../ui/ui';
+type Status = {autostart: boolean; service_installed: boolean};
+
+export function DesktopSettingsCard() {
+  const t = useT();
+  const [status, setStatus] = useState<Status>();
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<Error | null>(null);
+  const run = async (command: string, args?: Record<string, unknown>) => {
+    setBusy(true);
+    setError(null);
+    try {
+      setStatus(await invokeDesktop<Status>(command, args));
+    } catch (error) {
+      setError(error instanceof Error ? error : new Error(String(error)));
+    } finally {
+      setBusy(false);
+    }
+  };
+  useEffect(() => {
+    const platform = desktop?.platform;
+    if (platform !== 'windows' && platform !== 'macos' && platform !== 'linux') return;
+    let current = true;
+    void invokeDesktop<Status>('windows_integration_status').then(
+      status => {
+        if (current) setStatus(status);
+      },
+      error => {
+        if (current) setError(error instanceof Error ? error : new Error(String(error)));
+      }
+    );
+    return () => {
+      current = false;
+    };
+  }, []);
+  const macos = desktop?.platform === 'macos';
+  const linux = desktop?.platform === 'linux';
+  const supported = desktop?.platform === 'windows' || macos || linux;
+  if (!supported) return null;
+  return (
+    <Card level={2} title={t(macos ? 'desktop.integrationMacos' : linux ? 'desktop.integrationLinux' : 'desktop.integration')} titleId="settings-desktop">
+      <ErrorMessage error={error} />
+      <Switch
+        isSelected={status?.autostart ?? false}
+        isDisabled={busy || !status}
+        onChange={enabled => void run('autostart_set', {enabled})}
+        description={t(macos ? 'desktop.autostartHelpMacos' : linux ? 'desktop.autostartHelpLinux' : 'desktop.autostartHelp')}
+      >
+        {t('desktop.autostart')}
+      </Switch>
+      <div className="rp-actions">
+        <Button
+          onPress={() =>
+            void invokeDesktop('window_action', {action: 'quit'}).catch(error => setError(error instanceof Error ? error : new Error(String(error))))
+          }
+        >
+          {t('desktop.quit')}
+        </Button>
+      </div>
+    </Card>
+  );
+}
