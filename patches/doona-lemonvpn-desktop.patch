+    overflow: hidden;
+    border-inline-end: 1px solid var(--rp-line);
+  }
+  .rp-desktop-side > div + div {
+    margin-block-start: 0;
+  }
+  .rp-desktop-side .rp-side-links {
+    padding-inline: 12px;
