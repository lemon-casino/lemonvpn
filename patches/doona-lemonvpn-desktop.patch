+export type ProviderSettings = {name: string; url: string; update_interval: number; user_agent: string; cache: boolean};
+export type TunStatus = {
+  enabled: boolean;
+  supported?: boolean;
+  adapter?: string;
+  address?: string;
+  host_address?: string;
+  udp?: string;
+  recovering?: string | null;
