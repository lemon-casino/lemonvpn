+import {lazy, Suspense} from 'react';
+import {withCatalogue, useT} from '../../i18n';
+import {PageSkeleton, Tabs} from '../../ui/ui';
+import {useCapabilities} from '../../store';
+import {hasDesktop} from '../../desktop';
+import type {PageProps} from '../../shell/routes';
+import {within} from '../../shell/route';
+import {Activity as Dashboard} from '../../shell/widgets/Dashboard';
+
+const Connections = lazy(withCatalogue('rest', () => import('../connections/Connections').then(module => ({default: module.Connections}))));
+
+export function Activity(props: PageProps) {
+  const t = useT();
+  const capabilities = useCapabilities();
+  if (!hasDesktop) return <Dashboard {...props} />;
+  const section = new URLSearchParams(props.query).get('section') === 'connections' ? 'connections' : 'dashboard';
+  const available = capabilities.data?.resources.connections.available !== false;
+  const items = [{id: 'dashboard', label: t('activity.dashboardTab'), content: <Dashboard {...props} />}];
+  if (available)
+    items.push({
+      id: 'connections',
+      label: t('nav.connections'),
+      content: (
+        <Suspense fallback={<PageSkeleton />}>
+          <Connections {...props} />
+        </Suspense>
+      )
+    });
+  return (
+    <div className="rp-page rp-activity-hub">
+      <Tabs
+        page
+        label={t('nav.activity')}
+        value={available ? section : 'dashboard'}
+        onChange={next => props.go('activity', within(props.query, {section: next === 'dashboard' ? null : next}))}
+        items={items}
+      />
+    </div>
+  );
+}
