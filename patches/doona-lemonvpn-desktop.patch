--- /dev/null
+++ b/src/dae/dnsUpstreams.ts
@@ -0,0 +1,55 @@
+import type {ConfigSource} from '../api/model';
+import {blockFields, scanConfig, unquote, quote} from './text';
+
+export function readDnsUpstreams(sources: ConfigSource[]) {
+  return sources.flatMap(source => {
+    const {blocks, tokens} = scanConfig(source.content);
+    return blocks
+      .filter(block => block.name === 'dns')
+      .flatMap(dns => dns.children.filter(block => block.name === 'upstream'))
+      .flatMap(block =>
+        blockFields(source.content, block, tokens).map(field => ({
+          id: `${source.id}:${field.from}`,
+          source,
+          field,
+          name: field.name,
+          address: unquote(field.value)
+        }))
+      );
+  });
+}
+export type DnsUpstreamEntry = ReturnType<typeof readDnsUpstreams>[number];
+
+export function upstreamAddress(value: string): string | null {
+  const address = value.trim().includes('://') ? value.trim() : `udp://${value.trim()}`;
+  const match = /^(udp|tcp|tcp\+udp):\/\/(\[[0-9a-fA-F:]+\]|[^:\s/?#@'"{}\\]+):(\d+)$/.exec(address);
+  return match && Number(match[3]) > 0 && Number(match[3]) <= 65535 ? address : null;
+}
+
+// Only one source is changed, retaining rule blocks, comments and unrelated upstreams.
+export function writeDnsUpstream(text: string, name: string, address: string, entry?: DnsUpstreamEntry, remove = false): string | null {
+  if (entry) {
+    if (text !== entry.source.content) return null;
+    const field = entry.field;
+    if (!remove) return text.slice(0, field.valueFrom) + ` ${quote(address)}` + text.slice(field.valueTo);
+    const start = text.lastIndexOf('\n', field.from - 1) + 1;
+    const newline = text.indexOf('\n', field.to);
+    const end = newline < 0 ? text.length : newline;
+    const isolated = /^\s*$/.test(text.slice(start, field.from)) && /^\s*(?:#.*)?$/.test(text.slice(field.to, end));
+    return isolated ? text.slice(0, start) + text.slice(newline < 0 ? end : end + 1) : text.slice(0, field.from) + text.slice(field.to);
+  }
+  const dns = scanConfig(text)
+    .blocks.filter(block => block.name === 'dns')
+    .at(-1);
+  const block = dns?.children.filter(child => child.name === 'upstream').at(-1);
+  const parent = block ?? dns;
+  if (parent) {
+    const at = text.lastIndexOf('\n', parent.close - 1) + 1;
+    const indent = text.slice(at, parent.close);
+    if (at <= parent.open || !/^[ \t]*$/.test(indent)) return null;
+    const rule = `${indent}  ${name}: ${quote(address)}\n`;
+    const added = block ? rule : `${indent}  upstream {\n  ${rule}${indent}  }\n`;
+    return text.slice(0, at) + added + text.slice(at);
+  }
+  return text + `${text.endsWith('\n') ? '' : '\n'}\ndns {\n  upstream {\n    ${name}: ${quote(address)}\n  }\n}\n`;
+}
