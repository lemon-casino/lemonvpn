new file mode 100644
index 00000000..159ba4f3
--- /dev/null
+++ b/src/features/dns/Upstreams.tsx
@@ -0,0 +1,203 @@
+import {useMemo, useState} from 'react';
+import {hasDesktop} from '../../desktop';
+import {useCapabilities, useConfig, useConfigEditor, useDnsRules} from '../../store';
+import {useCompleteness} from '../../store/config';
+import type {ConfigSource} from '../../api/model';
+import {useT} from '../../i18n';
+import {useDraftGuard} from '../../shell/draft';
+import {href} from '../../shell/route';
+import {isBareName} from '../../dae/text';
+import {readDnsUpstreams, upstreamAddress, writeDnsUpstream, type DnsUpstreamEntry} from '../../dae/dnsUpstreams';
+import {Button, Card, DataTable, ErrorMessage, Form, InlineAlert, Link, ModalDialog, TextField, Toolbar, toast} from '../../ui/ui';
+import Edit from '../../ui/icons/Edit';
+import Close from '../../ui/icons/Close';
+
+type Dialog = {kind: 'add' | 'edit' | 'remove'; source: ConfigSource; generation: string; entry?: DnsUpstreamEntry};
+export function Upstreams() {
+  const t = useT();
+  const caps = useCapabilities().data?.resources;
+  const config = useConfig(hasDesktop && caps?.config.available === true);
+  const dns = useDnsRules(hasDesktop && caps?.dns_rules.available === true);
+  const sources = config.data?.sources ?? [];
+  const complete = useCompleteness(sources);
+  const rows = useMemo(() => readDnsUpstreams(config.data?.sources ?? []), [config.data?.sources]);
+  const [dialog, setDialog] = useState<Dialog | null>(null);
+  const [name, setName] = useState('');
+  const [address, setAddress] = useState('');
+  const [problem, setProblem] = useState<string | null>(null);
+  const retry = () => {
+    config.refetch();
+    dns.refetch();
+  };
+  const editor = useConfigEditor(retry, {shared: 'main-source-edit'});
+  const busy = !!editor.busy;
+  const writable = (source: ConfigSource) => caps?.config.writable === true && source.writable && complete(source) === true;
+  const main = sources.find(source => source.kind === 'main' && writable(source));
+  const guard = useDraftGuard(
+    dialog !== null && dialog.kind !== 'remove' && (name !== (dialog.entry?.name ?? '') || address !== (dialog.entry?.address ?? '')),
+    () => setDialog(null),
+    'config.draftConfig'
+  );
+  const close = () => {
+    if (!busy) {
+      guard.clear();
+      setDialog(null);
+    }
+  };
+  const open = (kind: Dialog['kind'], source: ConfigSource, entry?: DnsUpstreamEntry) => {
+    if (busy || !writable(source) || !config.data) return;
+    setDialog({kind, source, generation: config.data.generation_id, entry});
+    setName(entry?.name ?? '');
+    setAddress(entry?.address ?? '');
+    setProblem(null);
+  };
+  const duplicate = dialog?.kind === 'add' && rows.some(row => row.name.toLowerCase() === name.trim().toLowerCase());
+  const reserved = ['accept', 'reject', 'nxdomain', 'refused', 'servfail'].includes(name.trim().toLowerCase());
+  const nameError = name && (!isBareName(name.trim()) || duplicate || reserved) ? t('dns.upstreamNameInvalid') : undefined;
+  const addressError = address && !upstreamAddress(address) ? t('dns.upstreamAddressInvalid') : undefined;
+  const referenced = (entry: DnsUpstreamEntry) =>
+    [...(dns.data?.request ?? []), ...(dns.data?.response ?? [])].some(rule => rule.source && rule.upstream?.toLowerCase() === entry.name.toLowerCase());
+  const canRemove = (entry: DnsUpstreamEntry) => rows.length > 1 && dns.data?.generation_id === config.data?.generation_id && !referenced(entry);
+  const save = async () => {
+    if (!dialog || busy || !writable(dialog.source)) return;
+    if (dialog.generation !== config.data?.generation_id) {
+      setProblem(t('rule.stale'));
+      retry();
+      return;
+    }
+    const normalized = upstreamAddress(address);
+    if (dialog.kind !== 'remove' && (!name.trim() || nameError || !normalized)) return;
+    if (dialog.kind === 'remove' && (!dialog.entry || !canRemove(dialog.entry))) {
+      setProblem(t('dns.upstreamProtected'));
+      return;
+    }
+    const result = await editor.apply(dialog.source, text => {
+      const next = text === dialog.source.content ? writeDnsUpstream(text, name.trim(), normalized ?? '', dialog.entry, dialog.kind === 'remove') : null;
+      if (next === null) setProblem(t('rule.stale'));
+      return next;
+    });
+    if (!result) return;
+    if (result.diagnostics) {
+      setProblem(
+        result.diagnostics
+          .filter(row => row.level === 'error')
+          .map(row => row.message)
+          .join('；')
+      );
+      return;
+    }
+    guard.clear();
+    setDialog(null);
+    retry();
+    toast('positive', t('dns.upstreamSaved'));
+  };
+  if (!hasDesktop || !caps?.config.available) return null;
+  return (
+    <>
+      <Card title={t('dns.upstreamsTitle')} note={t('dns.upstreamsHelp')}>
+        <Toolbar page>
+          <Link appearance="button" href={href('rules', {tab: 'dns'})}>
+            {t('rule.dnsTitle')}
+          </Link>
+          <span className="rp-grow" />
+          <Button
+            isDisabled={!main || busy}
+            onPress={() => {
+              if (main) open('add', main);
+            }}
+          >
+            {t('dns.upstreamAdd')}
+          </Button>
+        </Toolbar>
+        <ErrorMessage error={config.error ?? editor.error ?? dns.error} onRetry={retry} />
+        <DataTable
+          label={t('dns.upstreamsTitle')}
+          loading={config.loading}
+          rows={rows}
+          fit
+          empty={t('dns.upstreamEmpty')}
+          cols={[
+            {id: 'name', label: t('ui.name'), minWidth: 120, isRowHeader: true, render: row => row.name},
+            {id: 'address', label: t('dns.upstreamAddress'), minWidth: 240, text: 'wrap', render: row => row.address},
+            {id: 'source', label: t('rule.where'), minWidth: 120, render: row => row.source.path},
+            {
+              id: 'actions',
+              label: t('ui.actions'),
+              minWidth: 96,
+              grow: 0,
+              actions: true,
+              render: row => (
+                <span className="rp-chain">
+                  <Button quiet small icon label={t('rule.edit')} isDisabled={busy || !writable(row.source)} onPress={() => open('edit', row.source, row)}>
+                    <Edit />
+                  </Button>
+                  <Button
+                    quiet
+                    small
+                    icon
+                    label={t('rule.remove')}
+                    tip={!canRemove(row) ? t('dns.upstreamProtected') : undefined}
+                    isDisabled={busy || !writable(row.source) || !canRemove(row)}
+                    onPress={() => open('remove', row.source, row)}
+                  >
+                    <Close />
+                  </Button>
+                </span>
+              )
+            }
+          ]}
+        />
+      </Card>
+      <ModalDialog
+        isOpen={dialog !== null}
+        title={t(dialog?.kind === 'remove' ? 'dns.upstreamRemove' : dialog?.kind === 'edit' ? 'dns.upstreamEdit' : 'dns.upstreamAdd')}
+        narrow
+        locked={busy}
+        onOpenChange={open => {
+          if (!open) close();
+        }}
+        footer={() => (
+          <>
+            <Button isDisabled={busy} onPress={close}>
+              {t('ui.cancel')}
+            </Button>
+            <Button
+              accent={dialog?.kind !== 'remove'}
+              negative={dialog?.kind === 'remove'}
+              isPending={busy}
+              isDisabled={busy || (dialog?.kind !== 'remove' && (!name.trim() || !!nameError || !upstreamAddress(address)))}
+              onPress={() => void save()}
+            >
+              {t(dialog?.kind === 'remove' ? 'rule.remove' : 'settings.save')}
+            </Button>
+          </>
+        )}
+      >
+        {problem && <InlineAlert tone="negative">{problem}</InlineAlert>}
+        <ErrorMessage error={editor.error} onRetry={retry} />
+        {dialog?.kind === 'remove' ? (
+          <p>{t('dns.upstreamRemoveHelp', {name})}</p>
+        ) : (
+          <Form
+            className="rp-list"
+            onSubmit={event => {
+              event.preventDefault();
+              void save();
+            }}
+          >
+            <TextField label={t('ui.name')} value={name} onChange={setName} isDisabled={busy || dialog?.kind === 'edit'} error={nameError} />
+            <TextField
+              label={t('dns.upstreamAddress')}
+              value={address}
+              onChange={setAddress}
+              isDisabled={busy}
+              error={addressError}
+              placeholder="udp://223.5.5.5:53"
+            />
+            <span className="rp-note">{t('dns.upstreamAddressHelp')}</span>
+          </Form>
+        )}
+      </ModalDialog>
+    </>
+  );
+}
