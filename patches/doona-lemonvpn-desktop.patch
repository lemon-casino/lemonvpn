diff --git a/src/features/policies/group/GroupRemoveDialog.tsx b/src/features/policies/group/GroupRemoveDialog.tsx
new file mode 100644
index 00000000..17176412
--- /dev/null
+++ b/src/features/policies/group/GroupRemoveDialog.tsx
@@ -0,0 +1,188 @@
+import {useEffect, useMemo, useRef, useState} from 'react';
+import {useT} from '../../../i18n';
+import {getApi} from '../../../api';
+import {useConfig, useCompleteness} from '../../../store/config';
+import {refetchAll, useCapabilities, useGroups, useNodes} from '../../../store';
+import {useAction} from '../../../store/action';
+import {editProblem, type MainSourceEdit} from '../../../store/mainSource';
+import {ConfirmDialog, ErrorMessage, toast, type Problem} from '../../../ui/ui';
+import {SearchSelect} from '../../../ui/SearchSelect';
+import {groupReferenceDetails, planGroupRemoval, removeGroupEntry, excludedReplacements} from '../../../dae/groupRemoval';
+import {isWritableName} from '../../../dae/groups';
+import type {PolicyDeclaration} from './useGroupDialog';
+import {failureNotice, noticeText} from '../../../api/error';
+import {ruleOutbounds} from '../../shared/rule';
+import {useModeDraft} from '../../shared/useModeDraft';
+
+type Props = {name: string; open: boolean; close: () => void; source: MainSourceEdit; declaration: PolicyDeclaration};
+const referenceLabels = {
+  routing: 'group.reference.routing',
+  global: 'group.reference.global',
+  'group-filter': 'group.reference.group-filter',
+  chain: 'group.reference.chain',
+  'group-final': 'group.reference.group-final'
+} as const;
+export function GroupRemoveDialog(props: Props) {
+  return props.open ? <Removal {...props} /> : null;
+}
+function Removal({name, close, source, declaration}: Props) {
+  const t = useT();
+  const api = getApi();
+  const capabilities = useCapabilities();
+  const atomic =
+    !!api.deleteGroup && (capabilities.data?.extensions?.['x-group-management'] as {replace_references?: boolean} | undefined)?.replace_references === true;
+  const config = useConfig();
+  const groups = useGroups();
+  const nodes = useNodes();
+  const sources = useMemo(() => config.data?.sources ?? [], [config.data]);
+  const complete = useCompleteness(sources);
+  const refs = useMemo(() => groupReferenceDetails(sources, name), [sources, name]);
+  const excluded = useMemo(() => excludedReplacements(sources, name), [sources, name]);
+  const needsGroup = refs.some(ref => ref.kind === 'group-filter');
+  const needsProxy = refs.some(ref => ref.kind === 'chain');
+  const [replacement, setReplacement] = useState('');
+  const [problem, setProblem] = useState<Problem | null>(null);
+  const present = useRef(true);
+  useEffect(() => {
+    present.current = true;
+    return () => {
+      present.current = false;
+    };
+  }, []);
+  const [, setModeDraft] = useModeDraft();
+  const write = useAction<'deleteGroup'>({shared: 'main-source-edit', rethrow: true});
+  const sections = useMemo(() => {
+    const offeredGroups = (groups.data ?? []).filter(group => {
+      if (excluded.has(group.name) || !isWritableName(group.name)) return false;
+      if ((nodes.data ?? []).some(node => node.name === group.name)) return false;
+      return !needsGroup || !group['x-lemonvpn-chain'];
+    });
+    return [
+      ...ruleOutbounds(offeredGroups, t).filter(section => section.id !== 'builtin' || (!needsGroup && !needsProxy)),
+      ...(!needsGroup
+        ? [
+            {
+              id: 'nodes',
+              title: t('policy.pickNodes'),
+              items: (nodes.data ?? [])
+                .filter(node => !excluded.has(node.name) && isWritableName(node.name) && !(groups.data ?? []).some(group => group.name === node.name))
+                .map(node => ({id: node.name, label: node.name}))
+            }
+          ]
+        : [])
+    ].filter(section => section.items.length);
+  }, [groups.data, nodes.data, excluded, needsGroup, needsProxy, t]);
+  const offered = sections.some(section => section.items.some(item => item.id === replacement));
+  const owner = declaration.owner;
+  const origin = owner && owner !== 'ambiguous' ? sources.find(item => item.id === owner.origin.id) : undefined;
+  const writable = !!origin?.writable && refs.every(ref => sources.find(item => item.id === ref.source)?.writable);
+  const ready =
+    writable && source.writable && !!config.data?.generation_id && sources.length > 0 && sources.every(item => complete(item) === true) && !config.error;
+  const pending = write.busy === 'deleteGroup';
+  const remove = async () => {
+    if (!ready || write.busy || source.busy || (refs.length > 0 && (!atomic || !offered)) || !origin) return;
+    setProblem(null);
+    try {
+      const result = await write.run('deleteGroup', async signal => {
+        if (atomic && api.deleteGroup) {
+          const planned = planGroupRemoval(sources, name, refs.length ? replacement : null);
+          const result = await api.deleteGroup(
+            {
+              generation_id: config.data!.generation_id!,
+              group_id: `group-${name}`,
+              replacement: refs.length ? replacement : null,
+              sources: planned.map(item => ({
+                source_id: item.id,
+                content_sha256: sources.find(old => old.id === item.id)!.content_sha256,
+                content: item.content
+              }))
+            },
+            signal
+          );
+          await Promise.all([config.refetch(), groups.refetch()]);
+          return result;
+        }
+        // Older backends can still remove an unreferenced declaration through
+        // their existing editor; referenced deletion never falls back to a series of writes.
+        return null;
+      });
+      if (result === undefined) return;
+      if (result === null) {
+        const saved = await source.apply(text => removeGroupEntry(text, name), origin);
+        const issue = editProblem(saved, t);
+        if (issue) {
+          setProblem({id: Date.now(), text: noticeText(issue, t), kind: issue.kind});
+          return;
+        }
+        if (saved.kind !== 'ok') return;
+      }
+      setModeDraft(null);
+      toast('positive', t('group.removed', {name}));
+      close();
+      void refetchAll();
+    } catch (error) {
+      const issue = failureNotice(error, t, t('ui.writeFailed'));
+      if (present.current) setProblem({id: Date.now(), text: noticeText(issue, t), kind: issue.kind});
+      else toast(issue.kind, noticeText(issue, t));
+      // A dropped write reply is not retried. Read accepted state back instead.
+      void refetchAll();
+    }
+  };
+  const label = t(refs.length ? 'group.replaceAndDelete' : 'ui.delete');
+  return (
+    <ConfirmDialog
+      title={t('group.removeTitle', {name})}
+      isOpen
+      onCancel={close}
+      confirmLabel={label}
+      onConfirm={() => void remove()}
+      isPending={pending}
+      isDisabled={!ready || source.busy || !!write.busy || (refs.length > 0 && (!atomic || !offered))}
+      error={problem}
+      scrollBody
+    >
+      <p className="rp-label">{t('group.removeHelp')}</p>
+      {refs.length > 0 && (
+        <>
+          <p>{t('group.replacementSummary', {n: refs.length})}</p>
+          <SearchSelect
+            label={t('group.replacementLabel')}
+            searchLabel={t('ui.filterOutbounds')}
+            value={replacement}
+            sections={sections}
+            onChange={value => {
+              setReplacement(value);
+              setProblem(null);
+            }}
+            isDisabled={pending || !atomic}
+            description={t(needsGroup ? 'group.replacementGroupOnly' : needsProxy ? 'group.replacementProxyOnly' : 'group.replacementHelp')}
+          />
+          {!atomic && <p className="rp-field-error">{t('group.replacementUnsupported')}</p>}
+          {atomic && !sections.length && !groups.loading && !nodes.loading && <p className="rp-field-error">{t('group.replacementNoChoices')}</p>}
+          <ul>
