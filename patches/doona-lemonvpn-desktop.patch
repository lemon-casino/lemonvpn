diff --git a/src/store/chainActivity.ts b/src/store/chainActivity.ts
new file mode 100644
index 00000000..14742c4e
--- /dev/null
+++ b/src/store/chainActivity.ts
@@ -0,0 +1,131 @@
+import {useEffect, useState} from 'react';
+import {getApi} from '../api';
+import type {Connection, ConnectionList, ProxyChainHop} from '../api/model';
+import {parseU64} from '../api/u64';
+import {useResource} from './resource';
+
+export type ChainTrafficTarget = {
+  key: string;
+  target: string;
+  hops: ProxyChainHop[];
+  frontCount: number;
+  connections: number;
+  upload: bigint;
+  download: bigint;
+  uploadRate: string;
+  downloadRate: string;
+};
+type Measurement = {key: string; scope: string; observed: string; measured: boolean; targets: ChainTrafficTarget[]};
+type Sample = {scope: string; input: ConnectionList; baseline: ConnectionList; measurement: Measurement};
+const interval = 1000;
+const expires = 1800;
+const wire = (connection: Connection) => connection.chain.filter(hop => hop.startsWith('node-'));
+
+// Lifetime totals never start an animation. A delta requires a previous sample,
+// or a new connection whose start is inside that measured interval.
+function measure(data: ConnectionList, before: ConnectionList | undefined, id: string, network: 'tcp' | 'udp'): ChainTrafficTarget[] {
+  const chain = data['x-lemonvpn-chain'];
+  const path = chain?.[network];
+  const span = before ? Date.parse(data.observed_at) - Date.parse(before.observed_at) : NaN;
+  const comparable = before?.instance_id === data.instance_id && Number.isFinite(span) && span >= 250;
+  const old = new Map(comparable ? before![network].map(connection => [connection.id, connection]) : []);
+  const grouped = new Map<string, ChainTrafficTarget>();
+  for (const connection of data[network]) {
+    if (connection.chain_source !== 'evaluation' || !connection.chain.includes(id)) continue;
+    const nodes = wire(connection);
+    if (nodes.length < 2) continue;
+    const front = connection['x-lemonvpn-front-hops'];
+    const frontCount = typeof front === 'number' && front > 0 && front < nodes.length ? front : Math.max(1, nodes.length - 1);
+    const target = connection.domain || connection.dst;
+    if (!target) continue;
+    const key = JSON.stringify([nodes, frontCount, target]);
+    let row = grouped.get(key);
+    if (!row) {
+      row = {
+        key,
+        target,
+        frontCount,
+        connections: 0,
+        upload: 0n,
+        download: 0n,
+        uploadRate: '0',
+        downloadRate: '0',
+        hops: nodes.map((node, index) => ({
+          id: node,
+          name: node.slice(5),
+          protocol: path?.hops.find(hop => hop.id === node)?.protocol ?? '',
+          role: index < frontCount ? 'front' : 'exit'
+        }))
+      };
+      grouped.set(key, row);
+    }
+    row.connections++;
+    if (!comparable) continue;
+    const previous = old.get(connection.id);
+    const same = previous && JSON.stringify(wire(previous)) === JSON.stringify(nodes);
+    const newlyOpened = !previous && Date.parse(connection.started_at ?? '') > Date.parse(before!.observed_at);
+    if (!same && !newlyOpened) continue;
+    for (const field of ['upload', 'download'] as const) {
+      const to = parseU64(connection[`${field}_bytes`]);
+      const from = same ? parseU64(previous[`${field}_bytes`]) : 0n;
+      if (to !== null && from !== null && to >= from) row[field] += to - from;
+    }
+  }
+  for (const row of grouped.values()) {
+    if (comparable) {
+      row.uploadRate = String((row.upload * 1000n) / BigInt(Math.round(span)));
+      row.downloadRate = String((row.download * 1000n) / BigInt(Math.round(span)));
+    }
+  }
+  return [...grouped.values()].sort((a, b) =>
+    a.upload + a.download === b.upload + b.download ? a.key.localeCompare(b.key) : a.upload + a.download > b.upload + b.download ? -1 : 1
+  );
+}
+
+export function useChainActivity(id: string, network: 'tcp' | 'udp', enabled: boolean) {
+  const api = getApi();
+  const resource = useResource(
+    {
+      key: ['chainActivity', {id, network}],
+      every: interval,
+      fetch: signal => api.connections({type: network, detail: 'full', limit: 256, 'x-group': id}, signal)
+    },
+    {enabled}
+  );
+  const scope = `${id}\0${network}`;
+  const [sample, setSample] = useState<Sample | null>(null);
+  const [expired, setExpired] = useState('');
+  const data = resource.data;
+  // Retain the previous external snapshot as state and adjust before commit.
+  // This avoids an effect-driven blank frame between the data and its rates.
+  if (!enabled || !data) {
+    if (sample) setSample(null);
+  } else if (sample?.scope !== scope || sample.input !== data) {
+    const previous = sample?.scope === scope ? sample.baseline : undefined;
+    const same = previous?.instance_id === data.instance_id && Date.parse(data.observed_at) === Date.parse(previous.observed_at);
+    const targets = measure(data, previous, id, network);
+    const key = `${scope}\0${data.instance_id}\0${data.observed_at}`;
+    const span = previous?.instance_id === data.instance_id ? Date.parse(data.observed_at) - Date.parse(previous.observed_at) : NaN;
+    setSample({
+      scope,
+      input: data,
+      baseline: !previous || !Number.isFinite(span) || span >= 250 || span < 0 ? data : previous,
+      measurement: same && sample ? sample.measurement : {key, scope, targets, observed: data.observed_at, measured: Number.isFinite(span) && span >= 250}
+    });
+  }
+  const measurement = sample?.measurement;
+  useEffect(() => {
+    if (!measurement) return;
+    const timer = setTimeout(() => setExpired(measurement.key), expires);
+    return () => clearTimeout(timer);
+  }, [measurement]);
+  const valid = measurement?.scope === scope && measurement.observed === resource.data?.observed_at;
+  const fresh = enabled && valid && measurement.key !== expired && !resource.error;
+  return {
+    ...resource,
+    targets: valid ? measurement.targets : [],
+    sampleKey: valid ? measurement.key : '',
+    fresh: !!fresh,
+    measured: valid && measurement.measured
+  };
+}
