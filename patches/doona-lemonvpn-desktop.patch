diff --git a/src/features/rules/RuleManagement.tsx b/src/features/rules/RuleManagement.tsx
new file mode 100644
index 00000000..0378e47f
--- /dev/null
+++ b/src/features/rules/RuleManagement.tsx
@@ -0,0 +1,293 @@
+import {useId, useMemo, useRef, useState} from 'react';
+import type {RuleScope} from '../../api/api';
+import {getApi} from '../../api';
+import {errorText} from '../../api/error';
+import {useCapabilities, useVersion} from '../../store';
+import {engineOf} from '../../api/engines';
+import {useAction} from '../../store/action';
+import {useT} from '../../i18n';
+import {Button, InlineAlert, ModalDialog, toast, toastFailure} from '../../ui/ui';
+import {TableDragHandle, TableDropIndicator} from '../../ui/TableDrag';
+import {DaeCode} from '../../ui/DaeCode';
+import {useDragAndDrop} from '../../ui/dragAndDrop';
+import type {DictionaryView} from './view';
+import '../../ui/styles/rule-order.css';
+
+type Row = DictionaryView['rows'][number];
+type Reset = {generation: string; defaults: string[]};
+const fallback = (row: Row) => row.kind === 'fallback';
+const movable = (row: Row) => !fallback(row) && row.removable && !row.modeManaged;
+const rowText = (row: Row) => (row.expression.includes('->') || fallback(row) ? row.expression : `${row.expression} -> ${row.outbound}`);
+
+export function useRuleManagement({
+  scope,
+  rows,
+  generation,
+  canWrite,
+  blocked,
+  retry,
+  onReordered
+}: {
+  scope: RuleScope;
+  rows: Row[];
+  generation?: string;
+  canWrite: boolean;
+  blocked: boolean;
+  retry: () => void;
+  onReordered?: () => void;
+}) {
+  const t = useT();
+  const api = getApi();
+  const hotApply = engineOf(useVersion().data).hotApply;
+  const capability = useCapabilities().data?.extensions?.['x-rule-management'] as {available?: boolean} | undefined;
+  const action = useAction<'defaults' | 'order' | 'reset'>({shared: 'main-source-edit', rethrow: true});
+  const [reset, setReset] = useState<Reset | null>(null);
+  const [problem, setProblem] = useState<string | null>(null);
+  const [stale, setStale] = useState(false);
+  const [preview, setPreview] = useState<{generation: string; rows: Row[]} | null>(null);
+  const [saving, setSaving] = useState(false);
+  const pending = useRef(false);
+  const drag = useRef<{generation: string | undefined} | null>(null);
+  const owner = useId();
+  const dragType = `application/x-lemonvpn-rule-${scope}`;
+  const available = canWrite && capability?.available === true && !!api.ruleDefaults && !!api.manageRules;
+  const waiting = preview !== null && preview.generation === generation;
+  const busy = action.busy !== null || waiting || saving;
+  const disabled = !available || busy || blocked || !generation || reset !== null || rows.filter(movable).length < 2;
+  const displayed = useMemo(() => (waiting ? preview.rows : rows), [waiting, preview, rows]);
+  const close = () => {
+    if (!busy) setReset(null);
+  };
+  const openReset = async () => {
+    if (!available || !generation || busy || blocked || pending.current) return;
+    try {
+      const defaults = await action.run('defaults', signal => api.ruleDefaults!(signal));
+      if (!defaults) return;
+      if (defaults.generation_id !== generation) {
+        toast('negative', t('rule.stale'));
+        retry();
+        return;
+      }
+      setProblem(null);
+      setStale(false);
+      setReset({generation, defaults: defaults[scope]});
+    } catch (error) {
+      toastFailure(error, t, t('ui.writeFailed'));
+    }
+  };
+  const saveReset = async () => {
+    if (!reset || busy || stale || pending.current || !api.manageRules) return;
+    pending.current = true;
+    try {
+      const result = await action.run('reset', signal => api.manageRules!({list: scope, generation_id: reset.generation}, true, signal));
+      if (!result) return;
+      setReset(null);
+      onReordered?.();
+      retry();
+      toast('positive', t('rule.resetDone'));
+    } catch (error) {
+      setProblem(errorText(error, t));
+      setStale(true);
+      retry();
+    } finally {
+      pending.current = false;
+    }
+  };
+  const reorder = async (keys: ReadonlySet<unknown>, target: string, after: boolean, startedGeneration = drag.current?.generation) => {
+    if (disabled || pending.current || !generation || !api.manageRules || keys.has(target)) return;
+    if (startedGeneration !== generation) {
+      toast('negative', t('rule.stale'));
+      retry();
+      return;
+    }
+    const moved = rows.filter(row => keys.has(row.id));
+    if (!moved.length || moved.some(row => !movable(row)) || moved.length !== keys.size) return;
+    const rest = rows.filter(row => !keys.has(row.id));
+    const at = rest.findIndex(row => row.id === target);
+    if (at < 0) return;
+    rest.splice(at + (after ? 1 : 0), 0, ...moved);
+    // Keep mode, uneditable and fallback rows in their existing slots.
+    const ordered = rest.filter(movable);
+    let index = 0;
+    const next = rows.map(row => (movable(row) ? ordered[index++] : row));
+    if (next.every((row, index) => row.id === rows[index].id)) return;
+    const ids = next.filter(row => !fallback(row)).map(row => row.id);
+    pending.current = true;
+    setPreview({generation, rows: next.map((row, index) => (fallback(row) ? row : {...row, number: String(index + 1)}))});
+    setSaving(true);
+    let committed = false;
+    try {
+      const result = await action.run('order', signal => api.manageRules!({list: scope, generation_id: generation, rule_ids: ids}, false, signal));
+      if (!result || result.generation_id === generation) setPreview(null);
+      if (!result) return;
+      committed = true;
+      // IDs are positional and are reassigned by the engine. Confirm the persisted
+      // expressions in a fresh list rather than trusting the optimistic row IDs.
+      const readback = scope === 'routing' ? await api.rules() : await api.dnsRules();
+      const actual = 'rules' in readback ? readback.rules : readback[scope === 'request' ? 'request' : 'response'];
+      const expected = next.filter(row => !fallback(row)).map(row => row.identity ?? rowText(row));
+      const confirmed = actual.filter(row => row.kind !== 'fallback').map(row => row.expression);
+      setPreview(null);
+      onReordered?.();
+      retry();
+      if (readback.generation_id !== result.generation_id) {
+        toast('negative', t('rule.orderChangedAgain'));
+        return;
+      }
+      if (expected.length !== confirmed.length || expected.some((text, index) => text !== confirmed[index])) {
+        toast('negative', t('rule.orderNotConfirmed'));
+        return;
+      }
+      toast('positive', t('rule.orderDone'));
+    } catch (error) {
+      setPreview(null);
+      retry();
+      toastFailure(error, t, t(committed ? 'rule.orderWrittenUnconfirmed' : 'rule.orderFailed'));
+    } finally {
+      pending.current = false;
+      setSaving(false);
+    }
+  };
+  // Native WebView drops may arrive as inserts instead of internal reorders.
+  // Accept only this table's generation-stamped payload, and use the same save path.
+  const insert = async (items: Array<{kind: string; types?: Set<string>; getText?: (type: string) => Promise<string>}>, target: string, after: boolean) => {
+    const keys = new Set<string>();
+    for (const item of items) {
+      if (item.kind !== 'text' || !item.types?.has(dragType) || !item.getText) return;
+      try {
+        const value: unknown = JSON.parse(await item.getText(dragType));
+        if (
+          !value ||
+          typeof value !== 'object' ||
+          !('owner' in value) ||
+          value.owner !== owner ||
+          !('generation' in value) ||
+          value.generation !== generation ||
+          !('id' in value) ||
+          typeof value.id !== 'string'
+        )
+          return;
+        keys.add(value.id);
+      } catch {
+        return;
+      }
+    }
+    if (keys.size) await reorder(keys, target, after, generation);
+  };
+  // RAC calls these hooks inside its table and rows. Always keep both sets installed;
+  // removing them while saving changes RAC's hook order (#311). Disable via state instead.
+  const {dragAndDropHooks} = useDragAndDrop({
+    isDisabled: disabled,
+    getItems: keys =>
+      [...keys].flatMap(id => {
+        const row = rows.find(row => row.id === id);
+        if (!row || !movable(row)) return [];
+        return [{[dragType]: JSON.stringify({owner, generation, id: row.id}), 'text/plain': rowText(row)}];
+      }),
+    acceptedDragTypes: [dragType],
+    getAllowedDropOperations: () => ['move'],
+    getDropOperation: target => {
+      if (disabled || target.type !== 'item' || target.dropPosition === 'on') return 'cancel';
+      const row = rows.find(row => row.id === target.key);
+      return row && (movable(row) || (fallback(row) && target.dropPosition === 'before')) ? 'move' : 'cancel';
+    },
+    onDragStart: () => {
+      drag.current = {generation};
+    },
+    onReorder: event => {
+      void reorder(event.keys, String(event.target.key), event.target.dropPosition === 'after');
+    },
+    onInsert: event => insert(event.items, String(event.target.key), event.target.dropPosition === 'after'),
+    renderDropIndicator: target => <TableDropIndicator target={target} />
+  });
+  // Block native dragging of protected rows without disabling their edit/source controls.
+  const tableHooks = {
+    ...dragAndDropHooks,
+    useDraggableItem: (props, state) => {
+      const item = dragAndDropHooks.useDraggableItem!(props, state);
+      const row = rows.find(row => row.id === props.key);
+      const allowed = !disabled && !!row && movable(row);
+      return allowed
+        ? item
+        : {
+            ...item,
+            dragProps: {...item.dragProps, draggable: false, onDragStart: event => event.preventDefault()},
+            dragButtonProps: {...item.dragButtonProps, isDisabled: true}
+          };
+    }
+  } satisfies typeof dragAndDropHooks;
+  return {
+    available,
+    busy,
+    disabled,
+    rows: displayed,
+    dragAndDropHooks: tableHooks,
+    reset,
+    problem,
+    stale,
+    canDrag: (row: Row) => !disabled && movable(row),
+    resetDisabled: !available || busy || blocked || !generation,
+    close,
+    openReset,
+    saveReset,
+    reload: () => {
+      retry();
+      setReset(null);
+    },
+    scope,
+    status:
+      waiting || saving
+        ? t('rule.orderSaving')
+        : available && rows.filter(movable).length > 1
+          ? t(hotApply ? 'rule.orderHotInlineHelp' : 'rule.orderInlineHelp')
+          : null
+  };
+}
+
+type Management = ReturnType<typeof useRuleManagement>;
+export function RuleDragHandle({row, disabled}: {row: Row; disabled: boolean}) {
+  const t = useT();
+  return <TableDragHandle label={t('rule.drag')} isDisabled={disabled || !movable(row)} />;
+}
+export function RuleReset({management: m}: {management: Management}) {
+  const t = useT();
+  if (!m.available) return null;
+  return (
+    <>
+      <Button onPress={() => void m.openReset()} isDisabled={m.resetDisabled}>
+        {t('rule.reset')}
+      </Button>
+      <ModalDialog
+        isOpen={m.reset !== null}
+        title={t('rule.resetTitle')}
+        scrollBody
+        locked={m.busy}
+        onOpenChange={open => {
+          if (!open) m.close();
+        }}
+        footer={() => (
+          <>
+            <Button isDisabled={m.busy} onPress={m.close}>
+              {t('ui.cancel')}
+            </Button>
+            <Button negative isPending={m.busy} isDisabled={m.busy || m.stale} onPress={() => void m.saveReset()}>
+              {t('rule.resetConfirm')}
+            </Button>
+          </>
+        )}
+      >
+        <div className="rp-list">
+          <p className="rp-note">{t(m.scope === 'routing' ? 'rule.resetRoutingHelp' : 'rule.resetDnsHelp')}</p>
+          {m.problem && <InlineAlert tone="negative">{m.problem}</InlineAlert>}
+          {m.stale && <Button onPress={m.reload}>{t('rule.reloadBeforeManage')}</Button>}
+          {m.reset &&
+            (m.reset.defaults.length ? (
+              m.reset.defaults.map((text, index) => <DaeCode key={index} text={text} />)
+            ) : (
+              <span className="rp-label">{t('rule.defaultNoUpstream')}</span>
+            ))}
+        </div>
+      </ModalDialog>
+    </>
+  );
+}
