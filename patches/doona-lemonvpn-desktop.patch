diff --git a/src/store/desktop.ts b/src/store/desktop.ts
new file mode 100644
index 00000000..de6c0fce
--- /dev/null
+++ b/src/store/desktop.ts
@@ -0,0 +1,38 @@
+import {getApi} from '../api';
+import type {Capabilities} from '../api/model';
+import type {DesktopStatus} from '../api/api';
+import {hasDesktop, invokeDesktop} from '../desktop';
+import {useResource} from './resource';
+export type DesktopProxyStatus = {enabled: boolean; server: string | null; error: string | null; supported?: boolean; scope?: string};
+
+export function useDesktopStatus(resources: Capabilities['resources'] | undefined) {
+  const api = getApi();
+  const supported = (resources as Record<string, unknown> | undefined)?.desktop as {available?: boolean} | undefined;
+  const enabled = hasDesktop && supported?.available === true && !!api.desktopStatus;
+  const status = useResource<DesktopStatus>({key: ['desktopStatus'], fetch: signal => api.desktopStatus!(signal)}, {enabled});
+  const proxy = useResource<DesktopProxyStatus>(
+    {
+      key: ['desktopProxy'],
+      followEvents: false,
+      fetch: () => invokeDesktop<DesktopProxyStatus>('proxy_status')
+    },
+    {enabled}
+  );
+  return {status, proxy, enabled};
+}
+
+// TUN is reported under `resources` as a LemonVPN extension; the native API contract has no key for it, so the
+// capability is read through a narrow shape instead of widening the contract.
+export type TunCapability = {available?: boolean; enabled?: boolean; udp?: string};
+
+export function tunCapability(resources: Capabilities['resources'] | undefined): TunCapability | undefined {
+  return (resources as Record<string, unknown> | undefined)?.tun as TunCapability | undefined;
+}
+
+export function tunAvailable(resources: Capabilities['resources'] | undefined): boolean {
+  return tunCapability(resources)?.available === true;
+}
+
+export function dnsSettingsAvailable(resources: unknown): boolean {
+  return hasDesktop && (resources as Record<string, {available?: boolean}> | undefined)?.['x-dns-settings']?.available === true;
+}
