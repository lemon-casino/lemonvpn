diff --git a/src/features/overview/desktopView.test.ts b/src/features/overview/desktopView.test.ts
new file mode 100644
index 00000000..3850fa9a
--- /dev/null
+++ b/src/features/overview/desktopView.test.ts
@@ -0,0 +1,35 @@
+import {expect, it} from 'vitest';
+import type {DesktopStatus} from '../../api/api';
+import {translate} from '../../i18n';
+import {desktopDatapathFields, desktopMemoryFields} from './desktopView';
+
+const t = translate.bind(null, 'en');
+const status: DesktopStatus = {
+  observed_at: '2026-11-06T00:00:00Z',
+  mixed: {address: '127.0.0.1:18080', protocols: ['HTTP', 'SOCKS5']},
+  tun: {enabled: false},
+  memory: {
+    process: {rss_bytes: '8388608', peak_rss_bytes: '16777216', private_bytes: '0'},
+    system: {total_bytes: '17179869184', available_bytes: null, used_percent: 50}
+  }
+};
+
+it('shows measured memory including zero, omits unsupported metrics and keeps system usage separate', () => {
+  const fields = desktopMemoryFields(status, t, 'en');
+  const labels = fields.map(item => (Array.isArray(item) ? item[0] : item.label));
+  expect(labels).toEqual(['Engine resident memory', 'Peak resident memory', 'Private committed memory', 'System physical memory', 'System memory usage']);
+  expect(fields[2]).toEqual(['Private committed memory', '0 B']);
+  expect(fields.at(-1)).toMatchObject({value: '50%', meter: {value: 50}});
+  expect(JSON.stringify(fields)).not.toMatch(/cgroup|OOM/);
+});
+
+it('distinguishes a running TUN, system proxy, manual proxy and unreadable proxy state', () => {
+  const proxy = {enabled: true, server: '127.0.0.1:18080', error: null};
+  expect(desktopDatapathFields(status, proxy, t)[0]).toEqual(['Traffic mode', 'System proxy']);
+  expect(desktopDatapathFields(status, {...proxy, enabled: false}, t)[0]).toEqual(['Traffic mode', 'Manual proxy']);
+  expect(desktopDatapathFields(status, {...proxy, server: '127.0.0.1:19090'}, t)[0]).toEqual(['Traffic mode', 'Manual proxy']);
+  expect(desktopDatapathFields(status, undefined, t)[0]).toEqual(['Traffic mode', '—']);
+  const tun = {...status, tun: {enabled: true, adapter: 'LemonVPN', host_address: '10.111.0.2'}};
+  expect(desktopDatapathFields(tun, proxy, t)).toContainEqual(['Adapter address', '10.111.0.2']);
+  expect(desktopDatapathFields(tun, proxy, t)[0]).toEqual(['Traffic mode', 'TUN mode']);
+});
diff --git a/src/features/overview/desktopView.ts b/src/features/overview/desktopView.ts
new file mode 100644
index 00000000..f16e928f
--- /dev/null
+++ b/src/features/overview/desktopView.ts
@@ -0,0 +1,57 @@
+import type {DesktopStatus} from '../../api/api';
+import type {Translator} from '../../i18n';
+import {formatBytes} from '../../i18n/format';
+import type {KvItem} from '../../ui/ui';
+
+import type {DesktopProxyStatus} from '../../store/desktop';
+export type {DesktopProxyStatus} from '../../store/desktop';
+
+export function desktopMemoryFields(status: DesktopStatus, t: Translator, locale: string): KvItem[] {
+  const {process, system} = status.memory;
+  const rows = [
+    [t('desktop.engineMemory'), process.rss_bytes],
+    [t('desktop.peakMemory'), process.peak_rss_bytes],
+    [t('desktop.privateMemory'), process.private_bytes],
+    [t('desktop.systemMemory'), system.total_bytes],
+    [t('desktop.availableMemory'), system.available_bytes]
+  ];
+  return [
+    ...rows.flatMap(([label, value]): KvItem[] => (value === null ? [] : [[label!, formatBytes(value, locale)]])),
+    ...(system.used_percent === null
+      ? []
+      : [
+          {
+            label: t('desktop.memoryUsage'),
+            value: `${new Intl.NumberFormat(locale).format(system.used_percent)}%`,
+            meter: {value: system.used_percent, tone: system.used_percent >= 90 ? ('err' as const) : ('ok' as const)}
+          }
+        ])
+  ];
+}
+
+export function desktopDatapathFields(status: DesktopStatus, proxy: DesktopProxyStatus | undefined, t: Translator): KvItem[] {
+  const systemProxyOn = proxy?.enabled === true && proxy.server === status.mixed.address;
+  const mode = status.tun.enabled ? t('desktop.modeTun') : !proxy || proxy.error ? '—' : t(systemProxyOn ? 'desktop.modeSystem' : 'desktop.modeManual');
+  return [
+    [t('desktop.mode'), mode],
+    [t('desktop.mixed'), status.mixed.address ?? '—'],
+    [t('desktop.systemProxy'), !proxy ? '—' : proxy.error ? t('ov.unavailable') : t(systemProxyOn ? 'desktop.enabled' : 'desktop.disabled')],
+    [t('desktop.tun'), status.tun.supported === false ? t('ov.unavailable') : t(status.tun.enabled ? 'desktop.enabled' : 'desktop.disabled')],
+    ...(status.tun.enabled
+      ? ([
+          [t('desktop.adapter'), status.tun.adapter ?? '—'],
+          [t('desktop.tunAddress'), status.tun.host_address ?? status.tun.address ?? '—']
+        ] as KvItem[])
+      : []),
+    [
+      t('desktop.protocols'),
+      status.tun.enabled
