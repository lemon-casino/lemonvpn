+        t('config.moduleDnsRequests', {n: number(dns.data?.request.filter(row => row.kind !== 'fallback').length)}),
+        t('config.moduleDnsResponses', {n: number(dns.data?.response.filter(row => row.kind !== 'fallback').length)})
+      ].join(t('ui.listSeparator')),
+      error: dns.error,
+      retry: dns.refetch,
+      actions: [
+        {label: t('dns.upstreamsTitle'), href: href('dns', {tab: 'upstreams'})},
+        ...(dnsSettingsAvailable(caps) ? [{label: t('dns.fakeIpTitle'), href: href('dns', {tab: 'fakeip'})}] : []),
+        {label: t('rule.dnsTitle'), href: href('rules', {tab: 'dns'})},
+        {label: t('dns.query'), href: href('dns', {tab: 'query'})}
+      ]
+    },
+    {
+      id: 'routing',
+      title: t('rule.listTitle'),
+      summary: t('config.moduleRules', {n: number(rules.data?.rules.filter(row => row.kind !== 'fallback').length)}),
+      error: rules.error,
+      retry: rules.refetch,
+      actions: [
+        {label: t('config.moduleManage'), href: href('rules', {tab: 'list'})},
+        {label: t('rule.trace'), href: href('rules', {tab: 'trace'})}
+      ]
+    },
+    {
+      id: 'recording',
+      title: t('config.recordingModule'),
+      summary: t('config.recordingModuleHelp'),
+      actions: [
+        {label: t('nav.logs'), href: href('logs')},
+        {label: t('nav.events'), href: href('events')},
+        {label: t('nav.settings'), href: href('settings', {card: 'runtime'})}
+      ]
+    }
+  ];
+  return (
+    <div className="rp-page">
+      <p className="rp-note">{t('config.desktopModulesHelp')}</p>
+      {cards.map(card => (
+        <Card key={card.id} title={card.title}>
+          <span className="rp-label">{card.summary}</span>
+          <ErrorMessage error={card.error} onRetry={card.retry} />
+          <div className="rp-cluster">
+            {card.actions.map(action => (
+              <Link key={action.href} appearance="button" href={action.href}>
+                {action.label}
+              </Link>
+            ))}
+          </div>
+        </Card>
+      ))}
+    </div>
+  );
+}
