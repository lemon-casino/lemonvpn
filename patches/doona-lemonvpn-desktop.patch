@@ -0,0 +1,90 @@
+import {useEffect, useState, type MouseEvent} from 'react';
+import {framelessDesktop, invokeDesktop} from '../desktop';
+import {useT} from '../i18n';
+import {Button, toast} from '../ui/ui';
+import IconSvg from '../ui/icons/IconSvg';
+import '../ui/styles/desktop-window.css';
+
+const act = (action: string) => invokeDesktop<boolean>('window_action', {action});
+const draggable = (event: MouseEvent<HTMLElement>) =>
+  framelessDesktop &&
+  event.target instanceof Element &&
+  !event.target.closest('a, button, input, textarea, select, [contenteditable], [role="button"], [data-window-controls]');
+
+export const titlebarDrag = {
+  onMouseDown: (event: MouseEvent<HTMLElement>) => {
+    if (event.button === 0 && event.detail < 2 && draggable(event)) {
+      event.preventDefault();
+      void act('start_dragging').catch(console.error);
+    }
+  },
+  onDoubleClick: (event: MouseEvent<HTMLElement>) => {
+    if (event.button === 0 && draggable(event)) {
+      event.preventDefault();
+      void act('toggle_maximize').catch(console.error);
+    }
+  }
+};
+
+export function WindowControls() {
+  const t = useT();
+  const [maximized, setMaximized] = useState(false);
+  useEffect(() => {
+    if (!framelessDesktop) return;
+    let mounted = true;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const refresh = () =>
+      void act('state')
+        .then(value => {
+          if (mounted) setMaximized(value);
+        })
+        .catch(console.error);
+    const schedule = () => {
+      clearTimeout(timer);
+      timer = setTimeout(refresh, 80);
+    };
+    refresh();
+    window.addEventListener('resize', schedule);
+    return () => {
+      mounted = false;
+      clearTimeout(timer);
+      window.removeEventListener('resize', schedule);
+    };
+  }, []);
+  if (!framelessDesktop) return null;
+  const run = (action: string) =>
+    void act(action)
+      .then(setMaximized)
+      .catch(error => {
+        toast('negative', t('desktop.windowError'), {detail: error instanceof Error ? error.message : String(error)});
+      });
+  return (
+    <div className="rp-window-controls" data-window-controls role="group" aria-label={t('desktop.windowControls')}>
+      <Button quiet icon label={t('desktop.windowMinimize')} tip={t('desktop.windowMinimize')} onPress={() => run('minimize')}>
+        <IconSvg>
+          <path d="M5 10h10" fill="none" stroke="currentColor" strokeWidth={1.4} />
+        </IconSvg>
+      </Button>
+      <Button
+        quiet
+        icon
+        label={t(maximized ? 'desktop.windowRestore' : 'desktop.windowMaximize')}
+        tip={t(maximized ? 'desktop.windowRestore' : 'desktop.windowMaximize')}
+        onPress={() => run('toggle_maximize')}
+      >
+        <IconSvg>
+          {maximized ? (
+            <path d="M7 4h9v9M4 7h9v9H4Z" fill="none" stroke="currentColor" strokeWidth={1.4} />
+          ) : (
+            <rect x={5} y={5} width={10} height={10} fill="none" stroke="currentColor" strokeWidth={1.4} />
+          )}
+        </IconSvg>
+      </Button>
+      <Button quiet icon className="rp-window-close" label={t('desktop.windowClose')} tip={t('desktop.windowClose')} onPress={() => run('close')}>
+        <IconSvg>
+          <path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" strokeWidth={1.4} />
+        </IconSvg>
+      </Button>
+    </div>
+  );
+}
