+.rp-proxy-path strong .rp-truncate {
+  white-space: normal;
+  overflow-wrap: anywhere;
+}
+.rp-proxy-step-label {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  color: var(--rp-subtle-text);
+  font-size: var(--rp-text-xs);
+}
+.rp-proxy-step-number {
+  display: grid;
+  place-items: center;
+  inline-size: 21px;
+  block-size: 21px;
+  flex: none;
+  border-radius: 50%;
+  background: var(--rp-fill);
+  font-variant-numeric: tabular-nums;
+}
+.rp-proxy-edge {
+  position: absolute;
+  inset-inline-start: calc(100% + 4px);
+  inset-block-start: calc(50% - 10px);
+  inline-size: 20px;
+  color: var(--rp-accent-text);
+  text-align: center;
+}
+.rp-proxy-edge > span {
+  position: absolute;
+  inline-size: 5px;
+  block-size: 5px;
+  border-radius: 50%;
+  background: var(--rp-accent);
+  inset-block-start: 9px;
+  inset-inline-start: 0;
+  opacity: 0;
+}
+.rp-proxy-path.compact {
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 22px;
+}
+.rp-proxy-path.compact > li {
+  padding: 11px;
+}
+.rp-proxy-path.compact .rp-proxy-edge {
+  inline-size: 16px;
+}
+.rp-proxy-inspector-section {
+  display: grid;
+  gap: var(--rp-space-4);
+  padding-block: var(--rp-space-4);
+}
+.rp-proxy-inspector-section + .rp-proxy-inspector-section {
+  border-block-start: 1px solid var(--rp-line);
+}
+.rp-proxy-samples {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--rp-space-2);
+}
+.rp-proxy-path[data-long] {
+  grid-template-columns: 1fr;
+}
+.rp-proxy-path[data-long] .rp-proxy-edge {
+  inset-inline-start: calc(50% - 10px);
+  inset-block-start: calc(100% + 1px);
+  transform: rotate(90deg);
+}
+@container (max-width: 600px) {
+  .rp-proxy-path,
+  .rp-proxy-path.compact {
+    grid-template-columns: 1fr;
+  }
+  .rp-proxy-edge,
+  .rp-proxy-path.compact .rp-proxy-edge {
+    inset-inline-start: calc(50% - 10px);
+    inset-block-start: calc(100% + 1px);
+    transform: rotate(90deg);
+  }
+}
+.rp-proxy-path-frame {
+  container-type: inline-size;
+  min-inline-size: 0;
+}
