@@ -0,0 +1,125 @@
+import {useEffect, useState} from 'react';
+import {useT} from '../../i18n';
+import {ApiError} from '../../api/error';
+import {Button, Card, ErrorMessage, InlineAlert, Switch, Toolbar} from '../../ui/ui';
+import {useCapabilities, useTun} from '../../store';
+import {hasDesktop, invokeDesktop} from '../../shell/desktop';
+import {desktop} from '../../desktop';
+import {settingsCard} from './nav';
+import {tunAvailable} from './tun';
+
+const card = settingsCard('tun');
+type ServiceStatus = {service_installed: boolean; service_update_required: boolean};
+// The service install/repair flow drives the privileged TUN broker all
+// desktop platforms ship: a Windows SCM service, a macOS LaunchDaemon and
+// a Linux systemd unit.
+const desktopService = hasDesktop && (desktop?.platform === 'windows' || desktop?.platform === 'macos' || desktop?.platform === 'linux');
+
+// The TUN switch is a desktop-only extension: the card disappears when the engine reports no TUN capability. Turning
+// it on uses the privileged desktop TUN service, installed on demand without restarting the shell.
+export function TunSettingsCard() {
+  const t = useT();
+  const caps = useCapabilities();
+  const available = tunAvailable(caps.data?.resources);
+  const tun = useTun(available);
+  const [actionError, setActionError] = useState<Error | null>(null);
+  const [restarting, setRestarting] = useState(false);
+  const [service, setService] = useState<ServiceStatus>();
+  useEffect(() => {
+    if (desktopService)
+      void invokeDesktop<ServiceStatus>('windows_integration_status')
+        .then(setService)
+        .catch(() => undefined);
+  }, []);
+  if (!available) return null;
+
+  const status = tun.data;
+  const toggle = async (enabled: boolean) => {
+    setActionError(null);
+    try {
+      await tun.set(enabled);
+    } catch (error) {
+      setActionError(error instanceof Error ? error : new Error(String(error)));
+    }
+  };
+  const repair = async (enableAfter = false) => {
+    setActionError(null);
+    setRestarting(true);
+    try {
+      setService(await invokeDesktop<ServiceStatus>('windows_service_install'));
+      if (enableAfter) await tun.set(true);
+      tun.refetch();
+      setRestarting(false);
+    } catch (error) {
+      setActionError(error instanceof Error ? error : new Error(String(error)));
+      setRestarting(false);
+    }
+  };
+  const admin = actionError instanceof ApiError && actionError.code === 'admin_required';
+  const remove = async () => {
+    setActionError(null);
+    setRestarting(true);
+    try {
+      setService(await invokeDesktop<ServiceStatus>('windows_service_remove'));
+      tun.refetch();
+    } catch (error) {
+      setActionError(error instanceof Error ? error : new Error(String(error)));
+    } finally {
+      setRestarting(false);
+    }
+  };
+  return (
+    <Card level={2} title={t(card.titleKey)} titleId={card.headingId}>
+      <span className="rp-label">{t('settings.tunHelp')}</span>
+      <ErrorMessage error={tun.error} onRetry={tun.refetch} />
+      <ErrorMessage error={actionError} />
+      {status?.recovering && <InlineAlert>{status.recovering}</InlineAlert>}
+      <Toolbar>
+        <div className="rp-contents">
+          <Switch
+            isSelected={status?.enabled === true}
+            isDisabled={tun.busy || tun.loading || restarting}
+            onChange={enabled => void toggle(enabled)}
+            description={status ? (status.enabled ? t('settings.tunOn') : t('settings.tunOff')) : undefined}
+          >
+            {t('settings.tunEnable')}
+          </Switch>
+        </div>
+        {status?.enabled && (
+          <span className="rp-label">
+            {t('settings.tunAdapter', {
+              adapter: status.adapter ?? '',
+              address: status.address ?? '',
+              udp: status.udp === 'full' ? t('desktop.tunUdpFull') : status.udp === 'dns_only' ? t('settings.tunUdpDnsOnly') : (status.udp ?? '')
+            })}
+          </span>
+        )}
+      </Toolbar>
+      {desktopService && (
+        <div className="rp-tun-service">
+          <Toolbar>
+            <span className="rp-label">
+              {t(
+                service?.service_update_required
+                  ? 'desktop.serviceUpdateRequired'
+                  : service?.service_installed
+                    ? 'desktop.serviceInstalled'
+                    : 'desktop.serviceMissing'
+              )}
+            </span>
+            <Button isPending={restarting} isDisabled={tun.busy || status?.enabled === true} onPress={() => void repair(admin)}>
+              {t(service?.service_installed ? 'desktop.serviceRepair' : 'desktop.serviceInstall')}
+            </Button>
+            {service?.service_installed && (
+              <Button quiet isDisabled={restarting || tun.busy || status?.enabled === true} onPress={() => void remove()}>
+                {t('desktop.serviceRemove')}
+              </Button>
+            )}
+          </Toolbar>
+          <p className="rp-note">{t('desktop.serviceHelp')}</p>
+        </div>
+      )}
+      {admin && <InlineAlert>{desktopService ? t('desktop.serviceHelp') : t('settings.tunDesktopHelp')}</InlineAlert>}
+    </Card>
+  );
+}
