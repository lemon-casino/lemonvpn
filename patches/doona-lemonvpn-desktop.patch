+  .rp-desktop-nav-section {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 4px 6px;
+  }
+  .rp-desktop-nav-section > .rp-desktop-nav-label {
+    grid-column: 1 / -1;
