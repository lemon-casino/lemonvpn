diff --git a/src/features/dns/FakeIpSettings.tsx b/src/features/dns/FakeIpSettings.tsx
new file mode 100644
index 00000000..3e4469d9
--- /dev/null
+++ b/src/features/dns/FakeIpSettings.tsx
@@ -0,0 +1,170 @@
+import {useState} from 'react';
+import {getApi} from '../../api';
+import type {DnsSettings, DnsSettingsStatus} from '../../api/api';
+import {ipLiteral} from '../../api/selectors';
+import {dnsSettingsAvailable} from '../../store/desktop';
+import {useT} from '../../i18n';
+import {useCapabilities} from '../../store';
+import {useResource} from '../../store/resource';
+import {useAction} from '../../store/action';
+import {useDraftGuard} from '../../shell/draft';
+import {Badge, Button, Card, Empty, ErrorMessage, Form, InlineAlert, LabeledSelect, Link, Switch, TextField, Toolbar, toast} from '../../ui/ui';
+import {href} from '../../shell/route';
+import {TextArea} from '../../ui/TextArea';
+import '../../ui/styles/fakeip-settings.css';
+
+type Draft = {revision: string; settings: DnsSettings; filters: string};
+const defaults: DnsSettings = {mode: 'fake-ip', ipv4_range: '198.18.0.1/16', ipv6_range: 'fc00::/18', filters: [], store_fake_ip: false};
+function rangeValid(text: string, ipv6: boolean): boolean {
+  if (ipv6 && !text.trim()) return true;
+  const match = /^([^/]+)\/(\d+)$/.exec(text.trim());
+  if (!match) return false;
+  const ip = ipLiteral(match[1]);
+  return !!ip && ip.includes(':') === ipv6 && Number(match[2]) >= 8 && Number(match[2]) <= (ipv6 ? 125 : 29);
+}
+export function FakeIpSettings() {
+  const t = useT();
+  const api = getApi();
+  const capabilities = useCapabilities();
+  const enabled = dnsSettingsAvailable(capabilities.data?.resources) && !!api.dnsSettings;
+  const resource = useResource({key: ['dnsSettings'], fetch: signal => api.dnsSettings!(signal)}, {enabled});
+  const action = useAction<'save'>({shared: 'dns-settings'});
+  const [draft, setDraft] = useState<Draft | null>(null);
+  const [written, setWritten] = useState<DnsSettingsStatus | null>(null);
+  const [lastRead, setLastRead] = useState(resource.data);
+  if (lastRead !== resource.data) {
+    setLastRead(resource.data);
+    setWritten(null);
+  }
+  const data = written ?? resource.data;
+  const filters = draft
+    ? draft.filters
+        .split(/\r?\n/)
+        .map(line => line.trim())
+        .filter(Boolean)
+    : (data?.settings.filters ?? []);
+  const settings = draft ? {...draft.settings, filters} : data?.settings;
+  const dirty =
+    !!settings &&
+    !!data &&
+    JSON.stringify([settings.mode, settings.ipv4_range, settings.ipv6_range, settings.filters, settings.store_fake_ip]) !==
+      JSON.stringify([data.settings.mode, data.settings.ipv4_range, data.settings.ipv6_range, data.settings.filters, data.settings.store_fake_ip]);
+  const stale = !!draft && !!data && draft.revision !== data.revision;
+  const guard = useDraftGuard(dirty, () => setDraft(null), 'dns.fakeIpTitle');
+  const busy = !!action.busy;
+  const edit = (value: Partial<DnsSettings>, text?: string) => {
+    if (!data || !settings) return;
+    setDraft({
+      revision: draft?.revision ?? data.revision,
+      settings: {...settings, ...value},
+      filters: text ?? draft?.filters ?? data.settings.filters.join('\n')
+    });
+  };
+  const save = async () => {
+    if (!data || !settings || !api.setDnsSettings) return;
+    if (busy || !dirty || stale || !rangeValid(settings.ipv4_range, false) || !rangeValid(settings.ipv6_range, true) || filters.length > 256) return;
+    const result = await action.run('save', signal => api.setDnsSettings!(draft?.revision ?? data.revision, settings, signal));
+    if (result) {
+      setWritten(result);
+      setDraft(null);
+      guard.clear();
+      resource.refetch();
+      toast('positive', t(result.tun_enabled ? 'dns.fakeIpApplied' : 'dns.fakeIpSaved'));
+    }
+  };
+  if (!enabled) return null;
+  const v4error = settings && !rangeValid(settings.ipv4_range, false) ? t('dns.fakeIpRange4Error') : undefined;
+  const v6error = settings && !rangeValid(settings.ipv6_range, true) ? t('dns.fakeIpRange6Error') : undefined;
+  const filterError = filters.length > 256 ? t('dns.fakeIpFilterError') : undefined;
+  return (
+    <Card title={t('dns.fakeIpTitle')} note={t('dns.fakeIpScope')}>
+      <ErrorMessage error={resource.error ?? action.error} onRetry={resource.refetch} />
+      {!settings || !data ? (
+        <Empty>{t('ui.loading')}</Empty>
+      ) : (
+        <Form
+          className="rp-fakeip-form"
+          onSubmit={event => {
+            event.preventDefault();
+            void save();
+          }}
+        >
+          <Toolbar>
+            <Badge>{data.settings.mode}</Badge>
+            <span className="rp-note">{t(data.tun_enabled ? 'dns.fakeIpActive' : 'dns.fakeIpInactive')}</span>
+            <span className="rp-grow" />
+            <Link href={href('settings', {card: 'tun'})}>{t('dns.fakeIpTunSettings')}</Link>
+          </Toolbar>
+          <p className="rp-note">{t('dns.fakeIpRealHelp')}</p>
+          <div className="rp-fakeip-grid">
+            <LabeledSelect
+              label={t('dns.fakeIpMode')}
+              value={settings.mode}
+              isDisabled={busy}
+              onChange={mode => edit({mode: mode as DnsSettings['mode']})}
+              items={[
+                {id: 'fake-ip', label: t('dns.fakeIpModeFake')},
+                {id: 'redir-host', label: t('dns.fakeIpModeReal')}
+              ]}
+            />
+            <Switch
+              isSelected={settings.store_fake_ip}
+              isDisabled={busy}
+              onChange={store_fake_ip => edit({store_fake_ip})}
+              description={t('dns.fakeIpPersistenceHelp')}
+            >
+              {t('dns.fakeIpPersistence')}
+            </Switch>
+            <TextField
+              label={t('dns.fakeIpRange4')}
+              value={settings.ipv4_range}
+              isDisabled={busy}
+              onChange={ipv4_range => edit({ipv4_range})}
+              placeholder="198.18.0.1/16"
+              error={v4error}
+            />
+            <TextField
+              label={t('dns.fakeIpRange6')}
+              value={settings.ipv6_range}
+              isDisabled={busy}
+              onChange={ipv6_range => edit({ipv6_range})}
+              placeholder="fc00::/18"
+              error={v6error}
+              description={t('dns.fakeIpRange6Help')}
+            />
+          </div>
+          <TextArea
+            label={t('dns.fakeIpFilters')}
+            value={draft?.filters ?? filters.join('\n')}
+            isDisabled={busy}
+            onChange={text => edit({}, text)}
+            placeholder={'*.lan\n+.example.com'}
+            error={filterError}
+            description={t('dns.fakeIpFiltersHelp')}
+          />
+          {stale && <InlineAlert>{t('dns.fakeIpConflict')}</InlineAlert>}
+          <p className="rp-note">{t('dns.fakeIpHotHelp')}</p>
+          <Toolbar>
+            <Button accent type="submit" isPending={busy} isDisabled={!dirty || stale || !!v4error || !!v6error || !!filterError}>
+              {t('dns.fakeIpApply')}
+            </Button>
+            <Button isDisabled={busy} onPress={() => setDraft({revision: data.revision, settings: {...defaults}, filters: ''})}>
+              {t('dns.fakeIpDefaults')}
+            </Button>
+            <Button
+              quiet
+              isDisabled={busy || !draft}
+              onPress={() => {
+                setDraft(null);
+                guard.clear();
+                resource.refetch();
+              }}
+            >
+              {t('dns.fakeIpDiscard')}
+            </Button>
+          </Toolbar>
+        </Form>
+      )}
+    </Card>
+  );
+}
