+import {useT} from '../../i18n';
+import {NodeName} from '../../ui/NodeName';
+
+export type ProxyPathHop = {name: string; protocol?: string; role: 'front' | 'exit'};
+
+// Static configuration/connection path. Animated traffic belongs to Activity.
+export function ChainDiagram({hops, target, compact}: {hops: ProxyPathHop[]; target?: string; compact?: boolean}) {
+  const t = useT();
+  const steps = [{name: 'LemonVPN', role: 'local'}, ...hops, {name: target || t('chain.requestTarget'), role: 'target'}];
+  return (
+    <div className="rp-proxy-path-frame">
+      <ol className={`rp-proxy-path${compact ? ' compact' : ''}`} aria-label={t('chain.direction')} data-long={steps.length > 4 ? '' : undefined}>
+        {steps.map((step, index) => (
+          <li key={`${index}:${step.name}`} data-role={step.role}>
+            <span className="rp-proxy-step-label">
+              <span className="rp-proxy-step-number">{index + 1}</span>
+              {t(step.role === 'front' ? 'chain.front' : step.role === 'exit' ? 'chain.exit' : step.role === 'local' ? 'chain.local' : 'chain.target')}
+            </span>
+            <strong>{step.role === 'front' || step.role === 'exit' ? <NodeName name={step.name} /> : step.name}</strong>
+            {'protocol' in step && step.protocol && <span className="rp-note">{step.protocol}</span>}
+            {index < steps.length - 1 && (
+              <span className="rp-proxy-edge" aria-hidden="true">
+                <span />→
+              </span>
+            )}
+          </li>
+        ))}
+      </ol>
+    </div>
+  );
+}
