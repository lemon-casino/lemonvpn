diff --git a/src/features/nodes/importLinks.ts b/src/features/nodes/importLinks.ts
new file mode 100644
index 00000000..d92c4981
--- /dev/null
+++ b/src/features/nodes/importLinks.ts
@@ -0,0 +1,111 @@
+import {completeSubscriptionUrl} from '../../dae/subscriptions';
+
+export type ImportLinks = {kind: 'empty' | 'subscription' | 'node' | 'invalid' | 'mixed' | 'subscriptions'; count: number};
+const nodeSchemes = new Set([
+  'ss',
+  'ssr',
+  'vmess',
+  'vless',
+  'trojan',
+  'trojan-go',
+  'socks',
+  'socks5',
+  'hysteria',
+  'hysteria2',
+  'hy2',
+  'tuic',
+  'juicity',
+  'anytls',
+  'snell',
+  'mieru',
+  'wireguard',
+  'wg',
+  'ssh',
+  'mihomo'
+]);
+
+// Classify locally: an HTTP URL is never probed to guess its contents.
+export function detectImportLinks(value: string, schemes?: readonly string[] | null): ImportLinks {
+  const links = value
+    .split(/\r?\n/)
+    .map(line => line.trim())
+    .filter(Boolean);
+  if (!links.length) return {kind: 'empty', count: 0};
+  const kinds = links.map(link => {
+    const scheme = /^([a-z][a-z0-9+.-]*):\/\//i.exec(link)?.[1].toLowerCase();
+    if (scheme && scheme !== 'http' && scheme !== 'https') return nodeSchemes.has(scheme) || schemes?.includes(scheme) ? 'node' : 'invalid';
+    const completed = completeSubscriptionUrl(link);
+    if (/^https?:\/\/\S+$/i.test(completed)) {
+      try {
+        if (['http:', 'https:'].includes(new URL(completed).protocol)) return 'subscription';
+      } catch {}
+    }
+    return 'invalid';
+  });
+  if (kinds.includes('subscription') && kinds.includes('node')) return {kind: 'mixed', count: links.length};
+  // Invalid rows in a node batch remain in its existing preview for correction.
+  if (kinds.includes('node')) return {kind: 'node', count: links.length};
+  if (kinds.every(kind => kind === 'subscription')) return {kind: links.length === 1 ? 'subscription' : 'subscriptions', count: links.length};
+  return {kind: 'invalid', count: links.length};
+}
+
+export function nodeLinkName(link: string): string {
+  try {
+    const name = decodeURIComponent(link.split('#').slice(1).join('#')).trim();
+    if (name) return name;
+  } catch {}
+  if (/^vmess:\/\//i.test(link)) {
+    try {
+      const encoded = link
+        .slice(link.indexOf('://') + 3)
+        .split(/[?#]/, 1)[0]
+        .replace(/-/g, '+')
+        .replace(/_/g, '/');
+      const bytes = Uint8Array.from(atob(encoded.padEnd(Math.ceil(encoded.length / 4) * 4, '=')), character => character.charCodeAt(0));
+      const data: unknown = JSON.parse(new TextDecoder().decode(bytes));
+      if (data && typeof data === 'object' && 'ps' in data && typeof data.ps === 'string' && data.ps.trim()) return data.ps.trim();
+    } catch {}
+  }
+  try {
+    const host = new URL(link).hostname;
+    if (host && !/^vmess:/i.test(link)) return host;
+  } catch {}
+  return link.split(':', 1)[0] || 'node';
+}
+
+// Generated node names fit the native API's 64-byte limit, including a suffix.
+export function uniqueNodeName(base: string, used: Set<string>): string {
+  const encoder = new TextEncoder();
+  const fit = (text: string, maximum: number) => {
+    let result = '',
+      size = 0;
+    for (const character of text) {
+      const bytes = encoder.encode(character).length;
+      if (size + bytes > maximum) break;
+      result += character;
+      size += bytes;
+    }
+    return result;
+  };
+  base = base.replace(/[\u0000-\u001f\u007f]/g, '').trim() || 'node';
+  let name = fit(base, 64).trimEnd();
+  for (let index = 2; used.has(name); index++) {
+    const suffix = `-${index}`;
+    name = fit(base, 64 - suffix.length).trimEnd() + suffix;
+  }
+  return name;
+}
+
+export function subscriptionLinkName(link: string, existing: string[]): string {
+  let base = 'subscription';
+  try {
+    base = new URL(completeSubscriptionUrl(link)).hostname.replace(/[^\p{L}\p{M}\p{N}_.-]/gu, '-').slice(0, 64) || base;
+  } catch {}
+  const used = new Set(existing);
+  let name = base;
+  for (let index = 2; used.has(name); index++) {
+    const suffix = `-${index}`;
+    name = base.slice(0, 64 - suffix.length) + suffix;
+  }
+  return name;
+}
