+  gap: var(--rp-space-3);
+}
+.rp-chain-selection > span {
+  display: grid;
+  gap: 4px;
+  min-inline-size: 0;
+  color: var(--rp-subtle-text);
+  font-size: var(--rp-text-xs);
+}
+.rp-chain-selection strong {
+  min-inline-size: 0;
+  color: var(--rp-accent-text);
+  font-size: var(--rp-text-sm);
+}
+.rp-chain-flow-stats {
+  display: flex;
+  align-items: center;
+  gap: var(--rp-space-4);
+  flex-wrap: wrap;
+  font-variant-numeric: tabular-nums;
+  font-size: var(--rp-text-sm);
+}
+.rp-chain-flow-stats .upload {
+  color: var(--rp-notice-text);
+}
+.rp-chain-flow-stats .download {
+  color: var(--rp-accent-text);
+}
+.rp-chain-topology-frame {
+  container-type: inline-size;
+  min-inline-size: 0;
+}
+.rp-chain-topology {
+  position: relative;
+  isolation: isolate;
+  display: grid;
+  grid-template-columns: minmax(56px, 0.5fr) repeat(var(--rp-chain-hop-count), minmax(0, 1fr)) minmax(78px, 0.9fr);
+  gap: clamp(12px, 2cqw, 28px);
+  align-items: center;
+  padding: 8px 0;
+  min-inline-size: 0;
+}
+.rp-chain-wires {
+  position: absolute;
+  inset: 0;
+  inline-size: 100%;
+  block-size: 100%;
+  overflow: visible;
+  pointer-events: none;
+  z-index: 0;
+}
+.rp-chain-wire {
+  fill: none;
+  stroke: var(--rp-positive);
+  stroke-width: 1.5;
+  stroke-dasharray: 3 5;
+  opacity: 0.38;
+}
+.rp-chain-stream {
+  fill: none;
+  stroke-width: 3;
+  stroke-linecap: round;
+  stroke-dasharray: 2 16;
+  opacity: 0;
+  animation-duration: 1.2s;
+  animation-timing-function: linear;
+  animation-iteration-count: infinite;
+  animation-play-state: paused;
+}
+.rp-chain-stream.upload {
+  stroke: var(--rp-notice);
+  transform: translateY(-2px);
+  animation-name: rp-chain-upload-flow;
+}
+.rp-chain-stream.download {
+  stroke: var(--rp-accent);
+  transform: translateY(2px);
+  animation-name: rp-chain-download-flow;
+}
+.rp-chain-stream[data-active] {
+  opacity: 0.95;
+  animation-play-state: running;
+}
+@keyframes rp-chain-upload-flow {
+  from {
+    stroke-dashoffset: 0;
+  }
+  to {
+    stroke-dashoffset: -36;
+  }
+}
+@keyframes rp-chain-download-flow {
+  from {
+    stroke-dashoffset: 0;
+  }
+  to {
+    stroke-dashoffset: 36;
+  }
+}
+.rp-chain-node {
+  position: relative;
+  z-index: 1;
+  min-inline-size: 0;
+  min-block-size: 112px;
+  border: 1px solid var(--rp-line);
+  border-radius: 12px;
+  padding: 12px;
+  background: var(--rp-surface);
+  box-shadow: 0 3px 12px #00000004;
+  display: grid;
+  align-content: center;
+  gap: 7px;
+}
+.rp-chain-node strong {
+  display: block;
+  min-inline-size: 0;
+  font-size: var(--rp-text-sm);
+  line-height: 1.5;
+  font-weight: 600;
+}
+.rp-chain-node .rp-node-name,
+.rp-chain-node > .rp-truncate,
+.rp-chain-selection .rp-node-name {
+  display: block;
+  min-inline-size: 0;
+  max-inline-size: 100%;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.rp-chain-source {
+  justify-items: center;
+  text-align: center;
+  padding: 12px 6px;
+}
+.rp-chain-source strong {
+  font-size: var(--rp-text-xs);
+}
+.rp-chain-emblem {
+  display: grid;
+  place-items: center;
+  inline-size: 28px;
+  block-size: 28px;
+  border-radius: 9px;
+  background: var(--rp-fill);
+  color: var(--rp-accent-text);
+  font-size: 21px;
+  font-weight: 700;
+}
+.rp-chain-targets {
+  display: grid;
+  gap: 8px;
+  min-inline-size: 0;
+}
+.rp-chain-target {
+  min-block-size: 76px;
+  font-weight: 600;
+  font-size: var(--rp-text-sm);
+}
+.rp-chain-node-caption {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  white-space: nowrap;
+  min-inline-size: 0;
+  color: var(--rp-subtle-text);
+  font-size: var(--rp-text-xs);
+}
+.rp-chain-node-dot {
+  inline-size: 6px;
+  block-size: 6px;
+  border-radius: 50%;
+  background: var(--rp-positive);
+  flex: none;
+}
+.rp-chain-reference,
+.rp-chain-node-protocol {
+  color: var(--rp-subtle-text);
+  font-size: var(--rp-text-2xs);
+}
+.rp-chain-endpoint-control {
+  display: grid;
+  min-inline-size: 0;
+  gap: 4px;
+}
+.rp-chain-endpoint-control > .rp-btn {
+  inline-size: 100%;
+  min-inline-size: 0;
+  max-inline-size: 100%;
+  justify-content: space-between;
+  padding-inline: 0;
+  text-align: start;
+  font-weight: 600;
+}
+.rp-chain-endpoint-control .rp-node-name {
+  flex: 1;
+}
+.rp-chain-target-meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 5px 10px;
+  color: var(--rp-subtle-text);
+  font-weight: 400;
+  font-size: var(--rp-text-2xs);
+  font-variant-numeric: tabular-nums;
+}
+.rp-chain-target[data-traffic] {
+  border-color: color-mix(in srgb, var(--rp-positive) 50%, var(--rp-line));
+}
+.rp-chain-empty {
+  border-style: dashed;
+  box-shadow: none;
+}
+.rp-chain-config-summary {
+  margin: 0;
+  font-size: var(--rp-text-sm);
+  color: var(--rp-subtle-text);
+  overflow-wrap: anywhere;
+}
+.rp-chain-flow-panel[data-compact] {
+  gap: 8px;
+}
+.rp-chain-flow-panel[data-compact] .rp-chain-node {
+  min-block-size: 86px;
+  padding-block: 10px;
+}
+.rp-chain-flow-panel[data-compact] .rp-chain-topology {
+  padding-block: 0;
+}
+.rp-outbound-display {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 10px 16px;
+  min-inline-size: 0;
+}
+.rp-outbound-picker {
+  min-inline-size: 0;
+  max-inline-size: 100%;
+  justify-self: start;
+}
+.rp-outbound-picker .rp-node-name {
+  max-inline-size: min(260px, 40cqw);
+}
+.rp-outbound-picker > .rp-btn {
+  min-inline-size: 0;
+  max-inline-size: 100%;
+}
+.rp-policy-quick-controls {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 10px 14px;
+  min-inline-size: 0;
+}
+.rp-policy-member-picker {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-inline-size: 0;
+  max-inline-size: 100%;
+}
+.rp-policy-member-picker > .rp-btn {
+  min-inline-size: 0;
+  max-inline-size: min(420px, 100%);
+}
+.rp-policy-member-picker .rp-node-name {
+  max-inline-size: 360px;
+}
+@container (max-width:480px) {
+  .rp-chain-topology {
+    grid-template-columns: minmax(32px, 0.35fr) repeat(var(--rp-chain-hop-count), minmax(0, 1fr)) minmax(48px, 0.65fr);
+    gap: 12px;
+  }
+  .rp-chain-node {
+    padding-inline: 7px;
+  }
+  .rp-chain-source strong,
+  .rp-chain-source .rp-note,
+  .rp-chain-node-protocol {
+    display: none;
+  }
+  .rp-chain-node-caption {
+    gap: 3px;
+    font-size: var(--rp-text-2xs);
+  }
+  .rp-chain-node-dot {
+    inline-size: 4px;
+    block-size: 4px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .rp-chain-stream,
+  .rp-chain-stream[data-active] {
+    animation: none;
+    opacity: 0;
+  }
+}
diff --git a/src/ui/styles/desktop-interactions.css b/src/ui/styles/desktop-interactions.css
new file mode 100644
index 00000000..45e71daf
--- /dev/null
+++ b/src/ui/styles/desktop-interactions.css
@@ -0,0 +1,28 @@
+html.lemonvpn-desktop,
+html.lemonvpn-desktop * {
+  scrollbar-width: none !important;
+  /* Override React Aria's inline stable gutter while a modal locks scrolling.
+     Hidden desktop scrollbars need no reserved strip at the viewport edge. */
+  scrollbar-gutter: auto !important;
+  -webkit-user-select: none;
+  user-select: none;
+}
+html.lemonvpn-desktop::-webkit-scrollbar,
+html.lemonvpn-desktop *::-webkit-scrollbar {
+  display: none;
+  width: 0 !important;
+  height: 0 !important;
+}
+html.lemonvpn-desktop .rp-underlay {
+  inset: 0;
+  inline-size: 100vw;
+  block-size: 100dvh;
+  max-inline-size: none;
+  max-block-size: none;
+  margin: 0;
+}
+html.lemonvpn-desktop :is(input, textarea, [contenteditable]:not([contenteditable='false']), .cm-editor),
+html.lemonvpn-desktop :is(input, textarea, [contenteditable]:not([contenteditable='false']), .cm-editor) * {
+  -webkit-user-select: text;
+  user-select: text;
+}
diff --git a/src/ui/styles/desktop-sidebar.css b/src/ui/styles/desktop-sidebar.css
