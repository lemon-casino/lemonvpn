diff --git a/e2e/desktop.spec.ts b/e2e/desktop.spec.ts
new file mode 100644
index 00000000..b17b2840
--- /dev/null
+++ b/e2e/desktop.spec.ts
@@ -0,0 +1,88 @@
+import {expect, mockBackend, test} from './fixtures';
+import type {DesktopStatus} from '../src/api/api';
+
+test.use({storage: {'doona-lang': 'zh-CN'}});
+
+const status: DesktopStatus = {
+  observed_at: '2026-11-06T00:00:00Z',
+  mixed: {address: '127.0.0.1:18080', protocols: ['HTTP', 'SOCKS5']},
+  tun: {enabled: false, adapter: 'LemonVPN', address: '10.111.0.1', host_address: '10.111.0.2', udp: 'dns_only'},
+  memory: {
+    process: {rss_bytes: '8388608', peak_rss_bytes: '16777216', private_bytes: '12582912'},
+    system: {total_bytes: '17179869184', available_bytes: '8589934592', used_percent: 50}
+  }
+};
+
+test.beforeEach(async ({page}) => {
+  await page.addInitScript(() => {
+    Object.assign(window, {
+      __LEMONVPN_DESKTOP__: {name: 'LemonVPN', version: '0.1.0', platform: 'windows', arch: 'x86_64', engineUrl: location.origin},
+      // Production must also work when only Tauri's internal bridge is exposed.
+      __TAURI_INTERNALS__: {invoke: async () => ({enabled: true, server: '127.0.0.1:18080', error: null})}
+    });
+    // A stored remote profile must not redirect a desktop app away from its own engine.
+    localStorage.setItem('doona-profiles', JSON.stringify([{id: 'remote', name: 'Old server', api: 'https://old.example', token: ''}]));
+    localStorage.setItem('doona-profile', 'remote');
+  });
+  const backend = await mockBackend(page);
+  Object.assign(backend.capabilities.resources, {desktop: {available: true}, tun: {available: true}});
+  backend.handlers['GET version'] = async () => ({...(await backend.api.version()), engine: {name: 'lemonvpn', version: '0.1.0'}});
+  backend.handlers['GET desktop/status'] = async () => status;
+  backend.handlers['GET tun'] = async () => status.tun;
+  backend.handlers['GET datapath'] = async () => ({
+    observed_at: status.observed_at,
+    kind: 'userspace',
+    state: 'active',
+    visibility: 'partial',
+    ebpf: null,
+    errors: []
+  });
+});
+
+test('desktop settings and connection popover expose only desktop controls', async ({page}) => {
+  await page.goto('/#/settings');
+  await expect(page.getByRole('heading', {name: '设置', level: 1, exact: true})).toBeVisible();
+  await expect(page.locator('.rp-top .rp-brand')).toHaveText('LemonVPN');
+  await expect(page.locator('.rp-top .rp-brand img, .rp-top .rp-brand-version')).toHaveCount(0);
+  await expect(page.locator('#settings-backend')).toHaveCount(0);
+  await expect(page.getByLabel('后端网址', {exact: true})).toHaveCount(0);
+  await expect(page.getByRole('button', {name: /配置方案|关于 doona/})).toHaveCount(0);
+  await expect(page.getByRole('link', {name: '指南', exact: true})).toHaveCount(0);
+  await expect(page.getByRole('switch', {name: 'TUN 模式', exact: true})).toBeEnabled();
+  await expect(page.getByText('日志级别', {exact: true})).toBeVisible();
+  await expect(page.locator('.rp-side .rp-version')).toHaveText('LemonVPN 0.1.0');
+  await page.locator('.rp-side .rp-version').click();
+  const popover = page.getByRole('dialog', {name: 'LemonVPN 0.1.0', exact: true});
+  await expect(popover).toContainText('windows');
+  await expect(popover).toContainText('x86_64');
+  await expect(popover).not.toContainText('配置方案');
+  await expect(popover.getByRole('button', {name: '关于 doona'})).toHaveCount(0);
+  await expect(popover.getByRole('link', {name: '编辑后端'})).toHaveCount(0);
+  await page.screenshot({path: '../app/src-tauri/target/ui-preview/desktop-connection.png'});
+  await page.keyboard.press('Escape');
+  await page.evaluate(() => document.fonts.ready);
+  await page.screenshot({path: '../app/src-tauri/target/ui-preview/desktop-settings.png', fullPage: true});
+});
+
+test('desktop system status shows process/system memory and compact traffic facts', async ({page}) => {
+  await page.goto('/#/overview');
+  const memory = page
+    .locator('section')
+    .filter({has: page.getByRole('heading', {name: '内存', exact: true})})
+    .first();
+  await expect(memory).toContainText('引擎常驻内存');
+  await expect(memory).toContainText('私有提交内存');
+  await expect(memory).toContainText('系统可用内存');
+  await expect(memory).not.toContainText('cgroup');
+  await expect(memory).not.toContainText('OOM');
+  const datapath = page
+    .locator('section')
+    .filter({has: page.getByRole('heading', {name: '数据路径', exact: true})})
+    .first();
+  await expect(datapath).toContainText('127.0.0.1:18080');
+  await expect(datapath).toContainText('HTTP · SOCKS5');
+  await expect(datapath).toContainText('系统代理');
+  expect((await datapath.boundingBox())!.height).toBeLessThan(450);
+  await page.evaluate(() => document.fonts.ready);
+  await page.screenshot({path: '../app/src-tauri/target/ui-preview/desktop-status.png', fullPage: true});
+});
