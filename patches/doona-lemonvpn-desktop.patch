+  .rp-desktop-side .rp-desktop-nav-section > .rp-nav {
+    gap: 6px;
+    padding-inline: 8px;
+    min-inline-size: 0;
+  }
+  .rp-desktop-nav-section > .rp-nav > span {
+    min-inline-size: 0;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+  .rp-desktop-nav-label {
+    margin: 0 10px 5px;
+    font-size: 11px;
+    line-height: 18px;
+    color: var(--rp-muted);
+    font-weight: 600;
+  }
+  .rp-desktop-controls {
+    flex: none;
+  }
+  .rp-desktop-control-grid {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 8px;
+  }
+  .rp-desktop-toggle {
+    display: flex;
+    flex-direction: column;
+    align-items: stretch;
+    justify-content: space-between;
+    gap: 8px;
+    min-height: 70px;
+    height: auto;
+    padding: 10px;
+    border: 1px solid var(--rp-line);
+    border-radius: 12px;
+    background: var(--rp-surface);
+    font: inherit;
+    font-size: 12px;
+    font-weight: 600;
+    text-align: start;
+    color: var(--rp-subtle);
+  }
+  .rp-desktop-toggle[aria-pressed='true'] {
+    background: var(--rp-selected);
+    border-color: color-mix(in srgb, var(--rp-accent) 40%, var(--rp-line));
+    color: var(--rp-accent);
+  }
+  .rp-desktop-toggle[data-disabled] {
+    opacity: 0.55;
+    cursor: default;
+  }
+  .rp-desktop-toggle[data-focus-visible] {
+    outline: 2px solid var(--rp-accent);
+    outline-offset: 2px;
+  }
+  .rp-desktop-toggle:not([data-disabled]) {
+    cursor: pointer;
+  }
+  .rp-desktop-toggle[data-hovered] {
+    border-color: var(--rp-accent);
+  }
+  .rp-desktop-toggle-top {
+    display: flex;
