diff --git a/src/features/nodes/NodeGroupsDialog.tsx b/src/features/nodes/NodeGroupsDialog.tsx
new file mode 100644
index 00000000..302e60b1
--- /dev/null
+++ b/src/features/nodes/NodeGroupsDialog.tsx
@@ -0,0 +1,187 @@
+import {useId, useState} from 'react';
+import type {Node} from '../../api/model';
+import {getApi} from '../../api';
+import {ApiError, errorText} from '../../api/error';
+import {useT} from '../../i18n';
+import {useConfig} from '../../store/config';
+import {useGroups} from '../../store';
+import {useAction} from '../../store/action';
+import {useDraftGuard} from '../../shell/draft';
+import {Button, Disclosure, Form, InlineAlert, ModalDialog, Segmented, TextField, toast} from '../../ui/ui';
+import {CheckboxSet, type CheckboxChoice} from '../../ui/CheckboxSet';
+import {NodeName} from '../../ui/NodeName';
+
+export type NodeGroupsDialogProps = {nodes: Node[]; choices: CheckboxChoice[]; batch?: boolean; onClose: () => void; onSaved: () => void};
+type GroupMode = 'add' | 'remove' | 'replace';
+
+export function NodeGroupsDialog({nodes, choices, batch = false, onClose, onSaved}: NodeGroupsDialogProps) {
+  const t = useT();
+  const formId = useId();
+  const config = useConfig();
+  const groups = useGroups();
+  // This opening retains the selected nodes, original memberships and generation.
+  const [generation] = useState(config.data?.generation_id);
+  const [mode, setMode] = useState<GroupMode>(batch ? 'add' : 'replace');
+  const [selected, setSelected] = useState(() => (batch ? [] : [...nodes[0].group_ids]));
+  const [search, setSearch] = useState('');
+  const [problem, setProblem] = useState<string | null>(null);
+  const [stale, setStale] = useState(false);
+  const action = useAction<'node-groups'>({shared: 'main-source-edit', rethrow: true});
+  const busy = action.busy !== null;
+  const editable = new Set(choices.filter(item => !item.isDisabled).map(item => item.id));
+  const picks = selected.filter(id => editable.has(id));
+  const edits = nodes.map(node => {
+    const desired = !batch
+      ? selected
+      : mode === 'add'
+        ? [...node.group_ids, ...picks]
+        : mode === 'remove'
+          ? node.group_ids.filter(id => !picks.includes(id))
+          : [...node.group_ids.filter(id => !editable.has(id)), ...picks];
+    return {node_id: node.id, group_ids: [...new Set(desired)], expected_group_ids: node.group_ids};
+  });
+  const changed = edits.filter(
+    edit => edit.group_ids.length !== edit.expected_group_ids.length || edit.group_ids.some(id => !edit.expected_group_ids.includes(id))
+  ).length;
+  const dirty = changed > 0 && (!batch || picks.length > 0);
+  const guard = useDraftGuard(dirty, onClose, 'config.draftNode');
+  const count = (id: string) => nodes.filter(node => node.group_ids.includes(id)).length;
+  const offered = batch && mode === 'remove' ? choices.filter(item => count(item.id) > 0) : choices;
+  const filtered = offered
+    .filter(item => item.label.toLocaleLowerCase().includes(search.trim().toLocaleLowerCase()))
+    .map(item => (batch ? {...item, description: t('nodes.groupsMemberCount', {n: count(item.id), total: nodes.length})} : item));
+  const canSave = dirty && !busy && !stale && !!generation;
+  const refresh = () => {
+    config.refetch();
+    groups.refetch();
+    onSaved();
+  };
+  const save = async () => {
+    const api = getApi();
+    if (!canSave || (batch ? !api.updateNodesGroups : !api.updateNodeGroups)) return;
+    setProblem(null);
+    try {
+      const result = await action.run('node-groups', async signal =>
+        batch
+          ? await api.updateNodesGroups!({generation_id: generation!, edits}, signal)
+          : await api.updateNodeGroups!(
+              nodes[0].id,
+              {generation_id: generation!, group_ids: edits[0].group_ids, expected_group_ids: nodes[0].group_ids},
+              signal
+            )
+      );
+      if (!result) return;
+      guard.clear();
+      refresh();
+      toast('positive', batch ? t('nodes.groupsBatchSaved', {n: changed}) : t('nodes.groupsSaved', {name: nodes[0].name}));
+      onClose();
+    } catch (error) {
+      setProblem(errorText(error, t));
+      refresh();
+      if (!(error instanceof ApiError) || error.status === 0 || error.status === 409 || error.status === 412 || error.status >= 500) setStale(true);
+    }
+  };
+  const modes: Array<[string, string]> = [
+    ['add', t('nodes.groupsAdd')],
+    ['remove', t('nodes.groupsRemove')],
+    ['replace', t('nodes.groupsReplace')]
+  ];
+  const clearable = batch ? choices.filter(item => !item.isDisabled && count(item.id) > 0).map(item => item.id) : selected.filter(id => editable.has(id));
+  return (
+    <ModalDialog
+      title={t(batch ? 'nodes.manageSelectedGroups' : 'nodes.manageGroups', {n: nodes.length})}
+      isOpen
+      scrollBody
+      locked={busy}
+      onOpenChange={open => {
+        if (!open && !busy) onClose();
+      }}
+      reason={!generation ? t('config.incomplete') : null}
+      footer={() => (
+        <>
+          <Button onPress={onClose} isDisabled={busy}>
+            {t('ui.cancel')}
+          </Button>
+          <Button accent type="submit" form={formId} isPending={busy} isDisabled={!canSave}>
+            {t('policy.save')}
+          </Button>
+        </>
+      )}
+    >
+      <Form
+        id={formId}
+        className="rp-list"
+        onSubmit={event => {
+          event.preventDefault();
+          void save();
+        }}
+      >
+        {batch ? (
+          <Disclosure flush title={t('nodes.selectedNodes', {n: nodes.length})}>
+            <div className="rp-list">
+              {nodes.map(node => (
+                <NodeName key={node.id} name={node.name} />
+              ))}
+            </div>
+          </Disclosure>
+        ) : (
+          <NodeName name={nodes[0].name} />
+        )}
+        {batch && (
+          <Segmented
+            label={t('nodes.groupsOperation')}
+            value={mode}
+            onChange={next => {
+              if (next === mode) return;
+              setMode(next as GroupMode);
+              setSelected([]);
+              setProblem(null);
+            }}
+            items={modes}
+            isDisabled={busy || stale}
+          />
+        )}
+        <p className="rp-note">
+          {t(
+            !batch
+              ? 'nodes.manageGroupsHelp'
+              : mode === 'add'
+                ? 'nodes.groupsAddHelp'
+                : mode === 'remove'
+                  ? 'nodes.groupsRemoveHelp'
+                  : 'nodes.groupsReplaceHelp'
+          )}
+        </p>
+        {problem && <InlineAlert tone="negative">{problem}</InlineAlert>}
+        {stale && (
+          <Button
+            onPress={() => {
+              refresh();
+              guard.clear();
+              onClose();
+            }}
+          >
+            {t('nodes.groupsRefresh')}
+          </Button>
+        )}
+        <TextField search label={t('ui.filterGroups')} value={search} onChange={setSearch} />
+        <CheckboxSet label={t('nodes.groups')} items={filtered} value={selected} onChange={setSelected} isDisabled={busy || stale} />
+        <span className="rp-label">
+          {t('nodes.groupsSelected', {n: selected.length})}
+          {batch && changed > 0 && ` · ${t('nodes.groupsChangedCount', {n: changed})}`}
+        </span>
+        {(!batch || mode === 'remove') && (
+          <Button
+            isDisabled={busy || stale || !clearable.length}
+            onPress={() => {
+              setSearch('');
+              setSelected(batch ? clearable : selected.filter(id => !editable.has(id)));
+            }}
+          >
+            {t('nodes.leaveAllGroups')}
+          </Button>
+        )}
+      </Form>
+    </ModalDialog>
+  );
+}
