+import type {ProxyChainHop} from '../../api/model';
+import {useChainEndpoint} from '../../store';
+import {useT} from '../../i18n';
+import {ChoiceMenu, ErrorMessage, toast} from '../../ui/ui';
+import {NodeName} from '../../ui/NodeName';
+import {selectionNotice} from './selectMember';
+
+export function ChainEndpointControl({
+  id,
+  chainId,
+  current,
+  network,
+  enabled,
+  label
+}: {
+  id: string;
+  chainId: string;
+  current?: ProxyChainHop;
+  network: 'tcp' | 'udp';
+  enabled: boolean;
+  label: string;
+}) {
+  const t = useT();
+  const control = useChainEndpoint(id, chainId, network, enabled);
+  const group = control.data;
+  const selected = group?.runtime.selection[network];
+  const pinned = group?.capabilities.can_override && selected?.source === 'override';
+  const pick = (member: string) => {
+    void control.pick(member).then(result => {
+      if (!result || !group) return;
+      const name = (id: string) => group.members.find(item => item.id === id)?.name ?? id;
+      toast(
+        'positive',
+        'member_id' in result
+          ? selectionNotice(result, group.name, name(result.member_id), t)
+          : t('policy.backToAutomatic', {name: group.name, member: name(result.selection[network]?.member_id ?? '')})
+      );
+    });
+  };
+  return (
+    <div className="rp-chain-endpoint-control" aria-busy={!!control.busy}>
+      <ChoiceMenu
+        quiet
+        small
+        label={`${label} · ${network.toUpperCase()}`}
+        value={selected?.member_id ?? current?.id ?? ''}
+        onChange={() => {}}
+        onAction={pick}
+        items={(group?.members ?? []).map(member => ({id: member.id, label: member.name}))}
+        searchLabel={t('ui.filterMembers')}
+        isDisabled={!enabled || !!control.busy || !group?.members.length || !(group.capabilities.can_select || group.capabilities.can_override)}
+        onIntent={() => void control.refetch()}
+      >
+        <NodeName
+          name={current?.name ?? group?.members.find(member => member.id === selected?.member_id)?.name ?? '—'}
+          text={pinned ? t('chain.releasePinHint') : undefined}
+        />
+      </ChoiceMenu>
+      <ErrorMessage error={control.error} onRetry={control.refetch} />
+      <ErrorMessage error={control.actionError} />
+    </div>
+  );
+}
