+  // A warm open port must never mask a failed real proxy request, including
+  // a cold HTTP probe after an authorization was revoked.
+  const proxied = data.filter(h => h.measurement.startsWith('http') || h.measurement === 'quic_handshake');
+  const candidates = proxied.length ? proxied : data;
+  const best = Math.min(...candidates.map(observationRank));
+  return foldFamilies(candidates.filter(h => observationRank(h) === best));
 }
