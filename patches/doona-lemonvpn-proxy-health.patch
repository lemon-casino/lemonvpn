diff --git a/src/features/nodes/proxy-health.test.ts b/src/features/nodes/proxy-health.test.ts
new file mode 100644
--- /dev/null
+++ b/src/features/nodes/proxy-health.test.ts
@@ -0,0 +1,29 @@
+import {expect, it} from 'vitest';
+import {preferredHealth} from '../../api/selectors';
+import type {HealthObservation, Node} from '../../api/model';
+import {translate, type Translator} from '../../i18n';
+import {nodeRowView} from './view';
+
+const t: Translator = (key, params) => translate('en', key, params);
+const sample = (patch: Partial<HealthObservation> = {}): HealthObservation => ({
+  transport: 'tcp', purpose: 'data', ip_version: 'ipv4', warmth: 'warm',
+  measurement: 'http_headers', sample_source: 'probe', state: 'healthy', latency_ms: 50,
+  moving_avg_ms: 50, avg10_ms: 50, observed_at: '2026-11-09T10:00:00Z', error: null, ...patch
+});
+const node = (health: HealthObservation[]): Node => ({id: 'expired', name: 'expired', protocol: 'vless', stream_transport: 'ws', subscription_tag: null, provider_id: null, group_ids: [], health});
+
+it('a failed proxy request wins over a successful warm TCP port and old averages', () => {
+  const failure = sample({warmth: 'cold', state: 'unavailable', latency_ms: null, error: 'probe_failed'});
+  const value = node([sample({measurement: 'tcp_connect', latency_ms: 10}), failure]);
+  expect(preferredHealth(value)).toBe(failure);
+  expect(nodeRowView(value, new Map(), 'en', t)).toMatchObject({latency: '-1', latencyClass: 'ms err'});
+});
+
+it('an open server port is labelled as diagnostic information instead of usable proxy latency', () => {
+  const value = node([sample({measurement: 'tcp_connect'})]);
+  expect(nodeRowView(value, new Map(), 'en', t)).toMatchObject({latency: 'Port only', latencyClass: 'ms'});
+});
+
+it('a renewed proxy request restores real latency without retaining the failed display', () => {
+  expect(nodeRowView(node([sample({latency_ms: 42})]), new Map(), 'en', t)).toMatchObject({latency: '42 ms'});
+});
