@@ -0,0 +1,9 @@
+import type {RuleList} from '../../api/model';
+
+// Keep source-file editors separate from generated category rules, while the
+// topology and flow filters use the actual rule IDs of the active generation.
+export function effectiveRules(list: RuleList | undefined): RuleList | undefined {
+  if (!list?.['x-lemonvpn-resource-rules']?.length) return list;
+  const byId = new Map([...list.rules, ...list['x-lemonvpn-resource-rules']].map(rule => [rule.rule_id, rule]));
+  return {...list, rules: [...byId.values()].sort((a, b) => a.index - b.index)};
+}
