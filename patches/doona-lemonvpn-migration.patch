diff --git a/src/features/dns/DnsListener.tsx b/src/features/dns/DnsListener.tsx
new file mode 100644
index 0000000..2e2348d
--- /dev/null
+++ b/src/features/dns/DnsListener.tsx
@@ -0,0 +1,125 @@
+import {useState} from 'react';
+import {runtime} from '../../api/rulesRuntime';
+import {useResource} from '../../store/resource';
+import {useAction} from '../../store/action';
+import {useDraftGuard} from '../../shell/draft';
+import {useT} from '../../i18n';
+import {Badge, Button, Card, ErrorMessage, Form, Switch, TextField, Toolbar} from '../../ui/ui';
+import {TextArea} from '../../ui/TextArea';
+
+type Settings = {enabled: boolean; bind_address: string; port: number; allowed_networks: string[]};
+type Status = {
+  settings: Settings;
+  revision: string;
+  active: boolean;
+  error: string | null;
+  tun_enabled: boolean;
+  queries: number;
+  failures: number;
+  last_error: string | null;
+};
+export function DnsListener() {
+  const t = useT();
+  const resource = useResource({key: ['dnsListener'], every: 10000, fetch: signal => runtime<Status>('GET', '/api/v1/dns/listener', undefined, signal)});
+  const action = useAction<'save'>({shared: 'dns-listener'});
+  const [draft, setDraft] = useState<{revision: string; settings: Settings; networks: string; port: string} | null>(null);
+  const data = resource.data;
+  const settings = draft?.settings ?? data?.settings;
+  const dirty =
+    !!draft &&
+    !!data &&
+    (JSON.stringify(draft.settings) !== JSON.stringify(data.settings) ||
+      draft.port !== String(data.settings.port) ||
+      draft.networks !== data.settings.allowed_networks.join('\n'));
+  const guard = useDraftGuard(dirty, () => setDraft(null), 'dns.listenerTitle');
+  const edit = (change: Partial<Settings>, extra?: {networks?: string; port?: string}) => {
+    if (!settings || !data) return;
+    setDraft({
+      revision: draft?.revision ?? data.revision,
+      settings: {...settings, ...change},
+      networks: draft?.networks ?? data.settings.allowed_networks.join('\n'),
+      port: draft?.port ?? String(data.settings.port),
+      ...extra
+    });
+  };
+  const save = async () => {
+    if (!draft || !data || draft.revision !== data.revision) return;
+    const result = await action.run('save', signal =>
+      runtime<Status>(
+        'PUT',
+        '/api/v1/dns/listener',
+        {
+          revision: draft.revision,
+          settings: {
+            ...draft.settings,
+            port: Number(draft.port),
+            allowed_networks: draft.networks
+              .split(/\r?\n/)
+              .map(s => s.trim())
+              .filter(Boolean)
+          }
+        },
+        signal
+      )
+    );
+    if (result) {
+      setDraft(null);
+      guard.clear();
+      resource.refetch();
+    }
+  };
+  return (
+    <Card title={t('dns.listenerTitle')} note={t('dns.listenerHelp')}>
+      <ErrorMessage error={resource.error ?? action.error} onRetry={resource.refetch} />
+      {settings && data && (
+        <Form
+          className="rp-fakeip-form"
+          onSubmit={e => {
+            e.preventDefault();
+            void save();
+          }}
+        >
+          <Toolbar>
+            <Switch isSelected={settings.enabled} isDisabled={!!action.busy} onChange={enabled => edit({enabled})}>
+              {t('dns.listenerEnable')}
+            </Switch>
+            <Badge>{t(data.active ? 'lan.active' : 'lan.inactive')}</Badge>
+            <span className="rp-note">{t('dns.listenerCount', {queries: data.queries, failures: data.failures})}</span>
+          </Toolbar>
+          <div className="rp-fakeip-grid">
+            <TextField label={t('lan.bind')} value={settings.bind_address} onChange={bind_address => edit({bind_address})} />
+          <TextField label={t('dns.listenerPort')} value={draft?.port ?? String(settings.port)} onChange={port => edit({}, {port})} />
+          </div>
+          <TextArea
+            label={t('dns.listenerNetworks')}
+            value={draft?.networks ?? settings.allowed_networks.join('\n')}
+            onChange={networks => edit({}, {networks})}
+          />
+          {(data.error || data.last_error) && <p role="alert">{data.error ?? data.last_error}</p>}
+          <p className="rp-note">{t(data.tun_enabled ? 'dns.listenerFake' : 'dns.listenerReal')}</p>
+          <Toolbar>
+            <Button
+              accent
+              type="submit"
+              isPending={!!action.busy}
+              isDisabled={
+                !dirty || draft?.revision !== data.revision || !/^\d+$/.test(draft?.port ?? '') || Number(draft?.port) < 1 || Number(draft?.port) > 65535
+              }
+            >
+              {t('rr.save')}
+            </Button>
+            <Button
+              isDisabled={!!action.busy || !draft}
+              onPress={() => {
+                setDraft(null);
+                guard.clear();
+              }}
+            >
+              {t('ui.cancel')}
+            </Button>
+          </Toolbar>
+        </Form>
+      )}
+    </Card>
+  );
+}
