+++ b/src/features/shared/resources/ResourceTrace.tsx
@@ -0,0 +1,182 @@
+import {ChainDiagram, type ProxyPathHop} from '../ProxyPath';
+import {useState} from 'react';
+import {useT} from '../../../i18n';
+import {runtime} from '../../../api/rulesRuntime';
+import {useAction} from '../../../store/action';
+import {Badge, Button, Card, ErrorMessage, Toolbar} from '../../../ui/ui';
+import {Check, Field, Grid, Select, useRulesRuntime} from './common';
+
+type TraceResult = {
+  dns_steps: {pool: string; response_action: string; endpoint: string | null}[];
+  generation_id: string;
+  resource_revision: string;
+  live: boolean;
+  domain: string;
+  cache_source: string;
+  endpoint?: string;
+  selected_dns: [string, string] | null;
+  route: {
+    evaluation: {
+      decision: string;
+      outbound: string | null;
+      dst_ip: string | null;
+      missing_inputs: string[];
+      'x-lemonvpn-chain'?: {hops: ProxyPathHop[]};
+      rules: {rule_id: string; expression: string; result: string; missing_inputs: string[]}[];
+    };
+  };
+  dns: {results: {type: string; status: string; error?: {message: string}; answers?: {name: string; type: string; data: string; ttl: number}[]}[]} | null;
+  dns_policies: {id: string; name: string; condition: string; matched: boolean; pool: string; address_mode: string}[];
+  resources: {id: string; sha256: string; known: boolean; matched: boolean; count: number}[];
+  fake_ip: {configured_mode: string; tun_active: boolean; excluded: boolean; ipv4_range: string; ipv6_range: string; mapping_allocated: boolean};
+};
+export function ResourceTrace({initialDomain = '', query = false}: {initialDomain?: string; query?: boolean}) {
+  const t = useT();
+  const model = useRulesRuntime();
+  const [domain, setDomain] = useState(initialDomain);
+  const [kind, setKind] = useState('A');
+  const [live, setLive] = useState(query);
+  const [network, setNetwork] = useState('tcp');
+  const [port, setPort] = useState('443');
+  const [ip, setIp] = useState('');
+  const [process, setProcess] = useState('');
+  const [result, setResult] = useState<TraceResult>();
+  const action = useAction<'trace'>();
+  const trace = async () => {
+    const value = await action.run('trace', signal =>
+      runtime<TraceResult>(
+        'POST',
+        '/api/v1/dns/trace',
+        {domain, type: kind, live, network, port: Number(port), ...(ip ? {destination_ip: ip} : {}), ...(process ? {process} : {})},
+        signal
+      )
+    );
+    if (value) setResult(value);
+  };
+  const outdated = !!result && !!model.data && result.generation_id !== model.data.generation_id;
+  const route = result?.route.evaluation;
+  return (
+    <div className="rr-list">
+      <Card title={t(query ? 'rr.dnsQuery' : 'rr.trace')}>
+        <div className="rr-list">
+          <ErrorMessage error={action.error} />
+          <Grid>
+            <Field label={t('ui.domain')} value={domain} onChange={setDomain} placeholder={t('rr.domainExample')} />
+            <Select
+              label={t('ui.type')}
+              value={kind}
+              onChange={setKind}
+              items={['A', 'AAAA', 'CNAME', 'MX', 'TXT', 'NS', 'SOA'].map(id => ({id, label: id}))}
+            />
+          </Grid>
+          <Toolbar>
+            <Check label={t('rr.liveDns')} value={live} onChange={setLive} />
+            <Button accent isPending={!!action.busy} isDisabled={!domain.trim() || !Number(port) || Number(port) > 65535} onPress={() => void trace()}>
+              {t(query ? 'dns.query' : 'rr.analyze')}
+            </Button>
+          </Toolbar>
+          <p className="rp-note">{t(live ? 'rr.liveHint' : 'rr.offlineHint')}</p>
+          <details className="rr-details">
+            <summary>{t('rr.advanced')}</summary>
+            <Grid>
+              <Select label={t('rr.network')} value={network} onChange={setNetwork} items={['tcp', 'udp'].map(id => ({id, label: id.toUpperCase()}))} />
+              <Field type="number" label={t('rr.port')} value={port} min={1} max={65535} onChange={setPort} />
+              <Field label={t('ui.destinationIp')} value={ip} onChange={setIp} />
+              <Field label={t('ui.process')} value={process} onChange={setProcess} />
+            </Grid>
+          </details>
+        </div>
+      </Card>
+      {result && (
+        <Card title={result.domain}>
+          <div className="rr-list">
+            <Toolbar>
+              <Badge>{t(result.live ? 'rr.actualDns' : 'rr.simulated')}</Badge>
+              <span className="rp-note rr-version" title={result.generation_id}>
+                {result.generation_id}
+              </span>
+              {outdated && <Badge tone="warn">{t('rr.resultStale')}</Badge>}
+            </Toolbar>
+            <div className="rr-step">
+              <strong>1 · {t('rr.dnsSelection')}</strong>
+              <p>{model.data?.document.pools.find(p => p.id === result.selected_dns?.[0])?.name ?? result.selected_dns?.[0] ?? t('rr.legacyDefault')}</p>
+              <p className="rp-note">{result.selected_dns?.[1]}</p>
+              {result.endpoint && <p>{model.data?.document.resolvers.find(r => r.id === result.endpoint)?.name ?? result.endpoint}</p>}
+              {result.dns_steps?.map((step, i) => (
+                <p className="rp-note" key={i}>
+                  {model.data?.document.pools.find(p => p.id === step.pool)?.name ?? step.pool} → {step.response_action}
+                </p>
+              ))}
+              {result.dns_policies.map(row => (
+                <p className="rp-note" key={row.id}>
+                  {row.matched ? '✓' : '—'} {row.name} · {row.condition}
+                </p>
+              ))}
+            </div>
+            <div className="rr-step">
+              <strong>2 · {t('rr.cacheResult')}</strong>
+              <p>
+                {t(
+                  result.cache_source === 'cache'
+                    ? 'rr.fromCache'
+                    : result.cache_source === 'coalesced'
+                      ? 'rr.coalesced'
+                      : result.cache_source === 'stale'
+                        ? 'rr.staleReplies'
+                        : result.cache_source === 'not_queried'
+                          ? 'rr.notQueried'
+                          : 'rr.fromUpstream'
+                )}
+              </p>
+              {result.dns?.results.map((answer, i) => (
+                <div key={i}>
+                  <p>
+                    {answer.type} · {answer.status}
+                  </p>
+                  {answer.error && <p role="alert">{answer.error.message}</p>}
+                  {answer.answers?.map((row, j) => (
+                    <p key={j} className="rp-code">
+                      {row.data} · {row.type} · {t('rr.ttl')} {row.ttl}s
+                    </p>
+                  ))}
+                </div>
+              ))}
+            </div>
+            <div className="rr-step">
+              <strong>3 · {t('rr.fakeIp')}</strong>
+              <p>
+                {result.fake_ip.configured_mode} · {t(result.fake_ip.tun_active ? 'rr.tunActive' : 'rr.tunInactive')}
+              </p>
+              <p className="rp-note">{t('rr.traceNoMapping')}</p>
+            </div>
+            <div className="rr-step">
+              <strong>4 · {t('rr.routeSelection')}</strong>
+              <p>{route?.outbound === 'direct' ? t('rr.direct') : route?.outbound === 'block' ? t('rr.block') : (route?.outbound ?? t('rr.unknown'))}</p>
+              {route?.missing_inputs.length ? (
+                <p className="rp-note">
+                  {t('rr.missingInputs')} · {route.missing_inputs.join(', ')}
+                </p>
+              ) : null}
+              {route?.rules.map(rule => (
+                <p className="rp-note" key={rule.rule_id}>
+                  {rule.result === 'matched' ? '✓' : rule.result === 'indeterminate' ? '?' : '—'} {rule.expression}
+                </p>
+              ))}
+              <p className="rp-note">{t('rr.routeSimulated')}</p>
+              {!!route?.['x-lemonvpn-chain']?.hops.length && <ChainDiagram hops={route['x-lemonvpn-chain'].hops} target={result.domain} />}
+            </div>
+            <details className="rr-details">
+              <summary>{t('rr.resourceVersions')}</summary>
+              {result.resources.map(row => (
+                <p className="rp-note" key={row.id}>
+                  {row.known ? (row.matched ? '✓' : '—') : '?'} {model.data?.document.providers.find(p => p.id === row.id)?.name ?? row.id} · {row.count} ·{' '}
+                  {row.sha256}
+                </p>
+              ))}
+            </details>
+          </div>
+        </Card>
+      )}
+    </div>
+  );
+}
