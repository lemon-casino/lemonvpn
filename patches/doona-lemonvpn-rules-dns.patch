+import {useRef, useState} from 'react';
+import {useT, type Key} from '../../../i18n';
+import {Button, Card, Empty, ErrorMessage, ModalDialog, Toolbar, Badge} from '../../../ui/ui';
+import {useAction} from '../../../store/action';
+import {refetchAll} from '../../../store/resourceCore';
+import {useDraftGuard} from '../../../shell/draft';
+import {DragHandle, FileInput} from '../../../ui/ResourceFields';
+import {useResource} from '../../../store/resource';
+import {
+  runtime,
+  operation,
+  newProvider,
+  resourceId,
+  sourceLabel,
+  type Binding,
+  type Policy,
+  type Pool,
+  type Reference,
+  type Resolver,
+  type ResourceKind,
+  type ResourceRow,
+  type RuleProvider,
+  type RulesStatus
+} from '../../../api/rulesRuntime';
+import {Check, Field, Grid, lines, OutboundSelect, RuntimeHeader, Select, useRulesRuntime, type RuntimeModel} from './common';
+import {BuiltinProviders} from './BuiltinProviders';
+
+const names: Record<ResourceKind, Key> = {
+  providers: 'rr.providers',
+  resolvers: 'rr.resolvers',
+  pools: 'rr.pools',
+  policies: 'rr.policies',
+  bindings: 'rr.bindings'
+};
+export function ResourceManager({kind, initialCondition}: {kind: ResourceKind; initialCondition?: string}) {
+  const t = useT();
+  const model = useRulesRuntime();
+  const refreshAction = useAction<'refresh'>({shared: 'rule-provider-download'});
+  const cancelAction = useAction<'cancel'>();
+  const [refreshingId, setRefreshingId] = useState('');
+  const [cancelledId, setCancelledId] = useState('');
+  const cancellation = useRef('');
+  const refresh = async (id: string) => {
+    setRefreshingId(id);
+    setCancelledId('');
+    cancellation.current = '';
+    await refreshAction.run('refresh', signal => operation('/refresh', {id}, signal));
+    if (cancellation.current === id) refreshAction.setError(null);
+    setRefreshingId('');
+    await refetchAll();
+  };
+  const cancel = async (id: string) => {
+    const result = await cancelAction.run('cancel', signal => runtime('POST', '/cancel', {id}, signal));
+    if (result) {
+      cancellation.current = id;
+      setCancelledId(id);
+      model.refetch();
+    }
+  };
+  const [editing, setEditing] = useState<ResourceRow | null>(null);
+  const [deleting, setDeleting] = useState<ResourceRow | null>(null);
+  const [preview, setPreview] = useState<RuleProvider | null>(null);
+  const [builtin, setBuiltin] = useState(false);
+  const [drop, setDrop] = useState('');
+  const drag = useRef('');
+  const rows = model.data?.document[kind] ?? [];
+  const add = () => {
+    const base = {id: resourceId(), name: '', enabled: true};
+    const condition = initialCondition ?? 'domain(suffix: example.com)';
+    const row =
+      kind === 'providers'
+        ? newProvider()
+        : kind === 'resolvers'
+          ? {...base, url: 'https://dns.alidns.com/dns-query', outbound: 'direct', bootstrap: ['223.5.5.5'], tls_name: '', timeout_ms: 3000}
+          : kind === 'pools'
+            ? {...base, members: [], strategy: 'fallback'}
+            : kind === 'policies'
+              ? {...base, condition, pool: model.data?.document.pools[0]?.id ?? '', address_mode: 'inherit'}
+              : {...base, condition, outbound: 'direct'};
+    setEditing(row);
+  };
+  const reorder = (id: string, before: string) => {
+    setDrop('');
+    drag.current = '';
+    if (!model.data || model.busy || id === before) return;
+    const changed = rows.filter(r => r.id !== id);
+    const row = rows.find(r => r.id === id);
+    if (!row) return;
+    const at = changed.findIndex(r => r.id === before);
+    changed.splice(at < 0 ? changed.length : at, 0, row);
+    void model.save({...model.data.document, [kind]: changed});
+  };
+  return (
+    <Card title={t(names[kind])}>
+      <RuntimeHeader model={model} />
+      <ErrorMessage error={refreshAction.error ?? cancelAction.error} />
+      <Toolbar>
+        <p className="rp-note rp-grow">
+          {t(kind === 'providers' ? 'rr.providerHelp' : kind === 'policies' ? 'rr.policyHelp' : kind === 'bindings' ? 'rr.bindingHelp' : 'rr.upstreamHelp')}
+        </p>
+        {kind === 'providers' && (
+          <Button isDisabled={!model.data || model.busy} onPress={() => setBuiltin(true)}>
+            {t('rr.builtin')}
+          </Button>
+        )}
+        <Button isDisabled={!model.data || model.busy} onPress={add}>
+          {t('rr.add')}
+        </Button>
+      </Toolbar>
+      <div className="rr-list">
+        {rows.map((row, index) => {
+          const provider = kind === 'providers' ? (row as RuleProvider) : null;
+          const resource = model.data?.resources.find(r => r.id === row.id);
+          const update = model.data?.updates[row.id];
+          const sortable = kind === 'policies' || kind === 'bindings';
+          return (
+            <div
+              className="rr-item"
+              key={row.id}
+              data-drop={drop === row.id}
+              onDragOver={e => {
+                if (sortable && drag.current) {
+                  e.preventDefault();
+                  setDrop(row.id);
+                }
+              }}
+              onDrop={e => {
+                e.preventDefault();
+                if (sortable) reorder(drag.current, row.id);
+              }}
+            >
+              {sortable && (
+                <DragHandle
+                  label={t('rr.reorder')}
+                  disabled={model.busy}
+                  onStart={e => {
+                    drag.current = row.id;
+                    e.dataTransfer.setData('text/plain', row.id);
+                  }}
+                  onEnd={() => {
+                    drag.current = '';
+                    setDrop('');
+                  }}
+                />
+              )}
+              <div className="rr-main">
+                <strong>{row.name}</strong>
+                <p className="rp-note">
+                  {provider
+                    ? sourceLabel(provider)
+                    : 'condition' in row
+                      ? row.condition
+                      : 'url' in row
+                        ? row.url
+                        : (row as Pool).members.map(id => model.data?.document.resolvers.find(r => r.id === id)?.name ?? id).join(' → ')}
+                </p>
+                {resource && (
+                  <p className="rp-note">
+                    {resource.format} · {resource.behavior} · {resource.count.toLocaleString()} · {resource.sha256.slice(0, 12)} · {t('rr.references')}{' '}
+                    {resource.ref_count}
+                  </p>
+                )}
+                {provider?.updated_at ? <p className="rp-note">{new Date(provider.updated_at * 1000).toLocaleString()}</p> : null}
+                {update && (
+                  <p role="status" className="rp-note">
+                    {t(
+                      update.state === 'applying'
+                        ? 'rr.applying'
+                        : update.state === 'running'
+                          ? 'rr.updating'
+                          : update.state === 'failed'
+                            ? 'rr.failed'
+                            : update.state === 'cancelled'
+                              ? 'rr.cancelled'
+                              : 'rr.current'
+                    )}
+                    {update.message ? ` · ${update.message}` : ''}
+                  </p>
+                )}
+                {'pool' in row && (
+                  <Badge>
+                    {model.data?.document.pools.find(p => p.id === row.pool)?.name ?? row.pool} · {row.address_mode}
+                  </Badge>
+                )}
+                {'outbound' in row && !provider && <Badge>{row.outbound === 'direct' ? t('rr.direct') : row.outbound}</Badge>}
+              </div>
+              <div className="rp-cluster">
+                {'enabled' in row && (
+                  <Check
+                    label={t('rr.enabled')}
+                    value={row.enabled}
+                    disabled={model.busy}
+                    onChange={enabled => {
+                      if (model.data) void model.save({...model.data.document, [kind]: rows.map(r => (r.id === row.id ? {...r, enabled} : r))});
+                    }}
+                  />
+                )}
+                {provider?.source === 'http' && (
+                  <Button small isDisabled={model.busy || !!refreshAction.busy} isPending={refreshingId === row.id} onPress={() => void refresh(row.id)}>
+                    {t('rr.update')}
+                  </Button>
+                )}
+                {(update?.state === 'running' || refreshingId === row.id) && (
+                  <Button small isPending={!!cancelAction.busy} isDisabled={cancelledId === row.id} onPress={() => void cancel(row.id)}>
+                    {t(cancelledId === row.id ? 'rr.cancelRequested' : 'ui.cancel')}
+                  </Button>
+                )}
+                {provider && (
+                  <Button small quiet onPress={() => setPreview(provider)}>
+                    {t('rr.entries')}
+                  </Button>
+                )}
+                {sortable && index > 0 && (
+                  <Button small quiet isDisabled={model.busy} onPress={() => reorder(row.id, rows[index - 1].id)}>
+                    {t('rr.moveUp')}
+                  </Button>
+                )}
+                <Button small isDisabled={model.busy} onPress={() => setEditing(structuredClone(row))}>
+                  {t('rr.edit')}
+                </Button>
+                <Button small quiet isDisabled={model.busy} onPress={() => setDeleting(row)}>
+                  {t('rr.remove')}
+                </Button>
+              </div>
+            </div>
+          );
+        })}
+      </div>
+      {!rows.length && <Empty>{t('rr.empty')}</Empty>}
+      {editing && <ResourceEditor key={editing.id} kind={kind} initial={editing} model={model} close={() => setEditing(null)} />}
+      {deleting && <RemoveResource kind={kind} row={deleting} model={model} close={() => setDeleting(null)} />}
+      {preview && <ProviderEntries provider={preview} close={() => setPreview(null)} />}
+      {builtin && <BuiltinProviders model={model} close={() => setBuiltin(false)} />}
+    </Card>
+  );
+}
+
+export function ConditionField({value, onChange, model, dns = false}: {value: string; onChange: (value: string) => void; model: RuntimeModel; dns?: boolean}) {
+  const t = useT();
+  const parsed = /^(?:domain|dip)\((full|suffix|geosite|geoip):\s*([^()]+)\)$/.exec(value);
+  const set = /^ruleset\(["']?([\w-]+)["']?\)$/.exec(value);
+  const [mode, setMode] = useState(set ? 'ruleset' : (parsed?.[1] ?? 'expression'));
+  const current = mode === 'ruleset' ? (set?.[1] ?? '') : mode === 'expression' ? value : (parsed?.[2].replace(/^['"]|['"]$/g, '') ?? '');
+  const write = (kind: string, text: string) =>
+    onChange(
+      kind === 'expression' ? text : kind === 'ruleset' ? `ruleset('${text}')` : `${kind === 'geoip' ? 'dip' : 'domain'}(${kind}: ${JSON.stringify(text)})`
+    );
+  const sets = model.data?.document.providers.filter(p => !dns || model.data?.resources.find(r => r.id === p.id)?.domain_only) ?? [];
+  return (
+    <Grid>
+      <Select
+        label={t('rr.match')}
+        value={mode}
+        onChange={m => {
+          setMode(m);
+          write(m, m === 'ruleset' ? (sets[0]?.id ?? '') : m === 'expression' ? value : '');
+        }}
+        items={[
+          {id: 'suffix', label: t('rr.suffix')},
+          {id: 'full', label: t('rr.full')},
+          {id: 'geosite', label: 'GeoSite'},
+          ...(!dns ? [{id: 'geoip', label: 'GeoIP'}] : []),
+          {id: 'ruleset', label: t('rr.providers')},
+          {id: 'expression', label: t('rr.expression')}
+        ]}
+      />
+      {mode === 'ruleset' ? (
+        <Select
+          label={t('rr.providers')}
+          value={current}
+          onChange={s => write(mode, s)}
+          items={[{id: '', label: t('rr.choose')}, ...sets.map(p => ({id: p.id, label: p.name}))]}
+        />
+      ) : (
+        <Field
+          label={t('rr.condition')}
+          value={current}
+          onChange={s => write(mode, s)}
+          placeholder={t(mode === 'expression' ? 'rr.expressionExample' : 'rr.domainExample')}
+          hint={mode === 'full' ? t('rr.fullHint') : mode === 'suffix' ? t('rr.suffixHint') : undefined}
+        />
+      )}
+    </Grid>
+  );
+}
+
+function ResourceEditor({kind, initial, model, close}: {kind: ResourceKind; initial: ResourceRow; model: RuntimeModel; close: () => void}) {
+  const t = useT();
+  const [row, setRow] = useState(initial);
+  const [base64, setBase64] = useState<string>();
+  const [fileName, setFileName] = useState('');
+  const [headers, setHeaders] = useState(
+    'headers' in initial
+      ? Object.entries(initial.headers)
+          .map(([k, v]) => `${k}: ${v}`)
+          .join('\n')
+      : ''
+  );
+  const [localError, setLocalError] = useState<Error | null>(null);
+  const [revision] = useState(model.data?.revision);
+  const original = model.data?.document[kind].find(r => r.id === initial.id);
+  const dirty =
+    !original ||
+    JSON.stringify(initial) !== JSON.stringify(row) ||
+    !!base64 ||
+    ('headers' in initial &&
+      headers !==
+        Object.entries(initial.headers)
+          .map(([k, v]) => `${k}: ${v}`)
+          .join('\n'));
+  const guard = useDraftGuard(dirty, close, names[kind]);
+  const stale = revision !== model.data?.revision;
+  const patch = (values: object) => setRow({...row, ...values});
+  const save = async () => {
+    if (!model.data || model.busy || stale || !row.name.trim()) return;
+    setLocalError(null);
+    let result: RulesStatus | undefined;
+    if (kind === 'providers') {
+      const provider = {...row} as RuleProvider;
+      try {
+        provider.headers = Object.fromEntries(
+          headers
+            .split(/\r?\n/)
+            .filter(Boolean)
+            .map(line => {
+              const colon = line.indexOf(':');
+              if (colon < 1) throw new Error(t('rr.headerError'));
+              return [line.slice(0, colon).trim(), line.slice(colon + 1).trim()];
+            })
+        );
+      } catch (e) {
+        setLocalError(e as Error);
+        return;
+      }
+      if (provider.source === 'file' && !base64 && !provider.accepted_sha256) {
+        setLocalError(new Error(t('rr.fileRequired')));
+        return;
+      }
+      const download = provider.source === 'http' && (!original || (original as RuleProvider).url !== provider.url || !provider.accepted_sha256);
+      if (download || base64)
+        result = await model.write('import', signal => operation('/import', {revision: revision, provider, ...(base64 ? {base64} : {})}, signal));
+      else result = await model.save({...model.data.document, providers: [...model.data.document.providers.filter(p => p.id !== row.id), provider]}, revision);
+    } else {
+      const rows = model.data.document[kind];
+      result = await model.save({...model.data.document, [kind]: original ? rows.map(r => (r.id === row.id ? row : r)) : [...rows, row]}, revision);
+    }
+    if (result) {
+      guard.clear();
+      close();
+    }
+  };
+  const provider = row as RuleProvider;
+  const resolver = row as Resolver;
+  const pool = row as Pool;
+  const policy = row as Policy;
+  const binding = row as Binding;
+  return (
+    <ModalDialog
+      title={`${t('rr.edit')} · ${t(names[kind])}`}
+      isOpen
+      scrollBody
+      onOpenChange={open => {
+        if (!open && !model.busy) {
+          guard.clear();
+          close();
+        }
+      }}
+      footer={() => (
+        <Toolbar>
+          <Button
+            isDisabled={model.busy}
+            onPress={() => {
+              guard.clear();
+              close();
+            }}
+          >
+            {t('ui.cancel')}
+          </Button>
+          <Button accent isPending={model.busy} isDisabled={!row.name.trim() || stale} onPress={() => void save()}>
+            {t('rr.save')}
+          </Button>
+        </Toolbar>
+      )}
+    >
+      <fieldset disabled={model.busy} className="rr-list rr-fields">
+        <ErrorMessage error={localError ?? model.actionError} />
+        {stale && <p role="alert">{t('rr.stale')}</p>}
+        <Field label={t('rr.name')} value={row.name} onChange={name => patch({name})} disabled={model.busy} />
+        {kind === 'providers' && (
+          <>
+            <Select
+              label={t('rr.source')}
+              value={provider.source}
+              onChange={source => patch({source})}
+              items={[
+                {id: 'http', label: t('rr.url')},
+                {id: 'file', label: t('rr.file')},
+                {id: 'inline', label: t('rr.content')}
+              ]}
+            />
+            {provider.source === 'http' && (
+              <Field label={t('rr.url')} value={provider.url} onChange={url => patch({url})} placeholder={t('rr.sourceExample')} />
+            )}
+            {provider.source === 'inline' && (
+              <Field area label={t('rr.content')} value={provider.content} onChange={content => patch({content})} placeholder={t('rr.contentExample')} />
+            )}
+            {provider.source === 'file' && (
+              <>
+                <FileInput
+                  label={t('rr.file')}
+                  disabled={model.busy}
+                  onFile={async file => {
+                    try {
+                      if (file.size > 16 * 1024 * 1024) throw new Error(t('rr.fileLimit'));
+                      const bytes = new Uint8Array(await file.arrayBuffer());
+                      let raw = '';
+                      for (let i = 0; i < bytes.length; i += 8192) raw += String.fromCharCode(...bytes.subarray(i, i + 8192));
+                      setBase64(btoa(raw));
+                      setFileName(file.name);
+                    } catch (error) {
+                      setLocalError(error instanceof Error ? error : new Error(String(error)));
+                    }
+                  }}
+                />
+                <span className="rp-note">{fileName}</span>
+              </>
+            )}
+            <details className="rr-details">
+              <summary>{t('rr.advanced')}</summary>
+              <div className="rr-list">
+                <Grid>
+                  <Select
+                    label={t('rr.format')}
+                    value={provider.format}
+                    onChange={format => patch({format})}
+                    items={['auto', 'yaml', 'text', 'mrs'].map(id => ({id, label: id}))}
+                  />
+                  <Select
+                    label={t('rr.behavior')}
+                    value={provider.behavior}
+                    onChange={behavior => patch({behavior})}
+                    items={['auto', 'domain', 'ipcidr', 'classical'].map(id => ({id, label: id}))}
+                  />
+                  <Field
+                    type="number"
+                    min={300}
+                    max={2592000}
+                    label={t('rr.interval')}
+                    value={provider.interval}
+                    onChange={v => patch({interval: Number(v)})}
+                  />
+                  <OutboundSelect model={model} value={provider.outbound} onChange={outbound => patch({outbound})} />
+                </Grid>
+                <Field label={t('rr.sha256')} value={provider.expected_sha256} onChange={expected_sha256 => patch({expected_sha256})} />
+                <Field area label={t('rr.headers')} value={headers} onChange={setHeaders} hint={t('rr.headersHint')} />
+              </div>
+            </details>
+          </>
+        )}
+        {kind === 'resolvers' && (
+          <>
+            <Field label={t('rr.endpoint')} value={resolver.url} onChange={url => patch({url})} hint={t('rr.endpointHint')} />
+            <OutboundSelect model={model} value={resolver.outbound} onChange={outbound => patch({outbound})} />
+            <details className="rr-details">
+              <summary>{t('rr.advanced')}</summary>
+              <div className="rr-list">
+                <Field
+                  label={t('rr.bootstrapIps')}
+                  value={resolver.bootstrap.join(', ')}
+                  onChange={v => patch({bootstrap: lines(v)})}
+                  hint={t('rr.bootstrapHint')}
+                />
+                <Grid>
+                  <Field label={t('rr.tlsName')} value={resolver.tls_name} onChange={tls_name => patch({tls_name})} />
+                  <Field
+                    type="number"
+                    min={250}
+                    max={15000}
+                    label={t('rr.timeout')}
+                    value={resolver.timeout_ms}
+                    onChange={v => patch({timeout_ms: Number(v)})}
+                  />
+                </Grid>
+              </div>
+            </details>
+          </>
+        )}
+        {kind === 'pools' && (
+          <>
+            <Select
+              label={t('rr.strategy')}
+              value={pool.strategy}
+              onChange={strategy => patch({strategy})}
+              items={[
+                {id: 'fallback', label: t('rr.fallback')},
+                {id: 'race', label: t('rr.race')}
+              ]}
+            />
+            <p className="rp-note">{t('rr.poolHint')}</p>
+            {(model.data?.document.resolvers ?? []).map(r => (
+              <Check
+                key={r.id}
+                label={`${r.name} · ${r.outbound}`}
+                value={pool.members.includes(r.id)}
+                onChange={yes => patch({members: yes ? [...pool.members, r.id] : pool.members.filter(id => id !== r.id)})}
+              />
+            ))}
+            {pool.members.map((id, index) => (
+              <Toolbar key={id}>
+                <span>
+                  {index + 1}. {model.data?.document.resolvers.find(r => r.id === id)?.name}
+                </span>
+                {index > 0 && (
+                  <Button
+                    small
+                    quiet
+                    onPress={() => {
+                      const members = [...pool.members];
+                      [members[index - 1], members[index]] = [members[index], members[index - 1]];
+                      patch({members});
+                    }}
+                  >
+                    {t('rr.moveUp')}
+                  </Button>
+                )}
+              </Toolbar>
+            ))}
+          </>
+        )}
+        {(kind === 'policies' || kind === 'bindings') && (
+          <ConditionField
+            key={initial.id}
+            value={kind === 'policies' ? policy.condition : binding.condition}
+            onChange={condition => patch({condition})}
+            model={model}
+            dns={kind === 'policies'}
+          />
+        )}
+        {kind === 'policies' && (
+          <Grid>
+            <Select
+              label={t('rr.pools')}
+              value={policy.pool}
+              onChange={pool => patch({pool})}
+              items={[
+                {id: '', label: t('rr.choose')},
+                ...(model.data?.document.pools ?? []).map(p => ({id: p.id, label: p.name})),
+                {id: 'refused', label: 'REFUSED'},
+                {id: 'nxdomain', label: 'NXDOMAIN'},
+                {id: 'reject', label: 'NOERROR (empty)'},
+                {id: 'servfail', label: 'SERVFAIL'}
+              ]}
+            />
+            <Select
+              label={t('rr.addressMode')}
+              value={policy.address_mode}
+              onChange={address_mode => patch({address_mode})}
+              items={[
+                {id: 'inherit', label: t('rr.inherit')},
+                {id: 'real-ip', label: t('rr.real')},
+                {id: 'fake-ip', label: 'Fake-IP'}
+              ]}
+            />
+          </Grid>
+        )}
+        {kind === 'bindings' && <OutboundSelect model={model} value={binding.outbound} onChange={outbound => patch({outbound})} />}
+        <p className="rp-note">{t('rr.transactionHint')}</p>
+      </fieldset>
+    </ModalDialog>
+  );
+}
+
+function RemoveResource({kind, row, model, close}: {kind: ResourceKind; row: ResourceRow; model: RuntimeModel; close: () => void}) {
+  const t = useT();
+  const resourceKind = kind === 'providers' ? 'provider' : kind === 'resolvers' ? 'resolver' : 'pool';
+  const managed = ['providers', 'resolvers', 'pools'].includes(kind);
+  const references = useResource(
+    {
+      key: ['ruleReferences', {kind: resourceKind, id: row.id, revision: model.data?.revision}],
+      fetch: signal => runtime<{references: Reference[]}>('GET', `/references?kind=${resourceKind}&id=${row.id}`, undefined, signal)
+    },
+    {enabled: managed}
+  );
+  const [replacement, setReplacement] = useState('');
+  const [removeReferences, setRemoveReferences] = useState(false);
+  const rows = (model.data?.document[kind] ?? []).filter(r => r.id !== row.id);
+  const remove = async () => {
+    if (!model.data) return;
+    const result = managed
+      ? await model.write('remove', signal =>
+          runtime<RulesStatus>(
+            'POST',
+            '/remove',
+            {revision: model.data!.revision, kind: resourceKind, id: row.id, replacement: replacement || null, remove_references: removeReferences},
+            signal
+          )
+        )
+      : await model.save({...model.data.document, [kind]: rows});
+    if (result) close();
+  };
+  const refs = references.data?.references ?? [];
+  return (
+    <ModalDialog
+      title={`${t('rr.remove')} ${row.name}`}
+      isOpen
+      onOpenChange={open => {
+        if (!open && !model.busy) close();
+      }}
+      footer={() => (
+        <Toolbar>
+          <Button isDisabled={model.busy} onPress={close}>
+            {t('ui.cancel')}
+          </Button>
+          <Button
+            accent
+            isPending={model.busy}
+            isDisabled={managed && (!references.data || !!references.error || (refs.length > 0 && !replacement && !removeReferences))}
+            onPress={() => void remove()}
+          >
+            {t('rr.removeApply')}
+          </Button>
+        </Toolbar>
+      )}
+    >
+      <div className="rr-list">
+        <ErrorMessage error={references.error ?? model.actionError} />
+        <p>
+          {t('rr.references')} · {refs.length}
+        </p>
+        {refs.map((r, i) => (
+          <div key={i} className="rp-note">
+            {r.name ?? r.expression ?? r.scope}
+            {r.source_id ? ` · ${r.source_id}:${r.line ?? ''}` : ''}
+          </div>
+        ))}
+        {managed && (
+          <>
+            <Select
+              label={t('rr.replaceWith')}
+              value={replacement}
+              onChange={setReplacement}
+              items={[{id: '', label: t('rr.choose')}, ...rows.map(r => ({id: r.id, label: r.name}))]}
+            />
+            <Check label={t('rr.removeReferences')} value={removeReferences} onChange={setRemoveReferences} />
+          </>
+        )}
+        <p className="rp-note">{t('rr.transactionHint')}</p>
+      </div>
+    </ModalDialog>
+  );
+}
+function ProviderEntries({provider, close}: {provider: RuleProvider; close: () => void}) {
+  const t = useT();
+  const [search, setSearch] = useState('');
+  const [query, setQuery] = useState('');
+  const [offset, setOffset] = useState(0);
+  const resource = useResource({
+    key: ['ruleEntries', {id: provider.id, offset, query}],
+    fetch: signal =>
+      runtime<{entries: string[]; total: number}>('GET', `/entries?id=${provider.id}&offset=${offset}&q=${encodeURIComponent(query)}`, undefined, signal)
+  });
+  return (
+    <ModalDialog
+      title={provider.name}
+      isOpen
+      scrollBody
+      onOpenChange={open => {
+        if (!open) close();
+      }}
+    >
+      <div className="rr-list">
+        <Toolbar>
+          <Field label={t('rr.search')} value={search} onChange={setSearch} />
+          <Button
+            onPress={() => {
+              setQuery(search);
+              setOffset(0);
+            }}
+          >
+            {t('rr.search')}
+          </Button>
+        </Toolbar>
+        <ErrorMessage error={resource.error} onRetry={resource.refetch} />
+        <pre className="rr-entries">{resource.data?.entries.join('\n')}</pre>
+        <Toolbar>
+          <span className="rp-note">
+            {offset} · {resource.data?.total ?? 0}
+          </span>
+          <Button isDisabled={offset === 0} onPress={() => setOffset(Math.max(0, offset - 100))}>
+            {t('rr.previous')}
+          </Button>
+          <Button isDisabled={(resource.data?.entries.length ?? 0) < 100} onPress={() => setOffset(offset + 100)}>
+            {t('rr.next')}
+          </Button>
+        </Toolbar>
+      </div>
+    </ModalDialog>
+  );
+}
diff --git a/src/features/shared/resources/ResourceTrace.tsx b/src/features/shared/resources/ResourceTrace.tsx
new file mode 100644
