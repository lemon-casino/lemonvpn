+import {useState} from 'react';
+import {useT} from '../../../i18n';
+import {runtime, resourceId} from '../../../api/rulesRuntime';
+import {useResource} from '../../../store/resource';
+import {Badge, Button, Card, Empty, ErrorMessage, ModalDialog, Toolbar} from '../../../ui/ui';
+import {GeodataSettingsCard} from '../../settings/GeodataSettings';
+import {Field, OutboundSelect, RuntimeHeader, Select, useRulesRuntime} from './common';
+
+export function Geodata() {
+  const t = useT();
+  const model = useRulesRuntime();
+  const [kind, setKind] = useState('geosite');
+  const [search, setSearch] = useState('');
+  const [query, setQuery] = useState('');
+  const [offset, setOffset] = useState(0);
+  const [selected, setSelected] = useState('');
+  const [outbound, setOutbound] = useState('direct');
+  const [pool, setPool] = useState('');
+  const [addressMode, setAddressMode] = useState('inherit');
+  const entries = useResource({
+    key: ['geoCategories', {kind, query, offset, revision: model.data?.revision}],
+    fetch: signal =>
+      runtime<{sha256: string; categories: string[]; total: number}>(
+        'GET',
+        `/api/v1/geodata/categories?kind=${kind}&q=${encodeURIComponent(query)}&offset=${offset}`,
+        undefined,
+        signal
+      )
+  });
+  const details = useResource(
+    {
+      key: ['geoDetails', {kind, selected, revision: model.data?.revision}],
+      fetch: signal =>
+        runtime<{count: number; samples: string[]; references: {name: string; scope: string}[]}>(
+          'GET',
+          `/api/v1/geodata/categories/detail?kind=${kind}&id=${encodeURIComponent(selected)}`,
+          undefined,
+          signal
+        )
+    },
+    {enabled: !!selected}
+  );
+  const condition = `${kind === 'geosite' ? 'domain(geosite' : 'dip(geoip'}: ${JSON.stringify(selected)})`;
+  const create = async (dns: boolean) => {
+    if (!model.data) return;
+    const row = {id: resourceId(), name: `${kind} · ${selected}`, enabled: true, condition};
+    const document = dns
+      ? {...model.data.document, policies: [...model.data.document.policies, {...row, pool, address_mode: addressMode}]}
+      : {...model.data.document, bindings: [...model.data.document.bindings, {...row, outbound}]};
+    if (await model.save(document)) setSelected('');
+  };
+  return (
+    <div className="rr-list">
+      <GeodataSettingsCard managedHere />
+      <Card title={t('rr.geodata')}>
+        <RuntimeHeader model={model} />
+        <Toolbar>
+          <Select
+            label={t('rr.kind')}
+            value={kind}
+            onChange={v => {
+              setKind(v);
+              setOffset(0);
+              setSelected('');
+            }}
+            items={[
+              {id: 'geosite', label: 'GeoSite'},
+              {id: 'geoip', label: 'GeoIP'}
+            ]}
+          />
+          <Field label={t('rr.search')} value={search} onChange={setSearch} />
+          <Button
+            onPress={() => {
+              setQuery(search);
+              setOffset(0);
+            }}
+          >
+            {t('rr.search')}
+          </Button>
+        </Toolbar>
+        <ErrorMessage error={entries.error} onRetry={entries.refetch} />
+        <Toolbar>
+          {entries.data?.categories.map(name => (
+            <Button key={name} small quiet onPress={() => setSelected(name)}>
+              {name}
+            </Button>
+          ))}
+        </Toolbar>
+        {entries.data?.categories.length === 0 && <Empty>{t('rr.empty')}</Empty>}
+        <Toolbar>
+          <Badge>{entries.data?.total ?? 0}</Badge>
+          <span className="rp-note rr-version" title={entries.data?.sha256}>
+            {entries.data?.sha256}
+          </span>
+          <span className="rp-grow" />
+          <Button isDisabled={offset === 0} onPress={() => setOffset(Math.max(0, offset - 100))}>
+            {t('rr.previous')}
+          </Button>
+          <Button isDisabled={(entries.data?.categories.length ?? 0) < 100} onPress={() => setOffset(offset + 100)}>
+            {t('rr.next')}
+          </Button>
+        </Toolbar>
+      </Card>
+      {!!selected && (
+        <ModalDialog
+          title={`${kind} · ${selected}`}
+          isOpen
+          scrollBody
+          onOpenChange={open => {
+            if (!open && !model.busy) setSelected('');
+          }}
+        >
+          <div className="rr-list">
+            <ErrorMessage error={details.error ?? model.actionError} />
+            <p className="rp-note">
+              {t('rr.cacheEntries')} · {details.data?.count ?? '—'}
+            </p>
+            <pre className="rr-entries">{details.data?.samples.join('\n')}</pre>
+            <p>{t('rr.references')}</p>
+            {details.data?.references.map((r, i) => (
+              <p className="rp-note" key={i}>
+                {r.name} · {r.scope}
+              </p>
+            ))}
+            <OutboundSelect model={model} value={outbound} onChange={setOutbound} />
+            <Button isPending={model.busy} onPress={() => void create(false)}>
+              {t('rr.createRouting')}
+            </Button>
+            {kind === 'geosite' && (
+              <>
+                <Select
+                  label={t('rr.pools')}
+                  value={pool}
+                  onChange={setPool}
+                  items={[{id: '', label: t('rr.choose')}, ...(model.data?.document.pools ?? []).map(p => ({id: p.id, label: p.name}))]}
+                />
+                <Select
+                  label={t('rr.addressMode')}
+                  value={addressMode}
+                  onChange={setAddressMode}
+                  items={[
+                    {id: 'inherit', label: t('rr.inherit')},
+                    {id: 'real-ip', label: t('rr.real')},
+                    {id: 'fake-ip', label: 'Fake-IP'}
+                  ]}
+                />
+                <Button isPending={model.busy} isDisabled={!pool} onPress={() => void create(true)}>
+                  {t('rr.createDns')}
+                </Button>
+              </>
+            )}
+          </div>
+        </ModalDialog>
+      )}
+    </div>
+  );
+}
