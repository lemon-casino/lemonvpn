@@ -0,0 +1,70 @@
+import {useTabShown} from '../../../ui/useTabShown';
+import {useT} from '../../../i18n';
+import {useResource} from '../../../store/resource';
+import {useAction} from '../../../store/action';
+import {refetchAll} from '../../../store/resourceCore';
+import {Button, ErrorMessage, Toolbar, Badge, toast} from '../../../ui/ui';
+import {runtime, type RulesDocument, type RulesStatus} from '../../../api/rulesRuntime';
+import {Select} from '../../../ui/ResourceFields';
+import './resources.css';
+
+export function useRulesRuntime(enabled = true) {
+  const t = useT();
+  const shown = useTabShown();
+  const resource = useResource(
+    {key: ['rulesRuntime'], every: 30000, fetch: signal => runtime<RulesStatus>('GET', '', undefined, signal)},
+    {enabled, paused: !shown}
+  );
+  const action = useAction<string>({shared: 'rules-runtime'});
+  const write = async (kind: string, task: (signal: AbortSignal) => Promise<RulesStatus>) => {
+    const result = await action.run(kind, async signal => {
+      const result = await task(signal);
+      await refetchAll();
+      return result;
+    });
+    if (result) {
+      toast('positive', t('rr.applied'));
+    }
+    return result;
+  };
+  const save = (document: RulesDocument, revision = resource.data?.revision) =>
+    write('save', signal => runtime<RulesStatus>('PUT', '', {revision, document}, signal));
+  return {...resource, busy: !!action.busy, action: action.busy, actionError: action.error, write, save};
+}
+export type RuntimeModel = ReturnType<typeof useRulesRuntime>;
+export function RuntimeHeader({model}: {model: RuntimeModel}) {
+  const t = useT();
+  return (
+    <>
+      <Toolbar>
+        <Badge>{t('rr.live')}</Badge>
+        <span className="rp-note rr-version" title={model.data?.generation_id}>
+          {model.data?.generation_id}
+        </span>
+        <span className="rp-grow" />
+        <Button small isDisabled={model.busy} onPress={model.refetch}>
+          {t('ui.refresh')}
+        </Button>
+      </Toolbar>
+      <ErrorMessage error={model.error ?? model.actionError ?? (model.data?.error ? new Error(model.data.error) : null)} onRetry={model.refetch} />
+    </>
+  );
+}
+export {Field, Select, Check, Grid} from '../../../ui/ResourceFields';
+export function OutboundSelect({model, value, onChange}: {model: RuntimeModel; value: string; onChange: (value: string) => void}) {
+  const t = useT();
+  return (
+    <Select
+      label={t('rr.outbound')}
+      value={value}
+      onChange={onChange}
+      disabled={model.busy}
+      items={(model.data?.outbounds ?? []).filter(o => o.id !== 'block').map(o => ({id: o.id, label: o.id === 'direct' ? t('rr.direct') : o.id}))}
+    />
+  );
+}
+export const lines = (text: string) =>
+  text
+    .split(/[\r\n,]+/)
+    .map(s => s.trim())
+    .filter(Boolean);
