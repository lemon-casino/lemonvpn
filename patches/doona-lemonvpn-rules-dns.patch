@@ -0,0 +1,132 @@
+import {useRef, useState} from 'react';
+import {useT} from '../../../i18n';
+import {operation} from '../../../api/rulesRuntime';
+import {refetchAll} from '../../../store/resourceCore';
+import {presetInstalled, presetProvider, presetUrl, providerPresets, type ProviderPreset, type ProviderPresetSource} from '../../../dae/ruleProviderPresets';
+import {Badge, Button, Empty, ErrorMessage, ModalDialog, Toolbar} from '../../../ui/ui';
+import {Field, OutboundSelect, Select, type RuntimeModel} from './common';
+
+export function BuiltinProviders({model, close}: {model: RuntimeModel; close: () => void}) {
+  const t = useT();
+  const [search, setSearch] = useState('');
+  const [filter, setFilter] = useState('all');
+  const [source, setSource] = useState<ProviderPresetSource>('cdn');
+  const [outbound, setOutbound] = useState('direct');
+  const inflight = useRef(false);
+  const [error, setError] = useState<Error | null>(null);
+  const providers = model.data?.document.providers ?? [];
+  const query = search.trim().toLocaleLowerCase();
+  const visible = providerPresets.filter(
+    p => (filter === 'all' || p.group === filter) && `${t(p.label)} ${t(p.description)} ${p.category ?? ''}`.toLocaleLowerCase().includes(query)
+  );
+  const add = async (preset: ProviderPreset) => {
+    if (!model.data || model.busy || inflight.current || presetInstalled(preset, providers)) return;
+    inflight.current = true;
+    setError(null);
+    if (providers.length >= 64) {
+      setError(new Error(t('rr.builtinLimit')));
+      inflight.current = false;
+      return;
+    }
+    const provider = presetProvider(preset, t(preset.label), source, outbound);
+    const before = model.data;
+    if (before.document.providers.some(p => p.name === provider.name)) {
+      setError(new Error(t('rr.builtinNameTaken', {name: provider.name})));
+      inflight.current = false;
+      return;
+    }
+    try {
+      if (preset.content) await model.save({...before.document, providers: [...before.document.providers, provider]}, before.revision);
+      else await model.write(`builtin:${preset.id}`, signal => operation('/import', {revision: before.revision, provider}, signal));
+    } finally {
+      try {
+        await refetchAll();
+      } finally {
+        inflight.current = false;
+      }
+    }
+  };
+  return (
+    <ModalDialog
+      title={t('rr.builtin')}
+      isOpen
+      size="wide"
+      locked={model.busy}
+      scrollBody
+      onOpenChange={open => {
+        if (!open && !model.busy) close();
+      }}
+      footer={() => (
+        <Toolbar>
+          <span className="rp-note rp-grow">{t('rr.builtinUsage')}</span>
+          <Button isDisabled={model.busy} onPress={close}>
+            {t('ui.close')}
+          </Button>
+        </Toolbar>
+      )}
+    >
+      <div className="rr-list">
+        <p className="rp-note">{t('rr.builtinHelp')}</p>
+        <div className="rr-grid">
+          <Field label={t('rr.search')} value={search} onChange={setSearch} />
+          <Select
+            label={t('rr.builtinCategory')}
+            value={filter}
+            onChange={setFilter}
+            items={[
+              {id: 'all', label: t('rr.builtinAll')},
+              {id: 'local', label: t('rr.builtinLocal')},
+              {id: 'region', label: t('rr.builtinRegion')},
+              {id: 'service', label: t('rr.builtinService')}
+            ]}
+          />
+        </div>
+        <div className="rr-grid">
+          <Select
+            label={t('rr.builtinSource')}
+            value={source}
+            onChange={v => setSource(v as ProviderPresetSource)}
+            disabled={model.busy}
+            items={[
+              {id: 'cdn', label: t('rr.builtinCdn')},
+              {id: 'github', label: t('rr.builtinGithubSource')}
+            ]}
+          />
+          <OutboundSelect model={model} value={outbound} onChange={setOutbound} />
+        </div>
+        <p className="rp-note">{t('rr.builtinDownloadHelp')}</p>
+        <ErrorMessage error={error ?? model.actionError} />
+        <div className="rr-builtin-grid">
+          {visible.map(preset => {
+            const installed = presetInstalled(preset, providers);
+            return (
+              <section className="rr-builtin-item" key={preset.id}>
+                <div className="rp-cluster">
+                  <strong>{t(preset.label)}</strong>
+                  <span className="rp-grow" />
+                  <Badge>{t(preset.content ? 'rr.builtinOffline' : 'rr.builtinOnline')}</Badge>
+                </div>
+                <p className="rp-note">{t(preset.description)}</p>
+                <div className="rp-cluster rr-builtin-bottom">
+                  <span className="rp-note">{t(preset.behavior === 'domain' ? 'rr.builtinDomain' : 'rr.builtinIp')}</span>
+                  <span className="rp-grow" />
+                  <Button
+                    small
+                    isDisabled={installed || !model.data || model.busy}
+                    isPending={model.action === `builtin:${preset.id}`}
+                    label={t(installed ? 'rr.builtinInstalledLabel' : 'rr.builtinAddLabel', {name: t(preset.label)})}
+                    onPress={() => void add(preset)}
+                  >
+                    {t(installed ? 'rr.builtinInstalled' : 'rr.add')}
+                  </Button>
+                </div>
+                {!installed && preset.category && <p className="rp-note rr-builtin-source">{presetUrl(preset, source)}</p>}
+              </section>
+            );
+          })}
+        </div>
+        {!visible.length && <Empty>{t('rr.builtinNoMatch')}</Empty>}
+      </div>
+    </ModalDialog>
+  );
+}
diff --git a/src/features/shared/resources/DnsWorkspace.tsx b/src/features/shared/resources/DnsWorkspace.tsx
