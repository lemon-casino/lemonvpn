+import {useState} from 'react';
+import {runtime, resourceId, type RulesDocument} from '../../../api/rulesRuntime';
+import {useT} from '../../../i18n';
+import {useDraftGuard} from '../../../shell/draft';
+import {useResource} from '../../../store/resource';
+import {useAction} from '../../../store/action';
+import {Button, Card, ErrorMessage, ModalDialog, Toolbar, Badge, Empty, Link} from '../../../ui/ui';
+import {href} from '../../../shell/route';
+import {ResourceManager} from './ResourceManager';
+import {Check, Field, Grid, lines, OutboundSelect, RuntimeHeader, useRulesRuntime} from './common';
+
+type DnsStatistics = {
+  cache: {entries: number; bytes: number; pending: number; hits: number; misses: number; coalesced: number; stale: number};
+  transport: {endpoints: {id: string; queries: number; failures: number; p50_ms: number | null; p95_ms: number | null; last_error: string | null}[]};
+};
+export function DnsUpstreams() {
+  return (
+    <div className="rr-list">
+      <ResourceManager kind="resolvers" />
+      <ResourceManager kind="pools" />
+      <BootstrapSettings />
+      <DnsLiveStats />
+    </div>
+  );
+}
+export function DnsPolicies() {
+  const t = useT();
+  const [preset, setPreset] = useState(false);
+  return (
+    <div className="rr-list">
+      <Toolbar>
+        <span className="rp-note rp-grow">{t('rr.policyPriority')}</span>
+        <Button onPress={() => setPreset(true)}>{t('rr.preset')}</Button>
+      </Toolbar>
+      <ResourceManager kind="policies" />
+      {preset && <PresetEditor close={() => setPreset(false)} />}
+    </div>
+  );
+}
+function PresetEditor({close}: {close: () => void}) {
+  const t = useT();
+  const model = useRulesRuntime();
+  const [outbound, setOutbound] = useState('direct');
+  const [routing, setRouting] = useState(false);
+  const [domestic, setDomestic] = useState('https://dns.alidns.com/dns-query');
+  const [foreign, setForeign] = useState('https://cloudflare-dns.com/dns-query');
+  const apply = async () => {
+    if (!model.data) return;
+    const old = model.data.document;
+    const cn = resourceId(),
+      remote = resourceId(),
+      localPool = resourceId(),
+      remotePool = resourceId();
+    const document: RulesDocument = {
+      ...old,
+      resolvers: [
+        ...old.resolvers,
+        {id: cn, name: t('rr.domestic'), url: domestic, outbound: 'direct', bootstrap: ['223.5.5.5'], tls_name: '', timeout_ms: 3000},
+        {id: remote, name: t('rr.foreign'), url: foreign, outbound, bootstrap: ['1.1.1.1', '2606:4700:4700::1111'], tls_name: '', timeout_ms: 5000}
+      ],
+      pools: [
+        ...old.pools,
+        {id: localPool, name: t('rr.domestic'), members: [cn], strategy: 'fallback'},
+        {id: remotePool, name: t('rr.foreign'), members: [remote], strategy: 'fallback'}
+      ],
+      policies: [
+        ...old.policies,
+        {
+          id: resourceId(),
+          name: t('rr.local'),
+          enabled: true,
+          condition: 'domain(suffix: local, suffix: lan, full: localhost)',
+          pool: localPool,
+          address_mode: 'real-ip'
+        },
+        {id: resourceId(), name: t('rr.domestic'), enabled: true, condition: 'domain(geosite: cn)', pool: localPool, address_mode: 'real-ip'},
+        {id: resourceId(), name: t('rr.foreign'), enabled: true, condition: 'domain(regex: ".*")', pool: remotePool, address_mode: 'fake-ip'}
+      ],
+      bindings: routing
+        ? [
+            ...old.bindings,
+            {id: resourceId(), name: t('rr.domestic'), enabled: true, condition: 'domain(geosite: cn)', outbound: 'direct'},
+            {id: resourceId(), name: t('rr.foreign'), enabled: true, condition: 'domain(regex: ".*")', outbound}
+          ]
+        : old.bindings
+    };
+    if (await model.save(document)) close();
+  };
+  return (
+    <ModalDialog
+      title={t('rr.preset')}
+      isOpen
+      scrollBody
+      onOpenChange={open => {
+        if (!open && !model.busy) close();
+      }}
+      footer={() => (
+        <Toolbar>
+          <Button isDisabled={model.busy} onPress={close}>
+            {t('ui.cancel')}
+          </Button>
+          <Button accent isPending={model.busy} isDisabled={!model.data || outbound === 'direct'} onPress={() => void apply()}>
+            {t('rr.save')}
+          </Button>
+        </Toolbar>
+      )}
+    >
+      <div className="rr-list">
+        <ErrorMessage error={model.actionError} />
+        <p className="rp-note">{t('rr.presetHint')}</p>
+        <Grid>
+          <Field label={t('rr.domestic')} value={domestic} onChange={setDomestic} />
+          <Field label={t('rr.foreign')} value={foreign} onChange={setForeign} />
+        </Grid>
+        <OutboundSelect model={model} value={outbound} onChange={setOutbound} />
+        <Check label={t('rr.presetRouting')} value={routing} onChange={setRouting} />
+        <ol>
+          <li>
+            {t('rr.local')} → {t('rr.domestic')} · {t('rr.real')}
+          </li>
+          <li>
+            {t('rr.geoCn')} → {t('rr.domestic')} · {t('rr.real')}
+          </li>
+          <li>
+            {t('rr.otherDomains')} → {t('rr.foreign')} · {t('rr.fakeIp')}
+          </li>
+        </ol>
+        <p className="rp-note">{t('rr.presetMissingGeo')}</p>
+      </div>
+    </ModalDialog>
+  );
+}
+function BootstrapSettings() {
+  const t = useT();
+  const model = useRulesRuntime();
+  const [draft, setDraft] = useState<{revision: string; text: string} | null>(null);
+  const dirty = !!draft && draft.text !== model.data?.document.bootstrap.join('\n');
+  const guard = useDraftGuard(dirty, () => setDraft(null), 'rr.bootstrap');
+  return (
+    <Card title={t('rr.bootstrap')}>
+      <div className="rr-list">
+        <ErrorMessage error={model.error ?? model.actionError} />
+        <Field
+          area
+          label={t('rr.bootstrap')}
+          value={draft?.text ?? model.data?.document.bootstrap.join('\n') ?? ''}
+          onChange={text => {
+            if (model.data) setDraft({revision: draft?.revision ?? model.data.revision, text});
+          }}
+          hint={t('rr.bootstrapIndependent')}
+        />
+        <Toolbar>
+          <Button
+            accent
+            isPending={model.busy}
+            isDisabled={!dirty || draft?.revision !== model.data?.revision}
+            onPress={async () => {
+              if (model.data && draft && (await model.save({...model.data.document, bootstrap: lines(draft.text)}, draft.revision))) {
+                guard.clear();
+                setDraft(null);
+              }
+            }}
+          >
+            {t('rr.save')}
+          </Button>
+          <Button isDisabled={model.busy || !dirty} onPress={() => setDraft(null)}>
+            {t('ui.cancel')}
+          </Button>
+        </Toolbar>
+      </div>
+    </Card>
+  );
+}
+export function DnsLiveStats() {
+  const t = useT();
+  const model = useRulesRuntime();
+  const stats = useResource({key: ['dnsWireStats'], every: 10000, fetch: signal => runtime<DnsStatistics>('GET', '/api/v1/dns/statistics', undefined, signal)});
+  const cache = stats.data?.cache;
+  return (
+    <Card title={t('rr.actualStats')}>
+      <div className="rr-list">
+        <ErrorMessage error={stats.error} onRetry={stats.refetch} />
+        {cache && (
+          <Toolbar>
+            <Badge>
+              {t('rr.hits')} {cache.hits}
+            </Badge>
+            <Badge>
+              {t('rr.misses')} {cache.misses}
+            </Badge>
+            <Badge>
+              {t('rr.coalesced')} {cache.coalesced}
+            </Badge>
+            <Badge>
+              {t('rr.cacheEntries')} {cache.entries}
+            </Badge>
+            <span className="rp-note">
+              {(cache.bytes / 1048576).toFixed(2)} {t('rr.mb')} · {t('rr.pending')} {cache.pending} · {t('rr.staleReplies')} {cache.stale}
+            </span>
+          </Toolbar>
+        )}
+        <div className="rr-scroll">
+          <table className="rr-table">
+            <thead>
+              <tr>
+                <th>{t('rr.resolvers')}</th>
+                <th>{t('rr.queries')}</th>
+                <th>{t('rr.failures')}</th>
+                <th>P50 / P95</th>
+              </tr>
+            </thead>
+            <tbody>
+              {stats.data?.transport.endpoints.map(row => (
+                <tr key={row.id}>
+                  <td>
+                    {model.data?.document.resolvers.find(r => r.id === row.id)?.name ?? row.id}
+                    {row.last_error && <p className="rp-note">{row.last_error}</p>}
+                  </td>
+                  <td>{row.queries}</td>
+                  <td>{row.failures}</td>
+                  <td>
+                    {row.p50_ms ?? '—'} / {row.p95_ms ?? '—'} {t('rr.ms')}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+        <p className="rp-note">{t('rr.statsScope')}</p>
+      </div>
+    </Card>
+  );
+}
+export function WireCache() {
+  const t = useT();
+  const model = useRulesRuntime();
+  const action = useAction<string>({shared: 'dns-cache'});
+  const entries = useResource({
+    key: ['dnsWireCache'],
+    every: 10000,
+    fetch: signal =>
+      runtime<{entries: {domain: string; pool: string; negative: boolean; ttl_seconds: number; hits: number; bytes: number}[]}>(
+        'GET',
+        '/api/v1/dns/wire-cache',
+        undefined,
+        signal
+      )
+  });
+  const [draft, setDraft] = useState<{revision: string; document: RulesDocument} | null>(null);
+  const options = draft?.document.cache ?? model.data?.document.cache;
+  const edit = (change: object) => {
+    if (model.data && options)
+      setDraft({revision: draft?.revision ?? model.data.revision, document: {...(draft?.document ?? model.data.document), cache: {...options, ...change}}});
+  };
+  const guard = useDraftGuard(!!draft, () => setDraft(null), 'rr.cacheOptions');
+  const clear = async (domain?: string) => {
+    const result = await action.run('clear', signal => runtime<{removed: number}>('DELETE', '/api/v1/dns/wire-cache', {domain: domain ?? null}, signal));
+    if (result) {
+      entries.refetch();
+    }
+  };
+  return (
+    <div className="rr-list">
+      <Card title={t('rr.cacheOptions')}>
+        <RuntimeHeader model={model} />
+        {options && (
+          <div className="rr-list">
+            <Grid>
+              <Field type="number" label={t('rr.capacity')} min={64} max={20000} value={options.capacity} onChange={v => edit({capacity: Number(v)})} />
+              <Field
+                type="number"
+                label={t('rr.maxMemory')}
+                min={1}
+                max={64}
+                value={options.max_bytes / 1048576}
+                onChange={v => edit({max_bytes: Number(v) * 1048576})}
+              />
+              <Field
+                type="number"
+                label={t('rr.staleSeconds')}
+                min={0}
+                max={300}
+                value={options.stale_seconds}
+                onChange={v => edit({stale_seconds: Number(v)})}
+              />
+            </Grid>
+            <Toolbar>
+              <Check label={t('rr.negativeCache')} value={options.negative} onChange={negative => edit({negative})} />
+              <Check label={t('rr.prefetch')} value={options.prefetch} onChange={prefetch => edit({prefetch})} />
+            </Toolbar>
+            <p className="rp-note">{t('rr.cacheHint')}</p>
+            <Toolbar>
+              <Button
+                accent
+                isPending={model.busy}
+                isDisabled={!draft || draft.revision !== model.data?.revision}
+                onPress={async () => {
+                  if (draft && (await model.save(draft.document, draft.revision))) {
+                    guard.clear();
+                    setDraft(null);
+                  }
+                }}
+              >
+                {t('rr.save')}
+              </Button>
+              <Button isDisabled={model.busy || !draft} onPress={() => setDraft(null)}>
+                {t('ui.cancel')}
+              </Button>
+            </Toolbar>
+          </div>
+        )}
+      </Card>
+      <Card title={t('rr.realCache')}>
+        <div className="rr-list">
+          <ErrorMessage error={entries.error ?? action.error} onRetry={entries.refetch} />
+          <Toolbar>
+            <span className="rp-note rp-grow">{t('rr.first100')}</span>
+            <Button isPending={!!action.busy} onPress={() => void clear()}>
+              {t('rr.clearRealCache')}
+            </Button>
+          </Toolbar>
+          <div className="rr-scroll">
+            <table className="rr-table">
+              <thead>
+                <tr>
+                  <th>{t('ui.domain')}</th>
+                  <th>{t('rr.pools')}</th>
+                  <th>{t('rr.kind')}</th>
+                  <th>{t('rr.ttl')}</th>
+                  <th>{t('ui.actions')}</th>
+                </tr>
+              </thead>
+              <tbody>
+                {entries.data?.entries.map((row, i) => (
+                  <tr key={`${row.domain}:${i}`}>
+                    <td>{row.domain}</td>
+                    <td>{model.data?.document.pools.find(p => p.id === row.pool)?.name ?? row.pool}</td>
+                    <td>{t(row.negative ? 'rr.negative' : 'rr.positive')}</td>
+                    <td>{row.ttl_seconds}s</td>
+                    <td>
+                      <Button small quiet isDisabled={!!action.busy} onPress={() => void clear(row.domain)}>
+                        {t('rr.remove')}
+                      </Button>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        </div>
+      </Card>
+      <FakeIpPolicySummary />
+      <DnsLiveStats />
+    </div>
+  );
+}
+export function FakeIpPolicySummary() {
+  const t = useT();
+  const model = useRulesRuntime();
+  const rows = model.data?.document.policies.filter(p => p.enabled && p.address_mode !== 'inherit') ?? [];
+  const action = useAction<string>({shared: 'dns-cache'});
+  const [confirm, setConfirm] = useState(false);
+  return (
+    <Card title={t('rr.fakeIpLink')}>
+      <div className="rr-list">
+        <ErrorMessage error={action.error} />
+        <p className="rp-note">{t('rr.fakeIpHint')}</p>
+        {rows.map(row => (
+          <div className="rr-item" key={row.id}>
+            <div className="rr-main">
+              <strong>{row.name}</strong>
+              <p className="rp-note">{row.condition}</p>
+            </div>
+            <Badge>{row.address_mode}</Badge>
+          </div>
+        ))}
+        {!rows.length && <Empty>{t('rr.noAddressPolicy')}</Empty>}
+        <Toolbar>
+          <Link href={href('dns', {tab: 'policies'})}>{t('rr.editPolicies')}</Link>
+          <Button isDisabled={!!action.busy} onPress={() => setConfirm(true)}>
+            {t('rr.clearMappings')}
+          </Button>
+        </Toolbar>
+        <p className="rp-note">{t('rr.mappingScope')}</p>
+      </div>
+      {confirm && (
+        <ModalDialog
+          title={t('rr.clearMappings')}
+          isOpen
+          onOpenChange={setConfirm}
+          footer={() => (
+            <Toolbar>
+              <Button onPress={() => setConfirm(false)}>{t('ui.cancel')}</Button>
+              <Button
+                accent
+                isPending={!!action.busy}
+                onPress={async () => {
+                  if (await action.run('fakeip', signal => runtime('POST', '/api/v1/dns/wire-cache/fakeip/flush', {}, signal))) setConfirm(false);
+                }}
+              >
+                {t('rr.clearMappings')}
+              </Button>
+            </Toolbar>
+          )}
+        >
+          <p>{t('rr.clearMappingsHint')}</p>
+          <ErrorMessage error={action.error} />
+        </ModalDialog>
+      )}
+    </Card>
+  );
+}
