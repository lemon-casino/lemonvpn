new file mode 100644
--- /dev/null
+++ b/src/api/rulesRuntime.ts
@@ -0,0 +1,88 @@
+import {uuid} from './hash';
+import {getApi} from './index';
+import type {OperationAccepted} from './model';
+
+export type RuleProvider = {
+  id: string;
+  name: string;
+  enabled: boolean;
+  source: string;
+  url: string;
+  content: string;
+  format: string;
+  behavior: string;
+  interval: number;
+  outbound: string;
+  expected_sha256: string;
+  accepted_sha256: string;
+  updated_at: number;
+  etag: string;
+  last_modified: string;
+  headers: Record<string, string>;
+};
+export type Resolver = {id: string; name: string; url: string; outbound: string; bootstrap: string[]; tls_name: string; timeout_ms: number};
+export type Pool = {id: string; name: string; members: string[]; strategy: string};
+export type Policy = {id: string; name: string; enabled: boolean; condition: string; pool: string; address_mode: string};
+export type Binding = {id: string; name: string; enabled: boolean; condition: string; outbound: string};
+export type CacheOptions = {capacity: number; max_bytes: number; negative: boolean; stale_seconds: number; prefetch: boolean};
+export type RulesDocument = {
+  schema: number;
+  providers: RuleProvider[];
+  resolvers: Resolver[];
+  pools: Pool[];
+  policies: Policy[];
+  bindings: Binding[];
+  cache: CacheOptions;
+  bootstrap: string[];
+};
+export type ResourceKind = 'providers' | 'resolvers' | 'pools' | 'policies' | 'bindings';
+export type ResourceRow = RuleProvider | Resolver | Pool | Policy | Binding;
+export type RulesStatus = {
+  revision: string;
+  generation_id: string;
+  document: RulesDocument;
+  error: string | null;
+  resources: {id: string; sha256: string; count: number; ref_count: number; format: string; behavior: string; domain_only: boolean; fakeip: boolean}[];
+  updates: Record<string, {state: string; message?: string}>;
+  outbounds: {id: string; kind: string}[];
+};
+export type Reference = {scope: string; id?: string; name?: string; source_id?: string; line?: number; expression?: string};
+export function runtime<T>(method: 'GET' | 'POST' | 'PUT' | 'DELETE', path = '', body?: unknown, signal?: AbortSignal): Promise<T> {
+  const api = getApi();
+  if (!api.rulesRuntime) return Promise.reject(new Error('Rule resources unavailable'));
+  return api.rulesRuntime<T>(method, path.startsWith('/api/') ? path : '/api/v1/rules/runtime' + path, body, signal);
+}
+export async function operation(path: string, body: unknown, signal?: AbortSignal) {
+  const accepted = await runtime<Omit<OperationAccepted, 'retryAfter'>>('POST', path, body, signal);
+  const result = await getApi().pollOperation({...accepted, retryAfter: 1}, signal);
+  if (result.status !== 'succeeded') throw new Error(result.error?.message ?? result.status);
+  return runtime<RulesStatus>('GET', '', undefined, signal);
+}
+export const resourceId = () => 'r_' + uuid().replaceAll('-', '');
+export const newProvider = (): RuleProvider => ({
+  id: resourceId(),
+  name: '',
+  enabled: true,
+  source: 'http',
+  url: '',
+  content: '',
+  format: 'auto',
+  behavior: 'auto',
+  interval: 86400,
+  outbound: 'direct',
+  expected_sha256: '',
+  accepted_sha256: '',
+  updated_at: 0,
+  etag: '',
+  last_modified: '',
+  headers: {}
+});
+export function sourceLabel(provider: RuleProvider): string {
+  if (provider.source !== 'http') return provider.source;
+  try {
+    const url = new URL(provider.url);
+    return url.origin + url.pathname;
+  } catch {
+    return 'HTTP';
+  }
+}
