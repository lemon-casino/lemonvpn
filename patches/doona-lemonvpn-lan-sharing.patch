diff --git a/src/features/settings/LanSettings.tsx b/src/features/settings/LanSettings.tsx
new file mode 100644
--- /dev/null
+++ b/src/features/settings/LanSettings.tsx
@@ -0,0 +1,174 @@
+import {useState} from 'react';
+import {getApi} from '../../api';
+import type {LanSettings, LanStatus} from '../../api/api';
+import {useCapabilities} from '../../store';
+import {lanAvailable} from '../../store/desktop';
+import {useResource} from '../../store/resource';
+import {useAction} from '../../store/action';
+import {useDraftGuard} from '../../shell/draft';
+import {useT} from '../../i18n';
+import {copyText} from '../shared/copy';
+import {Badge, Button, Card, Empty, ErrorMessage, Form, InlineAlert, LabeledSelect, Switch, TextField, Toolbar, toast} from '../../ui/ui';
+import '../../ui/styles/lan-settings.css';
+
+type Draft = {revision: string; settings: LanSettings; port: string};
+const validCredential = (value: string) => /^[\x21-\x7e]{1,128}$/.test(value);
+export function LanSettingsCard() {
+  const t = useT();
+  const api = getApi();
+  const capabilities = useCapabilities();
+  const enabled = lanAvailable(capabilities.data?.resources) && !!api.lanSettings;
+  const resource = useResource({key: ['lanSettings'], every: 10000, fetch: signal => api.lanSettings!(signal)}, {enabled});
+  const action = useAction<'save'>({shared: 'lan-settings'});
+  const [draft, setDraft] = useState<Draft | null>(null);
+  const [written, setWritten] = useState<LanStatus | null>(null);
+  const [lastRead, setLastRead] = useState(resource.data);
+  if (lastRead !== resource.data) {
+    setLastRead(resource.data);
+    setWritten(null);
+  }
+  const [showPassword, setShowPassword] = useState(false);
+  const data = written ?? resource.data;
+  const settings = draft?.settings ?? data?.settings;
+  const endpoints = data?.addresses.filter(entry => data.settings.bind_address === '0.0.0.0' || entry.address === data.settings.bind_address) ?? [];
+  const port = draft?.port ?? String(settings?.port ?? 18081);
+  const dirty = !!draft && !!data && (JSON.stringify(draft.settings) !== JSON.stringify(data.settings) || port !== String(data.settings.port));
+  const stale = !!draft && !!data && draft.revision !== data.revision;
+  const guard = useDraftGuard(dirty, () => setDraft(null), 'lan.title');
+  const busy = !!action.busy;
+  const edit = (change: Partial<LanSettings>, nextPort?: string) => {
+    if (!settings || !data) return;
+    setDraft({revision: draft?.revision ?? data.revision, settings: {...settings, ...change}, port: nextPort ?? port});
+  };
+  const portError = !/^\d+$/.test(port) || Number(port) < 1024 || Number(port) > 65535;
+  const auth = settings?.authentication;
+  const authError = !!auth && (!validCredential(auth.username) || auth.username.includes(':') || !validCredential(auth.password));
+  const save = async () => {
+    if (!settings || !data || !api.setLanSettings || busy || stale || portError || authError) return;
+    const result = await action.run('save', signal => api.setLanSettings!(draft?.revision ?? data.revision, {...settings, port: Number(port)}, signal));
+    if (result) {
+      setWritten(result);
+      setDraft(null);
+      guard.clear();
+      resource.refetch();
+      toast('positive', t(result.active ? 'lan.applied' : 'lan.disabled'));
+    }
+  };
+  const copy = async (text: string) => {
+    const copied = await copyText(text);
+    toast(copied ? 'positive' : 'negative', t(copied ? 'lan.copied' : 'lan.copyFailed'));
+  };
+  if (!enabled) return null;
+  const choices = [
+    {id: '0.0.0.0', label: t('lan.allInterfaces')},
+    ...(data?.addresses ?? []).map(entry => ({id: entry.address, label: `${entry.address} · ${entry.interface}`}))
+  ];
+  if (settings && !choices.some(choice => choice.id === settings.bind_address)) choices.push({id: settings.bind_address, label: settings.bind_address});
+  return (
+    <Card level={2} title={t('lan.title')} titleId="settings-lan" note={t('lan.scope')}>
+      <ErrorMessage error={resource.error ?? action.error} onRetry={resource.refetch} />
+      {!settings || !data ? (
+        <Empty>{t('ui.loading')}</Empty>
+      ) : (
+        <Form
+          className="rp-lan-form"
+          onSubmit={event => {
+            event.preventDefault();
+            void save();
+          }}
+        >
+          <Toolbar>
+            <Switch isSelected={settings.enabled} isDisabled={busy} onChange={enabled => edit({enabled})}>
+              {t('lan.enable')}
+            </Switch>
+            <Badge>{t(data.active ? 'lan.active' : 'lan.inactive')}</Badge>
+          </Toolbar>
+          <div className="rp-lan-grid">
+            <LabeledSelect
+              label={t('lan.bind')}
+              value={settings.bind_address}
+              items={choices}
+              onChange={bind_address => edit({bind_address})}
+              isDisabled={busy}
+            />
+            <TextField
+              label={t('lan.port')}
+              value={port}
+              onChange={value => edit({}, value)}
+              error={portError ? t('lan.portError') : undefined}
+              isDisabled={busy}
+            />
+          </div>
+          <Switch
+            isSelected={!!auth}
+            isDisabled={busy}
+            onChange={selected => edit({authentication: selected ? {username: '', password: ''} : null})}
+            description={t('lan.authHelp')}
+          >
+            {t('lan.authentication')}
+          </Switch>
+          {auth && (
+            <div className="rp-lan-grid">
+              <TextField
+                label={t('lan.username')}
+                value={auth.username}
+                autoComplete="off"
+                onChange={username => edit({authentication: {...auth, username}})}
+                isDisabled={busy}
+              />
+              <TextField
+                label={t('lan.password')}
+                value={auth.password}
+                autoComplete="new-password"
+                type={showPassword ? 'text' : 'password'}
+                reveal={{shown: showPassword, label: t('lan.reveal'), onToggle: () => setShowPassword(value => !value)}}
+                onChange={password => edit({authentication: {...auth, password}})}
+                isDisabled={busy}
+              />
+            </div>
+          )}
+          {authError && <p className="rp-note">{t('lan.authError')}</p>}
+          {data.error && <InlineAlert tone="negative">{data.error}</InlineAlert>}
+          {stale && <InlineAlert>{t('lan.conflict')}</InlineAlert>}
+          <Toolbar>
+            <Button accent type="submit" isPending={busy} isDisabled={(!dirty && !(settings.enabled && !data.active)) || stale || portError || authError}>
+              {t('lan.apply')}
+            </Button>
+            <Button
+              isDisabled={busy}
+              onPress={() => {
+                setDraft(null);
+                guard.clear();
+                resource.refetch();
+              }}
+            >
+              {t('lan.reload')}
+            </Button>
+          </Toolbar>
+          {data.active && (
+            <section className="rp-lan-addresses" aria-label={t('lan.devices')}>
+              <strong>{t('lan.devices')}</strong>
+              <p className="rp-note">{t('lan.deviceHelp')}</p>
+              {endpoints.map(entry => (
+                <div key={entry.address} className="rp-lan-address">
+                  <div className="rp-lan-endpoint">
+                    <strong>
+                      {entry.address}:{data.settings.port}
+                    </strong>
+                    <span className="rp-note">{entry.interface}</span>
+                  </div>
+                  <Button onPress={() => void copy(`http://${entry.address}:${data.settings.port}`)}>{t('lan.copyHttp')}</Button>
+                  <Button onPress={() => void copy(`socks5://${entry.address}:${data.settings.port}`)}>{t('lan.copySocks')}</Button>
+                </div>
+              ))}
+              {!endpoints.length && <Empty>{t('lan.noAddress')}</Empty>}
+              {data.address_error && <InlineAlert>{data.address_error}</InlineAlert>}
+              <p className="rp-note">{t(data.settings.authentication ? 'lan.credentialsNeeded' : 'lan.noAuthentication')}</p>
+            </section>
+          )}
+          <p className="rp-note">{t('lan.firewall')}</p>
+        </Form>
+      )}
+    </Card>
+  );
+}
