diff --git a/src/api/engines/lemonvpn.ts b/src/api/engines/lemonvpn.ts
new file mode 100644
index 00000000..cd1b40d6
--- /dev/null
+++ b/src/api/engines/lemonvpn.ts
@@ -0,0 +1,20 @@
+import type {Engine} from './types';
+
+// LemonVPN's engine serves the native API and reads the same configuration text
+// honk does, so the pages that read or write that text apply. It implements none of honk's
+// other extensions, so those stay off: no global settings, no restart command,
+// no node links, no redacted sections and no hook states it cannot check.
+export const lemonvpn: Engine = {
+  id: 'lemonvpn',
+  flowDemandGraceSeconds: null,
+  reason: () => undefined,
+  holdsCredentials: () => false,
+  snippet: settings => settings.map(({key, value}) => `${key}: ${value}`).join('\n'),
+  redactedSections: () => [],
+  daeText: true,
+  nodeLinkSchemes: null,
+  globalSettings: null,
+  restartOnly: [],
+  restartCommand: null,
+  uncheckedHooks: []
+};
