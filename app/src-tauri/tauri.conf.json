{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LemonVPN",
  "version": "0.1.34",
  "identifier": "org.lemonvpn.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/prepare-branding.mjs",
    "beforeBuildCommand": "node scripts/prepare.mjs"
  },
  "app": {
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/lemonvpn-engine-stub"
    ]
  }
}
