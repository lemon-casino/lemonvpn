# Copy to .env next to the compose file.
LEMONVPN_IMAGE=ghcr.io/lemon-casino/lemonvpn:latest

# Web UI login. Empty means a random password is generated once and stored in
# ./data/ui-password; read it with: docker logs lemonvpn | grep "Web UI"
LEMONVPN_UI_USERNAME=admin
LEMONVPN_UI_PASSWORD=

# LAN proxy credentials. Empty means random credentials are generated once and
# stored in ./data/lan-settings.json.
LEMONVPN_LAN_USERNAME=lemonvpn
LEMONVPN_LAN_PASSWORD=
LEMONVPN_LAN_PORT=18081

# TUN mode is enabled by docker-compose.tun.yml / docker-compose.sidecar.yml.
LEMONVPN_TUN=0
LEMONVPN_TUN_STRICT=1
LEMONVPN_TUN_EXCLUDE_LAN=1

TZ=UTC
